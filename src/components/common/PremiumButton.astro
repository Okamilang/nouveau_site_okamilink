---
interface Props {
  text: string;
  href?: string;
  as?: 'a' | 'button';
  type?: 'submit' | 'button';
  arrow?: boolean;
  external?: boolean;
}

const { text, href, as: Component = href ? 'a' : 'button', type, arrow = true, external = false } = Astro.props;
---

<Component class="premium-button" href={href} type={Component === 'button' ? type : undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <span class="button-content">
    <span class="button-label">{text}</span>
    {arrow && (
      <span class="button-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </span>
    )}
  </span>
</Component>

<style>
  /* Bouton principal du site — même dessin que « Envoyer le message »
     et « Accéder au programme » : une pilule pleine, sans ambiguïté. */
  .premium-button {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--text-main);
    color: var(--bg-color);
    border: none;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--step-body);
    transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s ease;
  }

  .button-content {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0.9rem 0.85rem 1.5rem;
  }

  .button-arrow {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: color-mix(in oklch, var(--bg-color) 12%, transparent);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .premium-button:hover,
  .premium-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -14px color-mix(in oklch, var(--accent-purple) 60%, transparent);
  }

  .premium-button:hover .button-arrow,
  .premium-button:focus-visible .button-arrow { transform: translateX(3px); }

  /* Dans l'OS : version terminal */
  :global(html[data-experience="console"]) .premium-button {
    background: transparent;
    color: var(--cyber-cyan);
    border: 1px solid var(--cyber-cyan);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  :global(html[data-experience="console"]) .button-arrow { background: transparent; }
</style>
