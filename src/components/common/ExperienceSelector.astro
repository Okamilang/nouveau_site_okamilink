---
// ExperienceSelector.astro — premier écran : choix de l'interface
---

<div id="experience-selector" class="experience-overlay" aria-hidden="false">
  <div class="experience-grid-bg" aria-hidden="true"></div>
  <div class="experience-container">
    <div class="experience-header">
      <p class="selector-kicker reveal-text"><span>Okamilink · Système d'affichage</span></p>
      <h1 class="reveal-text"><span class="delay-1">Choisissez votre interface</span></h1>
      <p class="reveal-text"><span class="delay-2">Sélectionnez le mode d'affichage qui vous correspond. Vous pourrez changer à tout moment.</span></p>
    </div>

    <div class="cards-grid">
      <!-- Mode Vitrine -->
      <button class="experience-card vitrine-card" data-choice="vitrine" style="--i: 0">
        <span class="card-index">01</span>
        <div class="card-visual">
          <div class="glow-orb" style="width: 220px; height: 220px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 55%, transparent) 0%, transparent 70%);"></div>
          <div class="glow-orb" style="width: 160px; height: 160px; right: -10%; top: -20%; background: radial-gradient(circle, color-mix(in oklch, var(--accent-pink) 50%, transparent) 0%, transparent 70%); animation-delay: -4s;"></div>
          <span class="visual-word">Aa</span>
        </div>
        <div class="card-content">
          <h2>Mode Vitrine</h2>
          <p>L'expérience élégante par défaut. Interface épurée, animations fluides et design premium.</p>
          <span class="btn-indicator">
            Sélectionner
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </span>
        </div>
      </button>

      <!-- Mode Console -->
      <button class="experience-card console-card" data-choice="console" style="--i: 1">
        <span class="card-index console-index">02</span>
        <div class="card-visual">
          <div class="neon-line"></div>
          <div class="terminal-mock">
            <span class="prompt">></span> initialize_experience<br/>
            <span class="prompt">></span> --mode=console<span class="cursor">_</span>
          </div>
        </div>
        <div class="card-content">
          <h2>MODE CONSOLE</h2>
          <p>L'expérience brute et interactive. Navigation par commandes, données sous-jacentes et esthétique cyber.</p>
          <span class="btn-indicator console-btn">[ EXECUTE ]</span>
        </div>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const selector = document.getElementById('experience-selector');
    if (!selector) return;

    const currentExperience = localStorage.getItem('okamilink_experience');
    if (currentExperience) {
      selector.style.display = 'none';
      selector.setAttribute('aria-hidden', 'true');
      return;
    }

    const buttons = selector.querySelectorAll('.experience-card');
    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const choice = (e.currentTarget as HTMLElement).dataset.choice;
        if (choice) {
          localStorage.setItem('okamilink_experience', choice);
          document.documentElement.setAttribute('data-experience', choice);

          selector.classList.add('fade-out');
          setTimeout(() => {
            selector.style.display = 'none';
            selector.setAttribute('aria-hidden', 'true');
          }, 600);
        }
      });
    });
  });
</script>

<style>
  .experience-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow-y: auto;
    transition: opacity 0.6s var(--ease-out-expo), visibility 0.6s;
  }

  .experience-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 96px 96px;
    mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 0%, transparent 100%);
    pointer-events: none;
  }

  .experience-overlay.fade-out {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .experience-container {
    position: relative;
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .experience-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .selector-kicker span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .experience-header h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.03em;
  }

  .experience-header h1 span {
    background: var(--holographic-gradient);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: slide-up-text 1s var(--ease-out-expo) forwards, holographic-shift 10s ease infinite;
  }

  .experience-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    font-weight: 300;
    max-width: 48ch;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cards-grid { grid-template-columns: 1fr 1fr; }
  }

  .experience-card {
    position: relative;
    background: color-mix(in oklch, var(--bg-surface) 70%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font-family: inherit;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s ease, border-color 0.4s ease;
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.4s + var(--i) * 0.12s);
  }

  .card-index {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--accent-pink);
  }

  .console-index { color: oklch(0.85 0.20 150); }

  .experience-card:hover, .experience-card:focus-visible {
    transform: translateY(-8px);
    outline: none;
  }

  .vitrine-card:hover {
    box-shadow: 0 25px 50px -20px color-mix(in oklch, var(--accent-purple) 35%, transparent);
    border-color: color-mix(in oklch, var(--accent-purple) 50%, transparent);
  }

  .console-card {
    background: oklch(0.12 0.03 260 / 0.85);
  }

  .console-card:hover {
    box-shadow: 0 25px 50px -20px color-mix(in oklch, oklch(0.85 0.20 150) 30%, transparent);
    border-color: oklch(0.85 0.20 150);
  }

  .card-visual {
    height: 160px;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--bg-color) 60%, transparent);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
  }

  .visual-word {
    position: relative;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.5rem;
    letter-spacing: -0.04em;
    background: var(--holographic-gradient);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: holographic-shift 8s ease infinite;
  }

  .console-card .card-visual {
    background: oklch(0.1 0.02 260);
    border-color: color-mix(in oklch, oklch(0.85 0.20 150) 20%, transparent);
  }

  .neon-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: oklch(0.85 0.20 150);
    box-shadow: 0 0 10px oklch(0.85 0.20 150);
  }

  .terminal-mock {
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    color: oklch(0.65 0.18 250);
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 1rem;
    width: 100%;
  }

  .terminal-mock .prompt {
    color: oklch(0.85 0.20 150);
    margin-right: 0.5rem;
  }

  .terminal-mock .cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex-grow: 1;
  }

  .card-content h2 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .console-card .card-content h2 {
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    letter-spacing: 2px;
  }

  .card-content p {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.6;
    flex-grow: 1;
  }

  .btn-indicator {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-main);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.5rem;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .btn-indicator svg { transition: transform 0.4s var(--ease-out-expo); }

  .console-btn {
    border-radius: 4px;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    background: transparent;
    border: 1px solid oklch(0.85 0.20 150);
    color: oklch(0.85 0.20 150);
  }

  .vitrine-card:hover .btn-indicator {
    background: var(--text-main);
    color: var(--bg-color);
    border-color: var(--text-main);
  }

  .vitrine-card:hover .btn-indicator svg { transform: translateX(3px); }

  .console-card:hover .console-btn {
    background: color-mix(in oklch, oklch(0.85 0.20 150) 15%, transparent);
  }
</style>
