---
// Composant Navbar
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="brand" transition:name="brand-logo">
      <img src="/logo.png" alt="Okamilink Développement Web" class="brand-logo" width="180" />
    </a>
    
    <nav class="nav-links">
      <a href="/realisations" class="nav-link">Réalisations</a>
      <a href="/programmes" class="nav-link">Programmes</a>
      <a href="/contact" class="nav-link contact-link">Initialiser le contact</a>
      <button id="mode-toggle-btn" class="nav-link mode-toggle-btn" title="Accéder au système" aria-label="Toggle Mode">
        <span class="mode-icon vitrine-icon matrix-glitch" data-text="[SYS.OS]">[SYS.OS]</span>
        <span class="mode-icon console-icon">&lt; VITRINE</span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Script gérant la bascule de mode
  document.addEventListener('astro:page-load', () => {

    // Bascule de Mode
    const modeToggleBtn = document.getElementById('mode-toggle-btn');
    if (modeToggleBtn) {
      modeToggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-experience');
        const next = current === 'console' ? 'vitrine' : 'console';
        document.documentElement.setAttribute('data-experience', next);
        localStorage.setItem('okamilink_experience', next);
      });
    }
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: color-mix(in oklch, var(--bg-surface) 60%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid color-mix(in oklch, var(--text-main) 5%, transparent);
    transition: background 0.3s ease, padding 0.3s ease;
  }

  .nav-container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand-logo {
    height: auto;
    max-height: 60px;
    object-fit: contain;
    filter: drop-shadow(0 0 12px color-mix(in oklch, var(--accent-purple) 30%, transparent));
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .brand:hover .brand-logo {
    filter: drop-shadow(0 0 20px var(--accent-purple));
    transform: scale(1.02);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-main);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--holographic-gradient);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link {
    color: var(--text-main);
    padding: 0.5rem 1.25rem;
    border: 1px solid color-mix(in oklch, var(--text-main) 20%, transparent);
    border-radius: 999px;
  }
  
  .contact-link::after {
    display: none;
  }

  .contact-link:hover {
    background: color-mix(in oklch, var(--text-main) 10%, transparent);
  }


  .mode-toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  
  .mode-toggle-btn:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .mode-toggle-btn::after {
    display: none;
  }

  .vitrine-icon, .console-icon {
    display: none;
  }

  :global(html:not([data-experience="console"])) .vitrine-icon {
    display: inline-block;
  }

  :global(html[data-experience="console"]) .console-icon {
    display: inline-block;
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 1px;
    text-shadow: 0 0 10px color-mix(in oklch, var(--accent-purple) 50%, transparent);
  }

  /* Effet Matrix Glitch */
  .matrix-glitch {
    font-family: 'Courier New', Courier, monospace;
    font-weight: 900;
    font-size: 1rem;
    color: #0f0;
    text-shadow: 0 0 8px rgba(0, 255, 0, 0.6);
    letter-spacing: 2px;
    position: relative;
    display: inline-block;
  }
  
  .matrix-glitch::before, .matrix-glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    opacity: 0.8;
  }
  
  .matrix-glitch::before {
    left: 2px;
    text-shadow: -2px 0 rgba(0, 255, 0, 0.8);
    animation: glitch-anim-1 2s infinite linear alternate-reverse;
  }
  
  .matrix-glitch::after {
    left: -2px;
    text-shadow: 2px 0 rgba(0, 150, 0, 0.8);
    animation: glitch-anim-2 3s infinite linear alternate-reverse;
  }
  
  @keyframes glitch-anim-1 {
    0% { clip-path: inset(20% 0 80% 0); }
    20% { clip-path: inset(60% 0 10% 0); }
    40% { clip-path: inset(40% 0 50% 0); }
    60% { clip-path: inset(80% 0 5% 0); }
    80% { clip-path: inset(10% 0 70% 0); }
    100% { clip-path: inset(30% 0 40% 0); }
  }

  @keyframes glitch-anim-2 {
    0% { clip-path: inset(10% 0 60% 0); }
    20% { clip-path: inset(30% 0 20% 0); }
    40% { clip-path: inset(70% 0 10% 0); }
    60% { clip-path: inset(20% 0 50% 0); }
    80% { clip-path: inset(50% 0 30% 0); }
    100% { clip-path: inset(5% 0 80% 0); }
  }
</style>
