---
// ContactTerminal.astro
---

<div class="contact-terminal only-console">
  <div class="terminal-header">
    <span class="dot red"></span>
    <span class="dot yellow"></span>
    <span class="dot green"></span>
    <span class="title">~/contact/sendMessage.sh</span>
    <span class="header-right">bash · 80×24</span>
  </div>
  <form id="console-contact-form" class="terminal-body">
    <p class="term-comment"># Remplissez les arguments puis exécutez la fonction.</p>

    <div class="cmd-line">
      <span class="prompt">$</span>
      <span class="cmd-function">sendMessage</span><span class="syntax">(</span>
    </div>

    <div class="cmd-args">
      <div class="cmd-arg">
        <label for="term-type" class="arg-key">type:</label>
        <select id="term-type" class="term-input string-val" required>
          <option value="" disabled selected>"Sélectionnez..."</option>
          <option value="Entreprise">"Entreprise"</option>
          <option value="Particulier">"Particulier"</option>
          <option value="Auto-entrepreneur">"Auto-entrepreneur"</option>
          <option value="Association">"Association"</option>
          <option value="Autre">"Autre"</option>
        </select>
        <span class="syntax">,</span>
      </div>

      <div class="cmd-arg">
        <label for="term-name" class="arg-key">name:</label>
        <input type="text" id="term-name" class="term-input string-val" placeholder='"Entrez votre nom"' required autocomplete="name" />
        <span class="syntax">,</span>
      </div>

      <div class="cmd-arg">
        <label for="term-phone" class="arg-key">phone:</label>
        <input type="tel" id="term-phone" class="term-input string-val" placeholder='"Optionnel"' autocomplete="tel" />
        <span class="syntax">,</span>
      </div>

      <div class="cmd-arg">
        <label for="term-email" class="arg-key">email:</label>
        <input type="email" id="term-email" class="term-input string-val" placeholder='"votre@email.com"' required autocomplete="email" />
        <span class="syntax">,</span>
      </div>

      <div class="cmd-arg">
        <label for="term-message" class="arg-key">payload:</label>
        <textarea id="term-message" class="term-input string-val" placeholder='"Votre message détaillé ici..."' rows="4" required></textarea>
      </div>
    </div>

    <div class="cmd-line cmd-end">
      <span class="prompt">$</span>
      <span class="syntax">)</span>
      <button type="submit" class="term-submit">[ EXECUTE ]</button>
      <span class="term-cursor" aria-hidden="true">_</span>
    </div>
  </form>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('console-contact-form') as HTMLFormElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const typeInput = document.getElementById('term-type') as HTMLSelectElement;
        const nameInput = document.getElementById('term-name') as HTMLInputElement;
        const phoneInput = document.getElementById('term-phone') as HTMLInputElement;
        const emailInput = document.getElementById('term-email') as HTMLInputElement;
        const messageInput = document.getElementById('term-message') as HTMLTextAreaElement;

        const data = {
          type: typeInput.value,
          name: nameInput.value,
          phone: phoneInput.value,
          email: emailInput.value,
          message: messageInput.value,
          source: 'os'
        };

        if ((window as any).pushToast) {
          (window as any).pushToast('[SYS]: Transmission sequence initiated...', 'ok');
        }

        try {
          const response = await fetch('/sendmail.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (response.ok) {
            form.reset();
            if ((window as any).pushToast) {
              (window as any).pushToast('[SYS]: Message delivered successfully.', 'ok');
            }
          } else {
            if ((window as any).pushToast) {
              (window as any).pushToast(`[ERR]: ${result.message || 'Delivery failed.'}`, 'error');
            }
          }
        } catch (error) {
          if ((window as any).pushToast) {
            (window as any).pushToast('[ERR]: Network error. Cannot reach mail server.', 'error');
          }
        }
      });
    }
  });
</script>

<style>
  .contact-terminal {
    flex-direction: column; /* .only-console force display:flex */
    background: rgba(2, 4, 6, 0.9);
    border: 1px solid rgba(0, 255, 102, 0.3);
    overflow: hidden;
    font-family: var(--font-mono);
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 0 30px rgba(0, 255, 102, 0.03);
  }

  .terminal-header {
    background: rgba(0, 0, 0, 0.6);
    padding: 0.55rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(0, 255, 102, 0.2);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.85;
  }

  .dot.red { background: oklch(0.6 0.2 20); }
  .dot.yellow { background: oklch(0.8 0.2 80); }
  .dot.green { background: oklch(0.7 0.2 150); }

  .title {
    margin-left: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .header-right {
    margin-left: auto;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: rgba(0, 255, 102, 0.5);
    text-transform: uppercase;
  }

  .terminal-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .term-comment {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .cmd-line {
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .prompt {
    color: var(--data-action);
    font-weight: 700;
    text-shadow: 0 0 6px rgba(0, 255, 102, 0.5);
  }

  .cmd-function {
    color: var(--cyber-magenta);
    text-shadow: 0 0 8px rgba(255, 0, 234, 0.35);
  }

  .syntax {
    color: rgba(255, 255, 255, 0.5);
  }

  .cmd-args {
    display: flex;
    flex-direction: column;
    padding-left: 1.5rem;
    margin: 0.25rem 0 0.25rem 0.65rem;
    gap: 0.55rem;
    border-left: 1px dashed rgba(0, 243, 255, 0.25);
  }

  .cmd-arg {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .arg-key {
    color: var(--cyber-cyan);
    min-width: 80px;
    font-size: 0.95rem;
    padding-top: 0.15rem;
  }

  .term-input {
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    flex-grow: 1;
    resize: none;
    padding: 0.15rem 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  select.term-input {
    appearance: none;
    cursor: pointer;
  }

  select.term-input option {
    background: #05080c;
    color: var(--cyber-cyan);
    font-family: var(--font-mono);
  }

  .string-val {
    color: oklch(0.85 0.16 80);
  }

  .term-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .term-input:focus {
    background: rgba(0, 243, 255, 0.04);
    border-bottom-color: var(--cyber-cyan);
    box-shadow: 0 1px 0 var(--cyber-cyan), 0 6px 14px -8px rgba(0, 243, 255, 0.5);
  }

  .cmd-end { margin-top: 0.4rem; }

  .term-submit {
    background: transparent;
    border: 1px solid rgba(0, 255, 102, 0.5);
    color: var(--data-action);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    font-weight: 700;
    margin-left: 0.5rem;
    transition: all 0.2s;
  }

  .term-submit:hover {
    background: rgba(0, 255, 102, 0.12);
    border-color: var(--data-action);
    text-shadow: 0 0 8px var(--data-action);
    box-shadow: 0 0 14px rgba(0, 255, 102, 0.35);
  }

  .term-cursor {
    color: var(--data-action);
    animation: term-blink 1s step-end infinite;
  }

  @keyframes term-blink { 50% { opacity: 0; } }
</style>
