---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a href="/" class="brand-link">
        <img src="/logo.png" alt="Okamilink" class="footer-logo" width="60" height="60" />
        <span class="brand-text">Okamilink</span>
      </a>
      <p class="brand-desc">Agence de développement web premium. Création d'expériences digitales immersives et performantes.</p>
    </div>
    
    <div class="footer-links">
      <div class="link-group">
        <h3>Agence</h3>
        <a href="/realisations">Réalisations</a>
        <a href="/expertise">Expertise</a>
        <a href="/agence">L'Agence</a>
      </div>
      <div class="link-group">
        <h3>Légal</h3>
        <a href="/mentions-legales">Mentions Légales</a>
        <a href="/confidentialite">Politique de confidentialité</a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>&copy; {year} Okamilink. Tous droits réservés.</p>
    <button id="footer-shell-btn" class="shell-btn only-console" onclick="document.documentElement.classList.add('shell-mode-active'); window.pushToast && window.pushToast('[SYS]: Entering full shell mode...', 'ok');">[ SWITCH_TO_SHELL_MODE ]</button>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-surface);
    border-top: 1px solid color-mix(in oklch, var(--text-main) 5%, transparent);
    padding-top: 4rem;
    margin-top: 6rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  
  .footer-logo {
    object-fit: contain;
    filter: drop-shadow(0 0 5px color-mix(in oklch, var(--accent-purple) 30%, transparent));
  }

  .brand-text {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .brand-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 300px;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
    justify-content: flex-end;
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .link-group h3 {
    font-size: 1.1rem;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .link-group a {
    color: var(--text-muted);
    transition: color 0.2s ease;
    font-size: 0.95rem;
  }

  .link-group a:hover {
    color: var(--accent-blue);
  }

  .footer-bottom {
    border-top: 1px solid color-mix(in oklch, var(--text-main) 5%, transparent);
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* Responsive simple via container queries si c'était dans un conteneur ou media query par défaut */
  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-links {
      justify-content: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
    }
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .shell-btn {
    background: transparent;
    border: 1px solid var(--data-action);
    color: var(--data-action);
    font-family: var(--font-mono);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.3s;
  }

  .shell-btn:hover {
    background: color-mix(in oklch, var(--data-action) 15%, transparent);
    box-shadow: 0 0 10px color-mix(in oklch, var(--data-action) 50%, transparent);
  }
</style>
