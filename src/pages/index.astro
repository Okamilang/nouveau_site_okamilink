---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ExpertiseGrid from '../components/sections/ExpertiseGrid.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import PremiumButton from '../components/common/PremiumButton.astro';
---

<BaseLayout
  title="Création de site web sur-mesure & développeur freelance (95) | Okamilink"
  description="Développeur web freelance en Val-d'Oise, je conçois des sites internet et applications sur-mesure : performance, design premium et code propre. Discutons de votre projet."
>
  <Hero />
  <ExpertiseGrid />
  <Philosophy />

  <section class="cta-section scroll-reveal">
    <div class="cta-content">
      <div class="cta-orb" aria-hidden="true"></div>
      <p class="section-label"><em>004</em> Contact</p>
      <h2>Concrétisons votre <span class="text-gradient">vision</span> technologique.</h2>
      <p class="cta-text">Que vous ayez un cahier des charges précis ou une idée à défricher, construisons ensemble la solution web qui vous démarquera.</p>
      <div class="cta-actions">
        <PremiumButton text="Initialiser le contact" href="/contact" />
        <a href="mailto:contact@okamilink.com" class="cta-mail">contact@okamilink.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-section {
    padding: 2rem 2rem 6rem;
    display: flex;
    justify-content: center;
  }

  .cta-content {
    position: relative;
    width: 100%;
    max-width: 1000px;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    background: color-mix(in oklch, var(--bg-surface) 55%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  /* Ligne iridescente supérieure */
  .cta-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: var(--holographic-gradient);
    background-size: 300% auto;
    animation: holographic-shift 8s linear infinite;
  }

  .cta-orb {
    position: absolute;
    width: 700px;
    height: 700px;
    top: -60%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 26%, transparent) 0%, transparent 65%);
    z-index: -1;
    pointer-events: none;
  }

  .cta-content .section-label::before { display: none; }

  .cta-content h2 {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    max-width: 18ch;
    color: var(--text-main);
  }

  .cta-text {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 300;
    max-width: 56ch;
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2.5rem;
    margin-top: 0.75rem;
    padding: 20px;
    margin-left: -20px;
    margin-right: -20px;
  }

  .cta-mail {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .cta-mail:hover {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
  }
</style>
