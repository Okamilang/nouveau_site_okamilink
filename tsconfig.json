{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "astro",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
