---
const philosophyPoints = [
  {
    index: '01',
    title: "L'Artisanat du Code",
    description: "Fini les thèmes préfabriqués. Chaque projet est codé sur-mesure, de A à Z, avec une précision chirurgicale pour garantir unicité et pérennité."
  },
  {
    index: '02',
    title: "Performance Native",
    description: "Pas de bibliothèques superflues. Une utilisation experte des technologies web natives pour des temps de réponse instantanés."
  },
  {
    index: '03',
    title: "Approche \"Direct-to-Dev\"",
    description: "Vous échangez directement avec l'architecte de votre projet. Pas d'intermédiaires, une communication fluide et des itérations rapides."
  },
  {
    index: '04',
    title: "Scalabilité Assurée",
    description: "Une base de code propre, documentée et structurée pour évoluer facilement avec la croissance de vos ambitions numériques."
  }
];
---

<section class="philosophy-container scroll-reveal" id="philosophie">
  <div class="section-visual" aria-hidden="true">
    <div class="glow-orb" style="width: 600px; height: 600px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-blue) 45%, transparent) 0%, transparent 70%); top: 10%; left: -20%;"></div>
    <div class="glow-orb" style="width: 400px; height: 400px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 45%, transparent) 0%, transparent 70%); bottom: 10%; right: -10%; animation-delay: -6s;"></div>
  </div>

  <header class="philosophy-header">
    <p class="section-label"><em>003</em> Philosophie</p>
    <h2>Ma <span class="text-gradient">Philosophie</span></h2>
    <p class="lede">Une approche hybride alliant la proximité d'un artisan à l'exigence d'une agence de luxe.</p>
  </header>

  <div class="philosophy-grid">
    {philosophyPoints.map((point) => (
      <article class="philosophy-card">
        <span class="ghost-number" aria-hidden="true">{point.index}</span>
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-head">
          <span class="card-index">{point.index}</span>
          <span class="card-rule"></span>
        </div>
        <h3>{point.title}</h3>
        <p>{point.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .philosophy-container {
    position: relative;
    max-width: var(--container-width);
    margin: 4rem auto 6rem;
    padding: 0 2rem;
  }

  .section-visual {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    z-index: 0;
  }

  .philosophy-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .philosophy-header .section-label::before { display: none; }

  .philosophy-header h2 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 300;
    max-width: 52ch;
    line-height: 1.7;
  }

  /* Bento asymétrique (inverse de la section Expertise) */
  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .philosophy-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .philosophy-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(230px, auto);
    }
    .philosophy-card:nth-child(2) { grid-column: span 2; }
    .philosophy-card:nth-child(3) { grid-column: span 2; }
  }

  .philosophy-card {
    background: color-mix(in oklch, var(--bg-surface) 45%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.75rem 2rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: transform 0.5s var(--ease-out-expo), border-color 0.4s ease, background 0.4s ease;
  }

  .philosophy-card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    background: color-mix(in oklch, var(--bg-surface) 70%, transparent);
  }

  /* Numéro fantôme, géant, en bas à droite */
  .ghost-number {
    position: absolute;
    right: -0.1em;
    bottom: -0.25em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 7.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklch, var(--text-main) 8%, transparent);
    pointer-events: none;
    user-select: none;
    transition: -webkit-text-stroke-color 0.5s ease, transform 0.6s var(--ease-out-expo);
  }

  .philosophy-card:hover .ghost-number {
    -webkit-text-stroke-color: color-mix(in oklch, var(--accent-purple) 35%, transparent);
    transform: translate(-6px, -6px);
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, color-mix(in oklch, var(--accent-purple) 14%, transparent) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .philosophy-card:hover .card-glow { opacity: 1; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    position: relative;
    z-index: 1;
  }

  .card-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--accent-pink);
  }

  .card-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), transparent);
    max-width: 120px;
  }

  .philosophy-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-main);
    position: relative;
    z-index: 1;
  }

  .philosophy-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
    position: relative;
    z-index: 1;
    max-width: 50ch;
  }
</style>

<!-- Surcharges pour l'affichage dans une fenêtre du mode console -->
<style>
  :global(html[data-experience="console"]) .philosophy-container { margin: 0.5rem auto 1.5rem; padding: 0 0.5rem; }
  :global(html[data-experience="console"]) .philosophy-header { margin-bottom: 2rem; }
  :global(html[data-experience="console"]) .section-label { color: var(--cyber-cyan); }
  :global(html[data-experience="console"]) .section-label em { color: var(--cyber-magenta); }
  :global(html[data-experience="console"]) .philosophy-card {
    background: rgba(0, 0, 0, 0.45);
    border-color: rgba(0, 243, 255, 0.2);
    border-radius: 4px;
  }
  :global(html[data-experience="console"]) .ghost-number { -webkit-text-stroke-color: rgba(0, 243, 255, 0.12); }
  :global(html[data-experience="console"]) .card-index { color: var(--cyber-magenta); }
  :global(html[data-experience="console"]) .card-rule { background: linear-gradient(90deg, rgba(0, 243, 255, 0.4), transparent); }
  :global(html[data-experience="console"]) .philosophy-card h3 { font-family: var(--font-mono); letter-spacing: 0.02em; }
  :global(html[data-experience="console"]) .section-visual { display: none; }
</style>
