---
import GlowingLogo from './GlowingLogo.astro';
import PremiumButton from './PremiumButton.astro';
---

<!-- Blocking script to hide website elements before rendering to avoid FOUC -->
<script is:inline>
  if (localStorage.getItem('okamilink_auth') !== 'granted') {
    document.documentElement.classList.add('site-locked');
  }
</script>

<div id="gatekeeper-overlay" class="gatekeeper-overlay">
  <!-- Glowing background orbs -->
  <div class="glow-orb" style="background: radial-gradient(circle, var(--accent-purple) 0%, transparent 70%); width: 450px; height: 450px; top: 10%; left: 5%; filter: blur(30px);"></div>
  <div class="glow-orb" style="background: radial-gradient(circle, var(--accent-blue) 0%, transparent 70%); width: 550px; height: 550px; bottom: 5%; right: 5%; filter: blur(40px);"></div>

  <div class="login-card" id="login-card">
    <div class="card-header">
      <GlowingLogo width="80" height="80" />
      <h1 class="logo-text text-gradient">OKAMILINK</h1>
      <div class="status-pill">
        <span class="pulse-dot"></span>
        ESPACE DE PRÉ-PRODUCTION
      </div>
      <p class="card-description">
        Le nouveau site d'Okamilink est en cours de finalisation. Veuillez vous connecter pour accéder à l'aperçu en direct.
      </p>
    </div>

    <form class="login-form" id="login-form">
      <div class="input-group">
        <label for="username">Nom d'utilisateur</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="admin" 
          required 
          autocomplete="username"
          class="input-field"
        />
      </div>

      <div class="input-group">
        <label for="password">Mot de passe</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="••••••••••••" 
          required 
          autocomplete="current-password"
          class="input-field"
        />
      </div>

      <div class="error-message" id="error-message">
        Identifiants invalides.
      </div>

      <PremiumButton text="Déverrouiller l'accès" type="submit" as="button" />
    </form>
  </div>
</div>

<script>
  // Run on client side
  const initGatekeeper = () => {
    const overlay = document.getElementById('gatekeeper-overlay');
    const card = document.getElementById('login-card');
    const form = document.getElementById('login-form');
    const usernameInput = document.getElementById('username') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const errorMessage = document.getElementById('error-message');

    // If already authorized, remove overlay completely from DOM
    if (localStorage.getItem('okamilink_auth') === 'granted') {
      if (overlay) overlay.remove();
      document.documentElement.classList.remove('site-locked');
      return;
    }

    // Keep it visible if not authorized
    if (overlay) {
      overlay.classList.add('visible');
    }

    if (form) {
      // Use onsubmit to avoid attaching multiple event listeners on page transition swaps
      form.onsubmit = (e) => {
        e.preventDefault();
        
        const username = usernameInput.value.trim();
        const password = passwordInput.value;

        // Base64 check to avoid plain-text in source:
        // "admin" -> "YWRtaW4="
        // "jeremylejuif" -> "amVyZW15bGVqdWlm"
        const isUserValid = btoa(username) === 'YWRtaW4=';
        const isPasswordValid = btoa(password) === 'amVyZW15bGVqdWlm';

        if (isUserValid && isPasswordValid) {
          // Success
          localStorage.setItem('okamilink_auth', 'granted');
          
          if (errorMessage) errorMessage.classList.remove('visible');
          
          // Animate transition out
          if (card) card.classList.add('authorized-anim');
          if (overlay) overlay.classList.add('fade-out-anim');
          
          setTimeout(() => {
            document.documentElement.classList.remove('site-locked');
            if (overlay) overlay.remove();
          }, 600);
        } else {
          // Failure - Shake animation
          if (card) {
            card.classList.remove('shake-anim');
            // Trigger reflow to restart animation
            void card.offsetWidth;
            card.classList.add('shake-anim');
          }

          if (errorMessage) {
            errorMessage.textContent = "Nom d'utilisateur ou mot de passe incorrect.";
            errorMessage.classList.add('visible');
          }

          // Clear password field and refocus
          passwordInput.value = '';
          passwordInput.focus();
        }
      };
    }
  };

  // Run immediately and listen to view transition page loads
  initGatekeeper();
  document.addEventListener('astro:page-load', initGatekeeper);
</script>

<style>
  /* Lock body scrolling and hide normal contents via class added to <html> */
  :global(html.site-locked body) {
    overflow: hidden !important;
    height: 100vh !important;
  }

  :global(html.site-locked main),
  :global(html.site-locked nav),
  :global(html.site-locked footer),
  :global(html.site-locked #custom-cursor) {
    display: none !important;
  }

  .gatekeeper-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg-color);
    overflow: hidden;
    padding: 1.5rem;
  }

  .gatekeeper-overlay.visible {
    display: flex;
  }

  .login-card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 3rem 2.5rem;
    width: 100%;
    max-width: 460px;
    box-shadow: 
      0 30px 70px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 0 40px color-mix(in oklch, var(--accent-purple) 5%, transparent);
    text-align: center;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    transform: scale(1);
    opacity: 1;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .logo-text {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    margin-top: 0.5rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in oklch, var(--accent-purple) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent-purple) 20%, transparent);
    color: var(--accent-purple);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent-pink);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-pink);
    animation: pill-pulse 1.5s infinite alternate;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
  }

  .input-group label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .input-group:focus-within label {
    color: var(--accent-purple);
  }

  .input-field {
    width: 100%;
    padding: 0.9rem 1.25rem;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .input-field:focus {
    border-color: var(--accent-purple);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 
      0 0 20px color-mix(in oklch, var(--accent-purple) 15%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .error-message {
    color: oklch(0.65 0.2 15);
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    background: oklch(0.65 0.2 15 / 0.1);
    border: 1px solid oklch(0.65 0.2 15 / 0.2);
    padding: 0.6rem;
    border-radius: 10px;
    min-height: 1.5rem;
    display: none;
  }

  .error-message.visible {
    display: block;
    animation: fade-in 0.3s ease-out;
  }

  /* Animations */
  @keyframes pill-pulse {
    from { transform: scale(0.9); opacity: 0.7; }
    to { transform: scale(1.15); opacity: 1; }
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Shake animation on invalid login */
  .shake-anim {
    animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
  }

  @keyframes shake {
    10%, 90% { transform: translate3d(-2px, 0, 0); }
    20%, 80% { transform: translate3d(4px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-6px, 0, 0); border-color: oklch(0.65 0.2 15 / 0.4); }
    40%, 60% { transform: translate3d(6px, 0, 0); }
  }

  /* Transition out animations on success */
  .authorized-anim {
    animation: card-auth-out 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .fade-out-anim {
    animation: overlay-fade-out 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes card-auth-out {
    0% { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
    100% { transform: scale(0.92) translateY(-20px); opacity: 0; filter: blur(10px); }
  }

  @keyframes overlay-fade-out {
    0% { opacity: 1; }
    100% { opacity: 0; pointer-events: none; }
  }
</style>
