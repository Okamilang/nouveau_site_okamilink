---
interface Props {
  id: string;
  title: string;
  icon?: string;
  width?: string;
  height?: string;
  x?: string;
  y?: string;
  isOpen?: boolean;
}

const {
  id,
  title,
  icon = "📄",
  width = "600px",
  height = "400px",
  x = "10%",
  y = "10%",
  isOpen = false
} = Astro.props;
---

<div
  id={id}
  class={`os-window ${isOpen ? 'open' : ''}`}
  style={`width: ${width}; height: ${height}; top: ${y}; left: ${x};`}
  data-window-id={id}
>
  <span class="win-corner tl" aria-hidden="true"></span>
  <span class="win-corner br" aria-hidden="true"></span>

  <div class="window-header">
    <div class="window-title">
      <span class="window-icon" set:html={icon}></span>
      {title}
    </div>
    <div class="window-controls">
      <button class="win-btn minimize" aria-label="Réduire" data-action="minimize" title="Réduire">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2 9h8"/></svg>
      </button>
      <button class="win-btn maximize" aria-label="Agrandir" data-action="maximize" title="Agrandir">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="8" height="8"/></svg>
      </button>
      <button class="win-btn close" aria-label="Fermer" data-action="close" title="Fermer">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7"/></svg>
      </button>
    </div>
  </div>
  <div class="window-content">
    <slot />
  </div>
  <div class="window-statusline" aria-hidden="true">
    <span class="status-id">{id}</span>
    <span class="status-right">RW · UTF-8 · <span class="status-blink">■</span></span>
  </div>
</div>

<style>
  .os-window {
    position: absolute;
    background: rgba(4, 7, 11, 0.94);
    border: 1px solid rgba(0, 243, 255, 0.7);
    display: none;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 30px 60px -20px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(0, 243, 255, 0.12),
      inset 0 0 40px rgba(0, 243, 255, 0.04);
    resize: both;
    min-width: 300px;
    min-height: 200px;
    will-change: transform, top, left;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .os-window.open {
    display: flex;
    animation: win-open 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes win-open {
    0% { opacity: 0; transform: translateZ(0) scale(0.97) translateY(10px); clip-path: inset(0 0 100% 0); }
    40% { opacity: 1; clip-path: inset(0 0 0 0); }
    100% { opacity: 1; transform: translateZ(0) scale(1) translateY(0); clip-path: inset(0 0 0 0); }
  }

  .os-window.maximized {
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Coins en équerre magenta */
  .win-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--cyber-magenta);
    border-style: solid;
    pointer-events: none;
    z-index: 5;
    filter: drop-shadow(0 0 3px rgba(255, 0, 234, 0.7));
  }

  .win-corner.tl { top: -1px; left: -1px; border-width: 1px 0 0 1px; }
  .win-corner.br { bottom: -1px; right: -1px; border-width: 0 1px 1px 0; }

  .window-header {
    height: 34px;
    flex-shrink: 0;
    background:
      repeating-linear-gradient(45deg, rgba(0,243,255,0.05) 0px, rgba(0,243,255,0.05) 2px, transparent 2px, transparent 6px),
      rgba(0, 0, 0, 0.85);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px 0 14px;
    border-bottom: 1px solid rgba(0, 243, 255, 0.6);
    user-select: none;
    cursor: grab;
    position: relative;
  }

  .window-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--cyber-cyan), transparent 60%);
    opacity: 0.8;
  }

  .window-header:active { cursor: grabbing; }

  .window-title {
    font-size: 0.74rem;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--cyber-cyan);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .window-title::before {
    content: '>_';
    color: var(--cyber-magenta);
    opacity: 0.9;
    letter-spacing: 0;
    font-weight: 500;
  }

  .window-icon {
    display: inline-flex;
    align-items: center;
    filter: drop-shadow(0 0 3px rgba(0, 243, 255, 0.6));
  }

  .window-controls {
    display: flex;
    gap: 4px;
  }

  .win-btn {
    background: transparent;
    border: 1px solid rgba(0, 243, 255, 0.18);
    color: rgba(0, 243, 255, 0.8);
    width: 24px;
    height: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .win-btn:hover {
    background: rgba(0, 243, 255, 0.15);
    border-color: var(--cyber-cyan);
    color: white;
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.4);
  }

  .win-btn.close:hover {
    background: rgba(255, 0, 234, 0.18);
    border-color: var(--cyber-magenta);
    box-shadow: 0 0 10px rgba(255, 0, 234, 0.45);
    color: white;
  }

  .window-content {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
    position: relative;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 243, 255, 0.4) transparent;
    background-image:
      linear-gradient(to right, rgba(0, 243, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 243, 255, 0.025) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .window-content::-webkit-scrollbar { width: 8px; }
  .window-content::-webkit-scrollbar-thumb {
    background: rgba(0, 243, 255, 0.35);
    border: 2px solid rgba(4, 7, 11, 1);
  }

  .window-statusline {
    flex-shrink: 0;
    height: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 243, 255, 0.45);
    border-top: 1px solid rgba(0, 243, 255, 0.18);
    background: rgba(0, 0, 0, 0.6);
    user-select: none;
  }

  .status-blink {
    color: var(--data-action);
    animation: status-blink 1s step-end infinite;
  }

  @keyframes status-blink { 50% { opacity: 0; } }
</style>
