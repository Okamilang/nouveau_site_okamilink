---

<div class="taskbar">
  <button id="start-button" class="start-button">
    <span class="start-icon">🐺</span>
    Start
  </button>
  
  <div class="taskbar-windows" id="taskbar-windows">
    <!-- Les fenêtres ouvertes apparaîtront ici -->
  </div>
  
  <div class="taskbar-system">
    <div id="os-clock" class="os-clock">00:00</div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const clock = document.getElementById('os-clock');
    if (!clock) return;

    const updateClock = () => {
      const now = new Date();
      clock.textContent = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    };

    updateClock();
    setInterval(updateClock, 1000);
  });
</script>

<style>
  .taskbar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 48px;
    background: rgba(10, 12, 16, 0.85);
    backdrop-filter: blur(15px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    padding: 0 10px;
    z-index: 9000;
    user-select: none;
  }

  .start-button {
    height: 36px;
    padding: 0 15px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: white;
    font-family: var(--font-sans);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .start-button:hover {
    background: rgba(255,255,255,0.2);
    box-shadow: 0 0 15px var(--data-action);
    border-color: var(--data-action);
  }

  .taskbar-windows {
    flex-grow: 1;
    display: flex;
    gap: 5px;
    margin-left: 15px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .taskbar-windows::-webkit-scrollbar {
    display: none;
  }

  /* Styles pour les items injectés en JS */
  :global(.taskbar-item) {
    height: 36px;
    padding: 0 15px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    color: white;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.taskbar-item:hover) {
    background: rgba(255,255,255,0.1);
  }

  :global(.taskbar-item.active) {
    background: rgba(255,255,255,0.15);
    border-bottom: 2px solid var(--data-action);
  }

  .taskbar-system {
    display: flex;
    align-items: center;
    padding-left: 15px;
    border-left: 1px solid rgba(255,255,255,0.1);
    height: 60%;
  }

  .os-clock {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-main);
  }
</style>
