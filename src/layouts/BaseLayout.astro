---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import ExperienceSelector from '../components/common/ExperienceSelector.astro';
import OSDesktop from '../components/os/OSDesktop.astro';
import TerminalToast from '../components/common/TerminalToast.astro';
import ConstructionGatekeeper from '../components/common/ConstructionGatekeeper.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Okamilink - Agence de développement web premium." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- View Transitions API support in Astro -->
    <ViewTransitions />

    <!-- Script Anti-FOUC pour le Dual-Mode -->
    <script is:inline>
      (function() {
        try {
          const experience = localStorage.getItem('okamilink_experience');
          if (experience === 'console') {
            document.documentElement.setAttribute('data-experience', 'console');
          } else {
            document.documentElement.setAttribute('data-experience', 'vitrine');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ConstructionGatekeeper />
    <ExperienceSelector />
    <NoiseOverlay />
    <div class="only-vitrine">
      <Navbar />
      <main style="padding-top: 100px;">
        <slot />
      </main>
      <Footer />
    </div>
    
    <TerminalToast />
    <OSDesktop />
    <CustomCursor />
  </body>
</html>

<style>
  main {
    padding-top: 80px; /* Compense la navbar fixe */
    min-height: calc(100vh - 80px);
  }
</style>
