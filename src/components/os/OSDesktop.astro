---
import BootSequence from './BootSequence.astro';
import Taskbar from './Taskbar.astro';
import WindowTemplate from './WindowTemplate.astro';
import Wallpaper from './Wallpaper.astro';
import { WALLPAPERS, DEFAULT_WALLPAPER } from './wallpapers';

import Hero from '../sections/Hero.astro';
import ExpertiseGrid from '../sections/ExpertiseGrid.astro';
import Philosophy from '../sections/Philosophy.astro';
import ContactTerminal from '../common/ContactTerminal.astro';

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const renderedProjects = await Promise.all(projects.map(async (p, i) => {
  const { Content } = await p.render();
  return { p, Content, i };
}));

const icons = {
  user: "<path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/>",
  chip: "<rect width='16' height='16' x='4' y='4' rx='2'/><rect width='6' height='6' x='9' y='9' rx='1'/><path d='M15 2v2'/><path d='M15 20v2'/><path d='M2 15h2'/><path d='M2 9h2'/><path d='M20 15h2'/><path d='M20 9h2'/><path d='M9 2v2'/><path d='M9 20v2'/>",
  brain: "<path d='M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z'/><path d='M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z'/>",
  folder: "<path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'/>",
  book: "<path d='M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z'/><path d='M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z'/>",
  file: "<path d='M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z'/><polyline points='14 2 14 8 20 8'/>",
  terminal: "<polyline points='4 17 10 11 4 5'/><line x1='12' x2='20' y1='19' y2='19'/>",
  display: "<rect width='20' height='14' x='2' y='3' rx='2'/><line x1='8' x2='16' y1='21' y2='21'/><line x1='12' x2='12' y1='17' y2='21'/>",
  mobile: "<rect width='14' height='20' x='5' y='2' rx='2' ry='2'/><path d='M12 18h.01'/>",
  power: "<path d='M12 2v10'/><path d='M18.4 6.6a9 9 0 1 1-12.77.04'/>",
};

const svg = (paths: string, size = 18) =>
  `<svg xmlns='http://www.w3.org/2000/svg' width='${size}' height='${size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'>${paths}</svg>`;

const dock = [
  { target: 'win-about', label: 'A_Propos', icon: icons.user },
  { target: 'win-skills', label: 'Competences', icon: icons.chip },
  { target: 'win-philo', label: 'Philosophie', icon: icons.brain },
  { target: 'win-projects', label: 'Projets', icon: icons.folder },
  { target: 'win-terminal', label: 'Terminal', icon: icons.terminal },
  { target: 'win-wallpaper', label: 'Affichage', icon: icons.display },
];

const wallpapers = WALLPAPERS;

const websites = projects.filter(p => p.data.category === 'website');
const programs = projects.filter(p => p.data.category === 'program');
---

<div id="os-environment" class="os-environment" aria-hidden="true">
  <!-- Fonds d'écran procéduraux (CSS/JS) : seule la couche active est affichée -->
  <div class="os-wallpapers" id="os-wallpapers">
    {wallpapers.map((wp) => (
      <div class="os-wallpaper-layer" data-wallpaper={wp.id} data-active={wp.id === DEFAULT_WALLPAPER ? "" : undefined}>
        <Wallpaper theme={wp.id} />
      </div>
    ))}
  </div>
  <BootSequence />

  <div class="desktop-area" id="desktop-area">
    <!-- HUD : équerres d'angle et lecture de coordonnées -->
    <div class="hud" aria-hidden="true">
      <span class="hud-corner tl"></span>
      <span class="hud-corner tr"></span>
      <span class="hud-corner bl"></span>
      <span class="hud-corner br"></span>
      <div class="hud-readout">
        <span>X <b id="hud-x">0000</b></span>
        <span>Y <b id="hud-y">0000</b></span>
        <span>WIN <b id="hud-win-count">00</b></span>
        <span class="hud-sig">OKAMI://DESKTOP</span>
      </div>
    </div>

    <!-- Dock (Bottom) -->
    <div class="os-dock">
      {dock.map((item) => (
        <div class="desktop-icon dock-item" data-target={item.target}>
          <span class="icon-hud" set:html={svg(item.icon, 24)} />
          <span class="icon-label">{item.label}</span>
          <span class="dock-indicator"></span>
        </div>
      ))}
      <span class="dock-sep"></span>
      <div class="desktop-icon dock-item dock-exit" id="btn-exit-os">
        <span class="icon-hud" set:html={svg(icons.power, 24)} />
        <span class="icon-label">Quitter</span>
      </div>
    </div>

    <!-- Windows Container -->
    <div id="windows-container">
      <WindowTemplate id="win-projects" title="Projets/" icon={svg(icons.folder)} x="10%" y="20%" width="600px" height="400px">
        <div class="folder-content">
          <div class="desktop-icon folder-icon" data-target="win-projects-websites" style="left: 20px; top: 20px;">
            <span class="icon-hud icon-lg" set:html={svg(icons.folder, 48)} />
            <span class="icon-label">Sites_Web/</span>
          </div>
          <div class="desktop-icon folder-icon" data-target="win-projects-programs" style="left: 160px; top: 20px;">
            <span class="icon-hud icon-lg" set:html={svg(icons.book, 48)} />
            <span class="icon-label">Programmes/</span>
          </div>
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-projects-websites" title="Sites_Web/" icon={svg(icons.folder)} x="15%" y="25%" width="600px" height="400px">
        <div class="folder-content">
          {websites.map((p, index) => {
            const col = index % 4;
            const row = Math.floor(index / 4);
            return (
              <div class="desktop-icon folder-icon" data-target={`win-proj-${p.slug}`} style={`left: ${20 + col * 140}px; top: ${20 + row * 120}px;`}>
                {p.data.osIcon ? (
                  <img src={p.data.osIcon} alt="" draggable="false" class="icon-img" />
                ) : (
                  <span class="icon-hud icon-lg" set:html={svg(icons.file, 48)} />
                )}
                <span class="icon-label">{p.data.title}.exe</span>
              </div>
            );
          })}
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-projects-programs" title="Programmes/" icon={svg(icons.book)} x="20%" y="30%" width="600px" height="400px">
        <div class="folder-content">
          {programs.length === 0 ? (
            <p class="folder-empty">> Aucun programme trouvé dans ce répertoire.</p>
          ) : (
            programs.map((p, index) => {
              const col = index % 4;
              const row = Math.floor(index / 4);
              return (
                <div class="desktop-icon folder-icon" data-target={`win-proj-${p.slug}`} style={`left: ${20 + col * 140}px; top: ${20 + row * 120}px;`}>
                  {p.data.osIcon ? (
                    <img src={p.data.osIcon} alt="" draggable="false" class="icon-img" />
                  ) : (
                    <span class="icon-hud icon-lg" set:html={svg(icons.file, 48)} />
                  )}
                  <span class="icon-label">{p.data.title}.exe</span>
                </div>
              );
            })
          )}
        </div>
      </WindowTemplate>

      {renderedProjects.map(({ p, Content, i }) => (
        <>
          <WindowTemplate
            id={`win-proj-${p.slug}`}
            title={`${p.data.title}.exe`}
            icon={p.data.osIcon ? `<img src="${p.data.osIcon}" style="width:1.2em; height:1.2em; vertical-align:middle; object-fit:contain;"/>` : svg(icons.file)}
            x={`${15 + i*5}%`} y={`${25 + i*5}%`} width="800px" height="600px"
          >
            <div class="os-content-wrapper project-window">
              <header class="project-head">
                <p class="project-kicker">
                  <span>{p.data.category === 'program' ? 'PROGRAMME' : 'ÉTUDE DE CAS'}</span>
                  <span class="kicker-sep">//</span>
                  <span>{p.data.client}</span>
                  <span class="kicker-sep">//</span>
                  <span>{p.data.date.getFullYear()}</span>
                </p>
                <h1 class="project-title">{p.data.title}</h1>
                <p class="project-desc">{p.data.description}</p>
                <div class="project-tags">
                  {p.data.tags.map(tag => <span class="project-tag">{tag}</span>)}
                </div>
              </header>
              <div class="project-markdown">
                <Content />
              </div>
            </div>
          </WindowTemplate>

          {p.data.url && p.data.category === 'website' && (
            <WindowTemplate
              id={`win-mobile-${p.slug}`}
              title={`Mobile - ${p.data.title}`}
              icon={svg(icons.mobile)}
              x={`${40 + i*5}%`} y={`${10 + i*5}%`} width="395px" height="800px"
            >
              <div class="mobile-frame">
                <div class="mobile-notch"></div>
                <iframe src={p.data.url} title={`Mobile ${p.data.title}`}></iframe>
              </div>
            </WindowTemplate>
          )}
        </>
      ))}

      <WindowTemplate id="win-about" title="A_Propos.exe" icon={svg(icons.user)} x="5%" y="5%" width="800px" height="500px">
        <div class="os-content-wrapper">
          <Hero />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-skills" title="Competences.exe" icon={svg(icons.chip)} x="15%" y="15%" width="900px" height="600px">
        <div class="os-content-wrapper">
          <ExpertiseGrid />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-philo" title="Philosophie.txt" icon={svg(icons.brain)} x="25%" y="10%" width="700px" height="600px">
        <div class="os-content-wrapper">
          <Philosophy />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-terminal" title="Contact.sh" icon={svg(icons.terminal)} x="30%" y="30%" width="680px" height="520px">
        <div class="terminal-content">
          <ContactTerminal />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-wallpaper" title="Affichage.exe" icon={svg(icons.display)} x="20%" y="20%" width="680px" height="460px">
        <div class="os-content-wrapper wallpaper-window">
          <h2 class="wallpaper-title"><span>$</span> ./Choisir_Fond_Ecran.sh</h2>
          <p class="wallpaper-hint"># Sélectionnez un fond. Le choix est mémorisé sur cet appareil.</p>
          <div class="wallpaper-grid">
            {wallpapers.map((wp, idx) => (
              <div class="wallpaper-btn" data-wallpaper={wp.id} role="button" tabindex="0" aria-label={wp.name}>
                <div class="wallpaper-thumb"><Wallpaper theme={wp.id} thumb /></div>
                <span class="wallpaper-name">{String(idx + 1).padStart(2, '0')} · {wp.name}</span>
                <span class="wallpaper-check" aria-hidden="true">ACTIF</span>
              </div>
            ))}
          </div>
        </div>
      </WindowTemplate>
    </div>
  </div>

  <Taskbar />

  <!-- Context Menu -->
  <div id="os-context-menu" class="context-menu" style="display: none;">
    <ul id="context-menu-list"></ul>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const desktopArea = document.getElementById('desktop-area');
    const taskbarWindows = document.getElementById('taskbar-windows');
    let highestZIndex = 100;

    // Window Management Logic
    const windows = document.querySelectorAll('.os-window') as NodeListOf<HTMLElement>;
    const icons = document.querySelectorAll('.desktop-icon') as NodeListOf<HTMLElement>;
    const taskbarItems = new Map<string, HTMLElement>();

    // Synchronise les indicateurs du dock et le compteur HUD
    const hudWinCount = document.getElementById('hud-win-count');
    const syncDock = () => {
      document.querySelectorAll('.dock-item[data-target]').forEach(item => {
        const id = item.getAttribute('data-target');
        const w = id ? document.getElementById(id) : null;
        const open = !!w && w.classList.contains('open');
        const visible = open && w!.style.display !== 'none';
        item.classList.toggle('is-open', open);
        item.classList.toggle('is-visible', visible);
      });
      if (hudWinCount) {
        const count = document.querySelectorAll('.os-window.open').length;
        hudWinCount.textContent = String(count).padStart(2, '0');
      }
    };

    const bringToFront = (win: HTMLElement) => {
      highestZIndex++;
      win.style.zIndex = highestZIndex.toString();

      document.querySelectorAll('.taskbar-item').forEach(item => item.classList.remove('active'));
      const tbItem = taskbarItems.get(win.id);
      if (tbItem) tbItem.classList.add('active');
    };

    const toggleWindow = (winId: string) => {
      const win = document.getElementById(winId);
      if (!win) return;

      if (!win.classList.contains('open')) {
        win.classList.add('open');
        win.style.display = 'flex';
        bringToFront(win);

        if (!taskbarItems.has(winId)) {
          const tbItem = document.createElement('div');
          tbItem.className = 'taskbar-item active';
          const title = win.querySelector('.window-title')?.textContent || 'Window';
          tbItem.textContent = title;
          tbItem.onclick = () => {
            if (win.style.display === 'none') {
              win.style.display = 'flex';
              bringToFront(win);
            } else if (win.style.zIndex === highestZIndex.toString()) {
              win.style.display = 'none';
              tbItem.classList.remove('active');
            } else {
              bringToFront(win);
            }
            syncDock();
          };
          taskbarWindows?.appendChild(tbItem);
          taskbarItems.set(winId, tbItem);
        }
      } else if (win.style.display === 'none') {
        win.style.display = 'flex';
        bringToFront(win);
      } else {
        bringToFront(win);
      }
      syncDock();
    };

    (window as any).openOSWindow = toggleWindow;

    // Desktop & Folder icons drag & double-click logic
    icons.forEach(icon => {
      let isDraggingIcon = false;
      let hasMoved = false;
      let startX = 0, startY = 0;
      let currentX = 0, currentY = 0;
      let initialX = 0, initialY = 0;

      if (window.getComputedStyle(icon).position === 'static') {
        icon.style.position = 'relative';
      }

      const onMouseMove = (e: MouseEvent) => {
        if (!isDraggingIcon) return;
        e.preventDefault();

        const dx = e.clientX - startX;
        const dy = e.clientY - startY;

        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
          hasMoved = true;
        }

        currentX = initialX + dx;
        currentY = initialY + dy;
        icon.style.transform = `translate(${currentX}px, ${currentY}px)`;
      };

      const onMouseUp = () => {
        if (isDraggingIcon) {
          isDraggingIcon = false;
          icon.style.zIndex = '';
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }
      };

      icon.addEventListener('mousedown', (e: MouseEvent) => {
        if (icon.classList.contains('dock-item')) return;

        isDraggingIcon = true;
        hasMoved = false;
        startX = e.clientX;
        startY = e.clientY;
        initialX = currentX;
        initialY = currentY;
        icon.style.zIndex = '50';

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });

      // Simple clic pour tout : dock, dossiers et programmes (un drag annule l'ouverture)
      icon.addEventListener('click', (e) => {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const target = icon.getAttribute('data-target');
        if (target) toggleWindow(target);
      });

    });

    // Exit OS Logic
    const exitBtn = document.getElementById('btn-exit-os');
    if (exitBtn) {
      const exitOS = (e: Event) => {
        e.preventDefault();
        document.documentElement.setAttribute('data-experience', 'vitrine');
        localStorage.setItem('okamilink_experience', 'vitrine');
      };

      exitBtn.addEventListener('click', exitOS);

      let lastTap = 0;
      exitBtn.addEventListener('touchstart', (e: TouchEvent) => {
        const currentTime = new Date().getTime();
        const tapLength = currentTime - lastTap;
        if (tapLength < 500 && tapLength > 0) {
          exitOS(e);
        }
        lastTap = currentTime;
      });
    }

    // Mobile launchers from within projects
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const launcher = target.closest('.os-mobile-launcher');
      if (launcher) {
        const winId = launcher.getAttribute('data-target');
        if (winId) toggleWindow(winId);
      }
    });

    // Wallpaper Logic — fonds procéduraux, identifiés par un id de thème
    const osEnv = document.getElementById('os-environment');
    const wallpaperLayers = document.querySelectorAll<HTMLElement>('.os-wallpaper-layer');
    const wallpaperBtns = document.querySelectorAll('.wallpaper-btn');
    const wallpaperIds = Array.from(wallpaperLayers, l => l.dataset.wallpaper || '');
    const DEFAULT_WP = wallpaperIds[0] || 'brass';

    const applyWallpaper = (id: string) => {
      if (!wallpaperIds.includes(id)) id = DEFAULT_WP;
      wallpaperLayers.forEach(l => l.toggleAttribute('data-active', l.dataset.wallpaper === id));
      wallpaperBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-wallpaper') === id));
      window.dispatchEvent(new CustomEvent('os:wallpaper', { detail: id }));
      return id;
    };

    if (osEnv) {
      // Migration : anciennes valeurs = URL d'image (/os-backgrounds/fondN.png|webp) → id de thème
      let saved = localStorage.getItem('os-wallpaper') || DEFAULT_WP;
      const legacy = saved.match(/fond(\d+)\.(png|webp)$/);
      if (legacy) saved = wallpaperIds[Number(legacy[1]) - 1] || DEFAULT_WP;
      localStorage.setItem('os-wallpaper', applyWallpaper(saved));
    }

    wallpaperBtns.forEach(btn => {
      const select = () => {
        const id = btn.getAttribute('data-wallpaper');
        if (id && osEnv) localStorage.setItem('os-wallpaper', applyWallpaper(id));
      };
      btn.addEventListener('click', select);
      btn.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); select(); }
      });
    });

    // HUD : coordonnées du pointeur
    const hudX = document.getElementById('hud-x');
    const hudY = document.getElementById('hud-y');
    if (desktopArea && hudX && hudY) {
      let pending = false;
      let px = 0, py = 0;
      desktopArea.addEventListener('mousemove', (e: MouseEvent) => {
        px = e.clientX; py = e.clientY;
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          hudX.textContent = String(px).padStart(4, '0');
          hudY.textContent = String(py).padStart(4, '0');
          pending = false;
        });
      }, { passive: true });
    }

    // Window Controls
    windows.forEach(win => {
      win.addEventListener('mousedown', () => bringToFront(win));

      const minimizeBtn = win.querySelector('.win-btn.minimize') as HTMLElement | null;
      const maximizeBtn = win.querySelector('.win-btn.maximize') as HTMLElement | null;
      const closeBtn = win.querySelector('.win-btn.close') as HTMLElement | null;

      minimizeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.style.display = 'none';
        const tbItem = taskbarItems.get(win.id);
        if (tbItem) tbItem.classList.remove('active');
        syncDock();
      });

      maximizeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.classList.toggle('maximized');
        bringToFront(win);
      });

      closeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.classList.remove('open');
        win.style.display = 'none';
        win.classList.remove('maximized');
        const tbItem = taskbarItems.get(win.id);
        if (tbItem) {
          tbItem.remove();
          taskbarItems.delete(win.id);
        }
        syncDock();
      });

      // Draggable logic
      const header = win.querySelector('.window-header') as HTMLElement | null;
      let isDragging = false;
      let startX = 0, startY = 0, initialX = 0, initialY = 0;

      const onWinMouseMove = (e: MouseEvent) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        win.style.left = `${initialX + dx}px`;
        win.style.top = `${initialY + dy}px`;
      };

      const onWinMouseUp = () => {
        if (isDragging) {
          isDragging = false;
          document.body.classList.remove('window-is-dragging');
          window.removeEventListener('mousemove', onWinMouseMove);
          window.removeEventListener('mouseup', onWinMouseUp);
        }
      };

      header?.addEventListener('mousedown', (e: MouseEvent) => {
        if (win.classList.contains('maximized')) return;
        if ((e.target as HTMLElement).closest('.win-btn')) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialX = win.offsetLeft;
        initialY = win.offsetTop;
        bringToFront(win);
        document.body.classList.add('window-is-dragging');

        window.addEventListener('mousemove', onWinMouseMove);
        window.addEventListener('mouseup', onWinMouseUp);
      });
    });

    // Context Menu Logic
    const contextMenu = document.getElementById('os-context-menu');
    const contextMenuList = document.getElementById('context-menu-list');

    const hideContextMenu = () => {
      if (contextMenu) contextMenu.style.display = 'none';
    };

    document.addEventListener('click', hideContextMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideContextMenu();
    });

    desktopArea?.addEventListener('contextmenu', (e: MouseEvent) => {
      e.preventDefault();
      if (!contextMenu || !contextMenuList) return;

      const target = e.target as HTMLElement;
      const icon = target.closest('.desktop-icon');
      const windowHeader = target.closest('.window-header');

      contextMenuList.innerHTML = '';

      if (icon) {
        const title = icon.querySelector('.icon-label')?.textContent || 'App';
        contextMenuList.innerHTML = `
          <li id="cm-open">Ouvrir</li>
          <div class="separator"></div>
          <li class="disabled">Propriétés de ${title}</li>
        `;
        document.getElementById('cm-open')?.addEventListener('click', () => {
          const targetId = icon.getAttribute('data-target');
          if (targetId) {
            toggleWindow(targetId);
          } else if (icon.id === 'btn-exit-os') {
            const exitBtn = document.getElementById('btn-exit-os');
            if (exitBtn) exitBtn.dispatchEvent(new MouseEvent('click'));
          }
        });
      } else if (windowHeader) {
        const win = windowHeader.closest('.os-window') as HTMLElement;
        contextMenuList.innerHTML = `
          <li id="cm-close">Fermer la fenêtre</li>
          <li id="cm-minimize">Réduire</li>
        `;
        document.getElementById('cm-close')?.addEventListener('click', () => {
          win.querySelector('.win-btn.close')?.dispatchEvent(new MouseEvent('click'));
        });
        document.getElementById('cm-minimize')?.addEventListener('click', () => {
          win.querySelector('.win-btn.minimize')?.dispatchEvent(new MouseEvent('click'));
        });
      } else {
        contextMenuList.innerHTML = `
          <li id="cm-refresh">Actualiser</li>
          <div class="separator"></div>
          <li id="cm-wallpaper">Fonds d'écran</li>
          <div class="separator"></div>
          <li id="cm-quit">Quitter OS</li>
        `;
        document.getElementById('cm-refresh')?.addEventListener('click', () => {
          desktopArea.style.opacity = '0';
          setTimeout(() => { desktopArea.style.opacity = '1'; }, 200);
        });
        document.getElementById('cm-wallpaper')?.addEventListener('click', () => {
          toggleWindow('win-wallpaper');
        });
        document.getElementById('cm-quit')?.addEventListener('click', () => {
          const exitBtn = document.getElementById('btn-exit-os');
          if (exitBtn) exitBtn.dispatchEvent(new MouseEvent('click'));
        });
      }

      contextMenu.style.display = 'block';

      let x = e.clientX;
      let y = e.clientY;
      const menuWidth = contextMenu.offsetWidth || 180;
      const menuHeight = contextMenu.offsetHeight || 150;

      if (x + menuWidth > window.innerWidth) x = window.innerWidth - menuWidth;
      if (y + menuHeight > window.innerHeight) y = window.innerHeight - menuHeight;

      contextMenu.style.left = `${x}px`;
      contextMenu.style.top = `${y}px`;
    });

    syncDock();
  });
</script>

