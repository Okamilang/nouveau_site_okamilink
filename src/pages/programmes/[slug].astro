---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const programProjects = projects.filter(p => p.data.category === 'program');
  return programProjects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const coverSrc = project.data.coverImage?.src;

// Données structurées : application / logiciel
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": project.data.title,
  "description": project.data.description,
  "url": pageURL,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Android, Web",
  "keywords": project.data.tags.join(", "),
  "author": { "@type": "Organization", "name": "Okamilink" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};
---

<BaseLayout
  title={`${project.data.title} | Okamilink`}
  description={project.data.description}
  image={coverSrc}
  ogType="article"
  jsonLd={appSchema}
>
  <article class={`project-article ${project.data.category === 'program' ? 'is-program' : ''}`} style={project.data.accent ? `--accent-app: ${project.data.accent}` : undefined}>
    <div class="program-topbar">
      <a href="/programmes" class="back-link">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>
        Tous les programmes
      </a>
      {project.data.url && (
        <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="access-btn">
          <span>Accéder au programme</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
        </a>
      )}
    </div>

    {project.data.category !== 'program' && (
      <header class="project-header">
        <div class="header-content">
          <h1 class="title" transition:name={`title-${project.slug}`}>{project.data.title}</h1>
          <div class="meta">
            <span class="client">Client: {project.data.client}</span>
            <span class="separator">•</span>
            <span class="date">{project.data.date.getFullYear()}</span>
          </div>
          <div class="tags">
            {project.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>

        {project.data.coverImage && (
          <div class="cover-wrapper">
            <Image
              src={project.data.coverImage}
              alt={project.data.title}
              width={1600}
              height={900}
              class="cover-image"
              transition:name={`cover-${project.slug}`}
            />
          </div>
        )}
      </header>
    )}

    <div class="project-content">
      <Content />
    </div>

    <footer class="project-footer">
      <a href="/contact" class="next-cta">
        <span class="next-label">{project.data.ctaLabel ?? "Besoin d'un outil sur-mesure ?"}</span>
        <span class="next-title">Me contacter
          <svg width="28" height="28" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-article {
    padding-bottom: 8rem;
  }

  .program-topbar {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 2rem 2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    opacity: 0;
    animation: reveal 0.9s var(--ease-out-expo) 0.1s forwards;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.3s ease;
  }

  .back-link svg { transition: transform 0.4s var(--ease-out-expo); }
  .back-link:hover { color: var(--text-main); }
  .back-link:hover svg { transform: translateX(-3px); }

  .access-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--text-main);
    color: var(--bg-color);
    font-weight: 600;
    font-size: var(--step-body);
    transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s ease;
  }

  .access-btn svg { transition: transform 0.4s var(--ease-out-expo); }

  .access-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -12px color-mix(in oklch, var(--accent-purple) 60%, transparent);
  }

  .access-btn:hover svg { transform: translate(2px, -2px); }

  .project-header {
    padding-top: 4rem;
  }

  .header-content {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem 4rem;
    text-align: center;
  }

  .title {
    font-size: var(--step-display);
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .meta {
    font-size: var(--step-body);
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    align-items: center;
  }

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: var(--step-label);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--text-main) 10%, transparent);
    color: var(--text-main);
  }

  .cover-wrapper {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    border-radius: 24px;
    overflow: hidden;
    padding: 0 1rem;
  }

  .cover-image {
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain;
    object-position: center;
    border-radius: 16px;
    display: block;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
  }

  .project-content {
    max-width: 900px;
    margin: 4rem auto 0;
    padding: 0 2rem;
    font-size: var(--step-body);
    font-weight: 300;
    line-height: 1.85;
    color: var(--text-muted);
    opacity: 0;
    animation: reveal 1s var(--ease-out-expo) 0.25s forwards;
  }

  .is-program .project-content {
    max-width: var(--container-width);
    margin-top: 2rem;
  }

  .project-content :global(h1) {
    color: var(--text-main);
    font-size: var(--step-display);
    letter-spacing: -0.03em;
    margin: 0 0 2rem;
  }

  .project-content :global(h2) {
    color: var(--text-main);
    font-size: var(--step-title);
    margin: 3.5rem 0 1.25rem;
  }

  .project-content :global(h3) {
    color: var(--text-main);
    font-size: var(--step-body);
    margin: 2.5rem 0 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-content :global(strong) {
    color: var(--text-main);
    font-weight: 500;
  }

  .project-content :global(a:not([class])) {
    color: var(--accent-blue);
    border-bottom: 1px solid color-mix(in oklch, var(--accent-blue) 40%, transparent);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .project-content :global(a:not([class]):hover) {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
  }

  .project-content :global(ul), .project-content :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    list-style: disc;
  }

  .project-content :global(li) { margin-bottom: 0.5rem; }
  .project-content :global(li::marker) { color: var(--accent-pink); }

  .project-content :global(blockquote) {
    margin: 0 0 2rem;
    padding: 1rem 1.5rem;
    border-left: 2px solid var(--accent-pink);
    background: color-mix(in oklch, var(--bg-surface) 60%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-main);
    font-weight: 300;
  }

  .project-content :global(blockquote p:last-child) { margin-bottom: 0; }

  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    background: color-mix(in oklch, var(--bg-color) 80%, transparent);
    border: 1px solid var(--line);
    color: var(--accent-blue);
  }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: var(--radius-md);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .project-content :global(img:hover) {
    transform: scale(1.015);
  }

  /* ───── Plan commun des pages programme ───── */
  .project-content :global(.app-kicker) {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .project-content :global(h1) { color: var(--accent-app, var(--text-main)); }
  .project-content :global(.app-lede) { max-width: 60ch; color: var(--text-muted); }

  .project-content :global(.shots-row) {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start; /* sinon les captures sont étirées à la plus haute */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0 1rem;
  }
  .project-content :global(.shots-row img) {
    flex: 0 0 auto;
    width: 240px;
    height: auto;
    aspect-ratio: 9 / 17;   /* même format pour toutes les captures */
    object-fit: cover;
    object-position: top;
    margin: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    scroll-snap-align: start;
  }

  .project-content :global(.feature-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .project-content :global(.feature-grid li) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .project-content :global(.feature-grid strong) { font-family: var(--font-display); font-weight: 600; }
  .project-content :global(.feature-grid span) { color: var(--text-muted); line-height: 1.6; }

  .project-content :global(.app-cta) { margin-top: 1.5rem; }

  .project-content :global(.two-col) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }
  .project-content :global(.two-col h2) { margin-top: 3rem; }

  @media (max-width: 760px) {
    .project-content :global(.feature-grid),
    .project-content :global(.two-col) { grid-template-columns: 1fr; gap: 0; }
  }

  /* Démo interactive et captures légendées */
  .project-content :global(.live-demo) {
    display: block;
    width: 100%;
    height: min(720px, 80vh);
    border: 0;
    background: var(--bg-color);
  }
  .project-content :global(.browser-content p) { margin: 0; }
  .project-content :global(.mockup-hint) {
    margin: 0.9rem 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-dim);
  }
  .project-content :global(figure.shot) { margin: 2.5rem 0; }
  .project-content :global(figure.shot img) {
    margin: 0 auto;
    border: 1px solid var(--line-strong);
  }
  .project-content :global(figcaption) {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-dim);
  }

  .project-content :global(details.shots-more) {
    margin: 2rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }
  .project-content :global(details.shots-more summary) {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-main);
  }
  .project-content :global(details.shots-more summary:focus-visible) { outline-offset: 4px; }

  /* Seuil final, identique aux études de cas, aligné sur le contenu */
  .project-footer {
    max-width: var(--container-width);
    margin: 5rem auto 0;
    padding: 0 2rem;
  }
  .next-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .next-label {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .next-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-title);
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .next-title svg { color: var(--accent-pink); transition: transform 0.5s var(--ease-out-expo); }
  .next-cta:hover .next-title svg,
  .next-cta:focus-visible .next-title svg { transform: translateX(8px); }

  /* Gouttière mobile commune à tout le site */
  @media (max-width: 480px) {
    .program-topbar, .header-content, .project-content, .project-footer { padding-left: 1.25rem; padding-right: 1.25rem; }
  }

  /* Longueur de ligne lisible (≈ 68 caractères), le conteneur garde l'alignement */
  .project-content :global(p),
  .project-content :global(li) { max-width: 68ch; }
</style>
