---
const expertises = [
  {
    index: '01',
    title: "Ingénierie Front-End",
    description: "Développement de plateformes ultra-performantes et interactives, exploitant les derniers standards HTML5/CSS pour une fluidité absolue.",
    icon: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
    rawData: "{ \"module\": \"FE_Core\", \"perf_score\": 99, \"threads\": 8, \"status\": \"OPTIMIZED\" }"
  },
  {
    index: '02',
    title: "Écosystèmes Modernes",
    description: "Conception d'architectures robustes et évolutives, pensées pour des cas d'usage complexes sans jamais sacrifier la vitesse de chargement.",
    icon: 'M12 3 3 8l9 5 9-5-9-5zM3 12l9 5 9-5M3 16l9 5 9-5',
    rawData: "{ \"arch\": \"Microservices\", \"scale\": \"Auto\", \"latency\": \"<15ms\", \"uptime\": \"99.99%\" }"
  },
  {
    index: '03',
    title: "Design Interactif & UI",
    description: "Intégration de micro-animations, de transitions natives et de designs adaptatifs (CSS Subgrid, Container Queries) pour une interface vivante.",
    icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
    rawData: "{ \"engine\": \"WebGL/CSS3\", \"fps\": 60, \"motion\": \"Fluid\", \"glassmorphism\": true }"
  },
  {
    index: '04',
    title: "Optimisation & Accessibilité",
    description: "Un code sémantique irréprochable, pensé pour le SEO technique et garanti 100% accessible.",
    icon: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
    rawData: "{ \"a11y_score\": 100, \"seo\": \"Technical\", \"semantic\": \"HTML5_Strict\", \"contrast\": \"AAA\" }"
  }
];
---

<section class="expertise scroll-reveal" id="expertise">
  <div class="section-visual" aria-hidden="true">
    <div class="glow-orb" style="width: 500px; height: 500px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-pink) 45%, transparent) 0%, transparent 70%); top: -20%; right: -10%;"></div>
    <div class="glow-orb" style="width: 700px; height: 700px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 40%, transparent) 0%, transparent 70%); bottom: -20%; left: -20%; animation-delay: -3s;"></div>
  </div>

  <header class="expertise-header">
    <div class="header-left">
      <p class="section-label"><em>002</em> Expertise</p>
      <h2>Nos Domaines<br/>d'<span class="text-gradient">Expertise</span></h2>
    </div>
    <p class="header-right">Une maîtrise technique totale pour des résultats exceptionnels. Quatre piliers, une seule exigence : que chaque détail serve votre projet.</p>
  </header>

  <div class="expertise-grid">
    {expertises.map((item) => (
      <article class="expertise-card tilt-card magnetic">
        <div class="glare"></div>
        <div class="card-top">
          <span class="card-index">{item.index}</span>
          <span class="card-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
          </span>
        </div>
        <h3 class="card-title">{item.title}</h3>
        <p class="card-desc">{item.description}</p>
        <div class="card-raw-data only-console">
          <pre><code>{item.rawData}</code></pre>
        </div>
        <span class="card-corner" aria-hidden="true"></span>
      </article>
    ))}
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.tilt-card');
    if (window.matchMedia('(pointer: coarse)').matches) return;

    cards.forEach(card => {
      const htmlCard = card as HTMLElement;

      htmlCard.addEventListener('mousemove', (e) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        htmlCard.style.setProperty('--x', `${x}px`);
        htmlCard.style.setProperty('--y', `${y}px`);

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -6;
        const rotateY = ((x - centerX) / centerX) * 6;

        htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.015, 1.015, 1.015)`;
      });

      htmlCard.addEventListener('mouseleave', () => {
        htmlCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    });
  });
</script>

<style>
  .expertise {
    position: relative;
    padding: 9rem 2rem 6rem;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .section-visual {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    z-index: 0;
  }

  /* En-tête éditorial asymétrique */
  .expertise-header {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .expertise-header h2 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1;
  }

  .header-right {
    color: var(--text-muted);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 40ch;
    padding-bottom: 0.4rem;
    border-left: 1px solid var(--line-strong);
    padding-left: 1.5rem;
  }

  @media (max-width: 860px) {
    .expertise-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .header-right {
      border-left: none;
      padding-left: 0;
    }
  }

  /* Bento Grid */
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .expertise-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(260px, auto);
    }
    .expertise-card:nth-child(1) { grid-column: span 2; }
    .expertise-card:nth-child(4) { grid-column: span 2; }
  }

  .expertise-card {
    background: color-mix(in oklch, var(--bg-surface) 70%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.75rem 1.9rem;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 1rem;
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s ease, border-color 0.4s ease, background 0.4s ease;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Bordure iridescente via masque */
  .expertise-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: var(--holographic-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 10;
    pointer-events: none;
  }

  .glare {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    pointer-events: none;
    background: radial-gradient(circle 320px at var(--x, 50%) var(--y, 50%), color-mix(in oklch, var(--accent-purple) 14%, transparent) 0%, transparent 80%);
    opacity: 0;
    transition: opacity 0.4s;
    z-index: 5;
  }

  /* Coin décoratif */
  .card-corner {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 14px;
    height: 14px;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.4s ease, transform 0.5s var(--ease-out-expo);
  }

  .expertise-card:hover {
    background: color-mix(in oklch, var(--bg-surface) 90%, var(--accent-purple) 10%);
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.5), var(--glow-shadow);
  }

  .expertise-card:hover::before,
  .expertise-card:hover .glare { opacity: 1; }

  .expertise-card:hover .card-corner {
    border-color: var(--accent-pink);
    transform: translate(2px, 2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    transition: color 0.3s ease;
  }

  .expertise-card:hover .card-index { color: var(--accent-pink); }

  .card-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--accent-blue);
    background: color-mix(in oklch, var(--bg-color) 70%, transparent);
    border: 1px solid var(--line);
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.5s var(--ease-out-expo);
  }

  .expertise-card:hover .card-icon {
    color: var(--accent-pink);
    border-color: color-mix(in oklch, var(--accent-pink) 35%, transparent);
    transform: rotate(-6deg);
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-main);
    margin-top: 0.5rem;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
    max-width: 52ch;
  }

  .card-raw-data {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--data-tech);
    background: color-mix(in oklch, var(--bg-color) 80%, transparent);
    padding: 0;
    border-radius: 0.5rem;
    border-left: 2px solid var(--data-action);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease, padding 0.3s ease, margin-top 0.3s ease;
    margin-top: 0;
  }

  .card-raw-data pre {
    margin: 0;
    white-space: pre-wrap;
  }

  :global(html[data-experience="console"]) .expertise-card:hover .card-raw-data {
    max-height: 150px;
    opacity: 1;
    padding: 1rem;
    margin-top: 0.5rem;
  }
</style>

<!-- Surcharges pour l'affichage dans une fenêtre du mode console -->
<style>
  :global(html[data-experience="console"]) .expertise { padding: 1.5rem 1rem 2rem; }
  :global(html[data-experience="console"]) .expertise-header { margin-bottom: 2rem; }
  :global(html[data-experience="console"]) .section-label { color: var(--cyber-cyan); }
  :global(html[data-experience="console"]) .section-label em { color: var(--cyber-magenta); }
  :global(html[data-experience="console"]) .header-right { border-color: rgba(0, 243, 255, 0.25); }
  :global(html[data-experience="console"]) .expertise-card {
    background: rgba(0, 0, 0, 0.45);
    border-color: rgba(0, 243, 255, 0.2);
    border-radius: 4px;
  }
  :global(html[data-experience="console"]) .expertise-card::before,
  :global(html[data-experience="console"]) .glare { border-radius: 4px; }
  :global(html[data-experience="console"]) .card-icon {
    border-radius: 4px;
    color: var(--cyber-cyan);
    border-color: rgba(0, 243, 255, 0.3);
  }
  :global(html[data-experience="console"]) .card-index,
  :global(html[data-experience="console"]) .expertise-card:hover .card-index { color: var(--cyber-magenta); }
  :global(html[data-experience="console"]) .card-corner { border-color: rgba(0, 243, 255, 0.4); }
  :global(html[data-experience="console"]) .card-title { font-family: var(--font-mono); letter-spacing: 0.02em; }
  :global(html[data-experience="console"]) .section-visual { display: none; }
</style>
