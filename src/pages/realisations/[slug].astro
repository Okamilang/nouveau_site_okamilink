---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const websiteProjects = projects.filter(p => p.data.category === 'website');
  return websiteProjects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const coverSrc = project.data.coverImage?.src;

// Données structurées : étude de cas / réalisation
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": project.data.title,
  "headline": project.data.title,
  "description": project.data.description,
  "url": pageURL,
  "keywords": project.data.tags.join(", "),
  "datePublished": project.data.date.toISOString(),
  "author": { "@type": "Organization", "name": "Okamilink" },
  "creator": { "@type": "Person", "name": "Daniel Cohen" }
};
---

<BaseLayout
  title={`${project.data.title} — Étude de cas web | Okamilink`}
  description={project.data.description}
  image={coverSrc}
  ogType="article"
  jsonLd={projectSchema}
>
  <article class="project-article">
    <header class="project-header">
      <div class="header-content">
        <a href="/realisations" class="back-link reveal-up" style="--i: 0">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>
          Toutes les réalisations
        </a>
        <p class="section-label reveal-up" style="--i: 1"><em>Étude de cas</em> {project.data.date.getFullYear()}</p>
        <h1 class="title reveal-up" style="--i: 2" transition:name={`title-${project.slug}`}>{project.data.title}</h1>
        <p class="lede reveal-up" style="--i: 3">{project.data.description}</p>

        <dl class="meta reveal-up" style="--i: 4">
          <div class="meta-item">
            <dt>Client</dt>
            <dd>{project.data.client}</dd>
          </div>
          <div class="meta-item">
            <dt>Année</dt>
            <dd>{project.data.date.getFullYear()}</dd>
          </div>
          <div class="meta-item meta-tags">
            <dt>Stack</dt>
            <dd>
              {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </dd>
          </div>
          {project.data.url && (
            <div class="meta-item">
              <dt>En ligne</dt>
              <dd>
                <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="site-link">
                  {project.data.url.replace(/^https?:\/\/(www\.)?/, '')}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>

      {project.data.coverImage && (
        <div class="cover-wrapper reveal-up" style="--i: 5">
          <Image
            src={project.data.coverImage}
            alt={project.data.title}
            width={1600}
            height={900}
            class="cover-image"
            transition:name={`cover-${project.slug}`}
          />
        </div>
      )}
    </header>

    <div class="project-content">
      <Content />
    </div>

    <footer class="project-footer">
      <a href="/contact" class="next-cta">
        <span class="next-label">Un projet similaire ?</span>
        <span class="next-title">Initialiser le contact
          <svg width="28" height="28" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-article {
    padding-bottom: 6rem;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.05s + var(--i, 0) * 0.1s);
  }

  .project-header {
    padding-top: 2.5rem;
  }

  .header-content {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.3s ease;
    margin-bottom: 0.75rem;
  }

  .back-link svg { transition: transform 0.4s var(--ease-out-expo); }
  .back-link:hover { color: var(--text-main); }
  .back-link:hover svg { transform: translateX(-3px); }

  .title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text-main);
    max-width: 16ch;
  }

  .lede {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 56ch;
    line-height: 1.6;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, auto));
    gap: 1.5rem 3rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .meta-tags { grid-column: span 2; }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .meta-item dd {
    font-size: 1rem;
    color: var(--text-main);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    border: 1px solid var(--line-strong);
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-blue);
    transition: color 0.3s ease;
  }

  .site-link svg { transition: transform 0.4s var(--ease-out-expo); }
  .site-link:hover { color: var(--accent-pink); }
  .site-link:hover svg { transform: translate(2px, -2px); }

  .cover-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    display: block;
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 60px -20px color-mix(in oklch, var(--accent-purple) 25%, transparent);
  }

  /* ───── Contenu rédactionnel ───── */
  .project-content {
    max-width: 900px;
    margin: 5rem auto 0;
    padding: 0 2rem;
    font-size: 1.12rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--text-muted);
  }

  .project-content :global(h2) {
    color: var(--text-main);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 4rem 0 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .project-content :global(h3) {
    color: var(--text-main);
    font-size: 1.35rem;
    margin: 2.5rem 0 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-content :global(strong) {
    color: var(--text-main);
    font-weight: 500;
  }

  .project-content :global(a) {
    color: var(--accent-blue);
    border-bottom: 1px solid color-mix(in oklch, var(--accent-blue) 40%, transparent);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .project-content :global(a:hover) {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
  }

  .project-content :global(ul), .project-content :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    list-style: disc;
  }

  .project-content :global(li) { margin-bottom: 0.5rem; }

  .project-content :global(li::marker) { color: var(--accent-pink); }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: var(--radius-md);
  }

  /* ───── Pied d'article ───── */
  .project-footer {
    max-width: 900px;
    margin: 5rem auto 0;
    padding: 0 2rem;
  }

  .next-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: border-color 0.4s ease;
  }

  .next-cta:hover { border-color: var(--line-strong); }

  .next-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .next-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .next-title svg {
    color: var(--accent-pink);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .next-cta:hover .next-title svg { transform: translateX(8px); }
</style>
