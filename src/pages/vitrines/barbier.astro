  .ticket { grid-column: 2; grid-row: 1 / 4; align-self: start; position: sticky; top: 6rem; padding: 1.6rem 1.5rem 1.5rem; background: var(--bone); color: var(--black); -webkit-mask: radial-gradient(circle 10px at 0 62%, transparent 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 10px at 100% 62%, transparent 98%, #000) right / 51% 100% no-repeat; mask: radial-gradient(circle 10px at 0 62%, transparent 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 10px at 100% 62%, transparent 98%, #000) right / 51% 100% no-repeat; overflow: visible; }
