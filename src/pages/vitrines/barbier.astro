---
/**
 * Démo « Lame & Laiton » — barbier fictif.
 * Identité : noir profond, laiton, typographie condensée, ton direct (tutoiement).
 * Spécificités : attente sans RDV en direct, carte façon bar à cocktails, lookbook filtrable,
 * réservation en trois gestes (prestation → barbier → créneau) avec ticket de confirmation.
 */
import '@fontsource/anton';
import '@fontsource-variable/archivo';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import { photo } from '../../lib/vitrines';
import displayFont from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';

const p = (n: string) => photo('barbier', n);

const services = [
  { group: 'Les coupes', items: [
    { id: 'coupe', name: 'Coupe homme', desc: 'Shampoing, coupe aux ciseaux et à la tondeuse, coiffage', min: 30, price: 25 },
    { id: 'degrade', name: 'Coupe + dégradé', desc: 'Dégradé américain ou à blanc, contours au rasoir', min: 45, price: 30 },
    { id: 'enfant', name: 'Coupe enfant', desc: 'Jusqu’à 12 ans, avec la patience en plus', min: 20, price: 18 },
  ] },
  { group: 'La barbe', items: [
    { id: 'barbe', name: 'Taille de barbe', desc: 'Mise en forme à la tondeuse, huile de finition', min: 20, price: 18 },
    { id: 'sculpt', name: 'Barbe sculptée', desc: 'Traçage des contours au rasoir, serviette tiède', min: 30, price: 24 },
  ] },
  { group: 'Les rituels', items: [
    { id: 'rasage', name: 'Rasage à l’ancienne', desc: 'Serviette chaude, blaireau, coupe-chou, baume', min: 35, price: 30 },
    { id: 'complet', name: 'Le complet', desc: 'Coupe, barbe sculptée et serviette chaude', min: 60, price: 48 },
  ] },
];
const allServices = services.flatMap((g) => g.items);

const barbers = [
  { id: 'sami', name: 'Sami', role: 'Dégradés & coupes texturées', since: 'Au fauteuil depuis 2016', img: p('barbier-sami') },
  { id: 'hugo', name: 'Hugo', role: 'Classiques, barbe & rasage', since: 'Vingt ans de métier', img: p('barbier-hugo') },
];

const looks = [
  { id: 'degrade', tag: 'degrade', title: 'Dégradé', meta: '45 min · 30 € · Sami', service: 'degrade', barber: 'sami', img: p('coupe-degrade') },
  { id: 'barbe', tag: 'barbe', title: 'Barbe sculptée', meta: '30 min · 24 € · Hugo', service: 'sculpt', barber: 'hugo', img: p('coupe-barbe') },
  { id: 'classique', tag: 'classique', title: 'Raie classique', meta: '30 min · 25 € · Hugo', service: 'coupe', barber: 'hugo', img: p('coupe-classique') },
  { id: 'texture', tag: 'texture', title: 'Crop texturé', meta: '30 min · 25 € · Sami', service: 'coupe', barber: 'sami', img: p('coupe-texture') },
];
const filters = [
  { id: 'all', label: 'Tout' }, { id: 'degrade', label: 'Dégradé' }, { id: 'barbe', label: 'Barbe' },
  { id: 'classique', label: 'Classique' }, { id: 'texture', label: 'Texturé' },
];
---

<DemoLayout
  title="Lame & Laiton — démo de site vitrine pour barbier | Okamilink"
  description="Démo d'un site vitrine de barbier réalisé par Okamilink : réservation en trois étapes, choix du barbier, attente sans rendez-vous en direct et lookbook des coupes. Entreprise fictive."
  slug="barbier"
  themeColor="#0b0b0b"
  favicon={{ text: 'L', bg: '#0b0b0b', fg: '#c9a26a' }}
  image={p('hero')}
>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
  <div class="ll">
    <header class="nav" id="ll-nav">
      <a href="#top" class="logo" aria-label="Lame & Laiton — accueil">LAME <span>&amp;</span> LAITON</a>
      <div class="nav-right">
        <a href="#carte" class="nav-link">La carte</a>
        <a href="#looks" class="nav-link">Lookbook</a>
        <a href="#salon" class="nav-link">Le salon</a>
        <a href="#reserver" class="btn btn-brass btn-sm">Réserver</a>
      </div>
    </header>

    <section class="hero" id="top">
      <Image src={p('hero')} alt="Un barbier termine un dégradé au rasoir sur la nuque d'un client" widths={[768, 1280, 1536]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="pole" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="tag"><span class="tag-line"></span>Barbier · Val-des-Blés · depuis 2016</p>
        <h1 class="hero-title">
          <span class="mask"><span>Coupe nette.</span></span>
          <span class="mask"><span class="outline">Barbe franche.</span></span>
        </h1>
        <p class="hero-lead">Dégradés au millimètre, rasage à l’ancienne et vraie discussion. Passe sans rendez-vous ou réserve ton fauteuil en trois gestes.</p>
        <div class="hero-actions">
          <a href="#reserver" class="btn btn-brass">Réserver mon créneau</a>
          <a href="#carte" class="btn btn-line">Voir les tarifs</a>
        </div>
      </div>

      <aside class="wait" aria-live="polite">
        <div class="wait-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div>
          <p class="wait-label" data-wait-label>Sans rendez-vous</p>
          <p class="wait-value" data-wait-value>~15 min</p>
          <p class="wait-sub" data-wait-sub>2 personnes avant toi</p>
        </div>
        <span class="demo-note">Démo · estimé selon l’heure</span>
      </aside>
    </section>

    <div class="bands" aria-hidden="true">
      <div class="band band-brass"><div class="band-track">{[0, 1].map(() => <span>Dégradé ✦ Taille de barbe ✦ Rasage à l’ancienne ✦ Serviette chaude ✦ Contours au rasoir ✦&nbsp;</span>)}</div></div>
      <div class="band band-bone"><div class="band-track band-track--rev">{[0, 1].map(() => <span>Sans rendez-vous ✦ Mardi → samedi ✦ 9 h – 19 h 30 ✦ Café offert ✦&nbsp;</span>)}</div></div>
    </div>

    <!-- ───────── La carte ───────── -->
    <section class="carte" id="carte" aria-labelledby="carte-title">
      <div class="carte-frame">
        <p class="carte-ornament" aria-hidden="true">✦ ✦ ✦</p>
        <h2 id="carte-title" class="carte-title">La carte</h2>
        <p class="carte-sub">Clique sur une prestation pour la réserver.</p>
        <div class="carte-cols">
          {services.map((g) => (
            <div class="carte-group">
              <h3 class="group-title">{g.group}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>
                    <a href="#reserver" class="svc" data-pick-service={s.id}>
                      <span class="svc-head"><span class="svc-name">{s.name}</span><span class="svc-dots" aria-hidden="true"></span><span class="svc-price">{s.price} €</span></span>
                      <span class="svc-desc">{s.desc} · {s.min} min</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────── Lookbook ───────── -->
    <section class="looks" id="looks" aria-labelledby="looks-title">
      <header class="looks-head">
        <h2 id="looks-title" class="title">Le <span class="brass">lookbook</span></h2>
        <div class="filters" role="group" aria-label="Filtrer les coupes">
          {filters.map((f, i) => <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
        </div>
      </header>
      <ul class="look-list">
        {looks.map((l) => (
          <li class="look" data-tag={l.tag}>
            <div class="look-media">
              <Image src={l.img} alt={`Coupe ${l.title.toLowerCase()}`} widths={[400, 700]} sizes="(max-width: 700px) 80vw, 25vw" class="look-img" />
            </div>
            <div class="look-body">
              <h3 class="look-title">{l.title}</h3>
              <p class="look-meta">{l.meta}</p>
              <a href="#reserver" class="look-cta" data-pick-service={l.service} data-pick-barber={l.barber}>Je veux cette coupe →</a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ───────── Réservation ───────── -->
    <section class="book" id="reserver" aria-labelledby="book-title">
      <h2 id="book-title" class="title title-xl">Réserve<br /><span class="brass">ton fauteuil.</span></h2>

      <div class="book-card">
        <ol class="book-steps" aria-label="Étapes de réservation">
          <li data-stepdot="0" class="is-current"><span>01</span> Prestation</li>
          <li data-stepdot="1"><span>02</span> Barbier</li>
          <li data-stepdot="2"><span>03</span> Créneau</li>
        </ol>
        <div class="book-progress"><span data-progress></span></div>

        <div class="book-viewport">
          <div class="book-track" data-track>
            <!-- 1. Prestation -->
            <div class="book-pane" data-pane="0">
              <div class="svc-grid">
                {allServices.map((s) => (
                  <button type="button" class="pick-card" data-service={s.id} data-price={s.price} data-min={s.min} data-name={s.name}>
                    <span class="pick-name">{s.name}</span>
                    <span class="pick-meta">{s.min} min</span>
                    <span class="pick-price">{s.price} €</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- 2. Barbier -->
            <div class="book-pane" data-pane="1" inert>
              <div class="barber-grid">
                {barbers.map((b) => (
                  <button type="button" class="barber-card" data-barber={b.id} data-name={b.name}>
                    <Image src={b.img} alt="" widths={[300, 500]} sizes="(max-width: 700px) 45vw, 240px" class="barber-img" />
                    <span class="barber-info"><span class="barber-name">{b.name}</span><span class="barber-role">{b.role}</span><span class="barber-since">{b.since}</span></span>
                  </button>
                ))}
                <button type="button" class="barber-card barber-any" data-barber="any" data-name="Le premier dispo">
                  <span class="any-icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" width="56" height="56"><circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2"/><path d="M24 12v12l8 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </span>
                  <span class="barber-info"><span class="barber-name">Peu importe</span><span class="barber-role">Le premier barbier disponible</span><span class="barber-since">Plus de créneaux</span></span>
                </button>
              </div>
              <button type="button" class="back" data-back="0">← Changer de prestation</button>
            </div>

            <!-- 3. Créneau -->
            <div class="book-pane" data-pane="2" inert>
              <div class="days" data-days role="group" aria-label="Jour"></div>
              <div class="times" data-times role="group" aria-label="Heure"></div>
              <button type="button" class="back" data-back="1">← Changer de barbier</button>
            </div>
          </div>
        </div>

        <aside class="ticket" data-ticket aria-live="polite">
          <p class="ticket-head">Ton ticket</p>
          <dl class="ticket-rows">
            <div><dt>Prestation</dt><dd data-t-service>—</dd></div>
            <div><dt>Barbier</dt><dd data-t-barber>—</dd></div>
            <div><dt>Quand</dt><dd data-t-when>—</dd></div>
          </dl>
          <div class="ticket-total"><span>Total</span><strong data-t-price>0 €</strong></div>
          <button type="button" class="btn btn-brass btn-block" data-book disabled>Confirmer</button>
          <div class="stamp" data-stamp aria-hidden="true">C’est calé</div>
          <span class="demo-note">Démo · rien n’est envoyé</span>
        </aside>
      </div>
    </section>

    <!-- ───────── Le salon ───────── -->
    <section class="salon" id="salon" aria-labelledby="salon-title">
      <div class="salon-media">
        <Image src={p('salon')} alt="Le salon : fauteuils de barbier vintage, miroirs cerclés de laiton et carrelage noir" widths={[768, 1280, 1536]} sizes="(max-width: 900px) 100vw, 60vw" class="salon-img" />
      </div>
      <div class="salon-body">
        <h2 id="salon-title" class="title">Le salon</h2>
        <p class="lead">Trois fauteuils, du laiton, du bon son et un café qui t’attend. On prend le temps de comprendre ce que tu veux avant de toucher à la tondeuse.</p>
        <address class="addr">22, rue des Tanneurs<br />Val-des-Blés</address>
        <ul class="hours">
          <li data-day="1"><span>Lundi</span><span>14 h – 19 h</span></li>
          <li data-day="2"><span>Mardi</span><span>9 h – 19 h 30</span></li>
          <li data-day="3"><span>Mercredi</span><span>9 h – 19 h 30</span></li>
          <li data-day="4"><span>Jeudi</span><span>9 h – 19 h 30</span></li>
          <li data-day="5"><span>Vendredi</span><span>9 h – 19 h 30</span></li>
          <li data-day="6"><span>Samedi</span><span>9 h – 18 h</span></li>
          <li data-day="0"><span>Dimanche</span><span>Fermé</span></li>
        </ul>
      </div>
    </section>

    <footer class="foot">
      <span class="logo">LAME <span>&amp;</span> LAITON</span>
      <p class="foot-small">Entreprise fictive. Site de démonstration conçu et développé par <a href="/">Okamilink</a>.</p>
    </footer>
  </div>
</DemoLayout>

<script>
  /* ───────── Horaires & attente ───────── */
  const HOURS: Record<number, [number, number] | null> = { 0: null, 1: [840, 1140], 2: [540, 1170], 3: [540, 1170], 4: [540, 1170], 5: [540, 1170], 6: [540, 1080] };
  const DAYS = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
  const DAYS_FULL = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
  const fmt = (m: number) => { const h = Math.floor(m / 60), mi = m % 60; return mi ? `${h} h ${String(mi).padStart(2, '0')}` : `${h} h`; };
  const iso = (d: Date) => `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const seeded = (key: string) => {
    let h = 2166136261;
    for (let i = 0; i < key.length; i++) { h ^= key.charCodeAt(i); h = Math.imul(h, 16777619); }
    return () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 10000) / 10000; };
  };

  function updateWait() {
    const label = document.querySelector<HTMLElement>('[data-wait-label]')!;
    const value = document.querySelector<HTMLElement>('[data-wait-value]')!;
    const sub = document.querySelector<HTMLElement>('[data-wait-sub]')!;
    const box = label.closest<HTMLElement>('.wait')!;
    const d = new Date(), m = d.getHours() * 60 + d.getMinutes(), h = HOURS[d.getDay()];
    if (!h || m < h[0] || m >= h[1] - 20) {
      let next = { date: d, open: 540, offset: 1 };
      for (let i = 0; i < 8; i++) {
        const nd = new Date(d); nd.setDate(d.getDate() + i);
        const nh = HOURS[nd.getDay()];
        if (!nh || (i === 0 && m >= nh[0])) continue;
        next = { date: nd, open: nh[0], offset: i };
        break;
      }
      const when = next.offset === 0 ? 'aujourd’hui' : next.offset === 1 ? 'demain' : DAYS_FULL[next.date.getDay()];
      label.textContent = 'Fermé pour le moment';
      value.textContent = `Ouvre ${when}`;
      sub.textContent = `à ${fmt(next.open)} · réserve dès maintenant`;
      box.dataset.level = '0';
      return;
    }
    const hour = d.getHours();
    const peak = (hour >= 12 && hour < 14) || (hour >= 17 && hour < 19) ? 2 : 1;
    const sat = d.getDay() === 6 ? 1 : 0;
    const r = seeded(`${iso(d)}-${hour}-${Math.floor(d.getMinutes() / 15)}`)();
    const people = Math.max(0, Math.round(peak + sat + r * 2) - 1);
    const minutes = people === 0 ? 0 : people * 15 - Math.round(r * 5);
    label.textContent = 'Sans rendez-vous';
    value.textContent = minutes === 0 ? 'Fauteuil libre' : `~${minutes} min`;
    sub.textContent = people === 0 ? 'Passe maintenant, on t’attend' : `${people} personne${people > 1 ? 's' : ''} avant toi`;
    box.dataset.level = String(Math.min(4, people + 1));
  }

  /* ───────── Lookbook ───────── */
  function initLooks() {
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...document.querySelectorAll<HTMLElement>('.look')];
    filters.forEach((f) => f.addEventListener('click', () => {
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      const id = f.dataset.filter;
      items.forEach((it) => {
        const show = id === 'all' || it.dataset.tag === id;
        it.classList.toggle('is-out', !show);
        it.setAttribute('aria-hidden', String(!show));
        it.querySelectorAll('a').forEach((a) => (a.tabIndex = show ? 0 : -1));
      });
    }));
  }

  /* ───────── Réservation ───────── */
  const state = { step: 0, service: '', price: 0, min: 0, serviceName: '', barber: '', barberName: '', day: '', dayLabel: '', time: '' };
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const viewport = track.parentElement!;
  const panes = [...document.querySelectorAll<HTMLElement>('[data-pane]')];
  // La hauteur suit l'étape affichée (sinon la plus haute impose la sienne aux autres)
  const fit = () => { viewport.style.height = `${panes[state.step].offsetHeight}px`; };
  const ro = new ResizeObserver(fit);
  panes.forEach((p) => ro.observe(p));

  function go(step: number) {
    state.step = step;
    track.style.transform = `translateX(${-100 * step}%)`;
    panes.forEach((p, i) => p.toggleAttribute('inert', i !== step));
    document.querySelectorAll<HTMLElement>('[data-stepdot]').forEach((li, i) => {
      li.classList.toggle('is-current', i === step);
      li.classList.toggle('is-done', i < step);
    });
    document.querySelector<HTMLElement>('[data-progress]')!.style.transform = `scaleX(${(step + 1) / 3})`;
    if (step === 2) renderDays();
    renderTicket();
    fit();
  }

  function takenFor(barber: string, day: string) {
    const r = seeded(`${barber}|${day}`);
    const set = new Set<number>();
    for (let m = 540; m < 1170; m += 30) if (r() < 0.42) set.add(m);
    return set;
  }

  function availableTimes(date: Date): { m: number; free: boolean }[] {
    const h = HOURS[date.getDay()];
    if (!h) return [];
    const now = new Date();
    const today = iso(date) === iso(now);
    const nowM = now.getHours() * 60 + now.getMinutes();
    const out: { m: number; free: boolean }[] = [];
    const ids = state.barber === 'any' ? ['sami', 'hugo'] : [state.barber];
    const taken = ids.map((id) => takenFor(id, iso(date)));
    for (let m = h[0]; m + state.min <= h[1]; m += 30) {
      if (today && m < nowM + 30) continue;
      out.push({ m, free: taken.some((t) => !t.has(m)) });
    }
    return out;
  }

  function renderDays() {
    const box = document.querySelector<HTMLElement>('[data-days]')!;
    box.innerHTML = '';
    const start = new Date();
    for (let i = 0; i < 10; i++) {
      const d = new Date(start); d.setDate(start.getDate() + i); d.setHours(12, 0, 0, 0);
      const times = availableTimes(d);
      const closed = !HOURS[d.getDay()] || !times.some((t) => t.free);
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'day'; b.disabled = closed;
      b.setAttribute('aria-pressed', String(iso(d) === state.day));
      b.innerHTML = `<span>${i === 0 ? 'Auj.' : i === 1 ? 'Dem.' : DAYS[d.getDay()]}</span><strong>${d.getDate()}</strong>`;
      b.setAttribute('aria-label', `${DAYS_FULL[d.getDay()]} ${d.getDate()}${closed ? ', complet ou fermé' : ''}`);
      b.addEventListener('click', () => {
        state.day = iso(d); state.dayLabel = i === 0 ? 'Aujourd’hui' : i === 1 ? 'Demain' : `${cap(DAYS_FULL[d.getDay()])} ${d.getDate()}`;
        state.time = ''; renderDays(); renderTimes(d); renderTicket();
      });
      box.append(b);
      if (!state.day && !closed) { state.day = iso(d); state.dayLabel = i === 0 ? 'Aujourd’hui' : i === 1 ? 'Demain' : `${cap(DAYS_FULL[d.getDay()])} ${d.getDate()}`; b.setAttribute('aria-pressed', 'true'); }
      if (state.day === iso(d)) renderTimes(d);
    }
  }

  function renderTimes(d: Date) {
    const box = document.querySelector<HTMLElement>('[data-times]')!;
    box.innerHTML = '';
    availableTimes(d).forEach(({ m, free }) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'time'; b.disabled = !free;
      b.textContent = fmt(m);
      b.setAttribute('aria-pressed', String(state.time === fmt(m)));
      b.addEventListener('click', () => { state.time = fmt(m); renderTimes(d); renderTicket(); });
      box.append(b);
    });
  }

  function renderTicket() {
    document.querySelector('[data-t-service]')!.textContent = state.serviceName || '—';
    document.querySelector('[data-t-barber]')!.textContent = state.barberName || '—';
    document.querySelector('[data-t-when]')!.textContent = state.time ? `${state.dayLabel} · ${state.time}` : '—';
    document.querySelector('[data-t-price]')!.textContent = `${state.price} €`;
    (document.querySelector('[data-book]') as HTMLButtonElement).disabled = !(state.service && state.barber && state.time);
  }

  function pickService(id: string) {
    const btn = document.querySelector<HTMLElement>(`[data-service="${id}"]`);
    if (!btn) return;
    document.querySelectorAll('[data-service]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    Object.assign(state, { service: id, price: Number(btn.dataset.price), min: Number(btn.dataset.min), serviceName: btn.dataset.name ?? '' });
  }
  function pickBarber(id: string) {
    const btn = document.querySelector<HTMLElement>(`[data-barber="${id}"]`);
    if (!btn) return;
    document.querySelectorAll('[data-barber]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    Object.assign(state, { barber: id, barberName: btn.dataset.name ?? '', day: '', time: '' });
  }

  function initBooking() {
    document.querySelectorAll<HTMLElement>('[data-service]').forEach((b) => b.addEventListener('click', () => { pickService(b.dataset.service!); go(state.barber ? 2 : 1); }));
    document.querySelectorAll<HTMLElement>('[data-barber]').forEach((b) => b.addEventListener('click', () => { pickBarber(b.dataset.barber!); go(2); }));
    document.querySelectorAll<HTMLElement>('[data-back]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.back))));
    // Raccourcis depuis la carte et le lookbook
    document.querySelectorAll<HTMLElement>('[data-pick-service]').forEach((a) => a.addEventListener('click', () => {
      pickService(a.dataset.pickService!);
      if (a.dataset.pickBarber) { pickBarber(a.dataset.pickBarber); go(2); } else go(state.barber ? 2 : 1);
    }));
    const ticket = document.querySelector<HTMLElement>('[data-ticket]')!;
    document.querySelector('[data-book]')?.addEventListener('click', () => {
      ticket.classList.remove('is-booked'); void ticket.offsetWidth; ticket.classList.add('is-booked');
      (document.querySelector('[data-book]') as HTMLButtonElement).textContent = 'Réservé · à bientôt';
    });
    go(0);
  }

  /* ───────── Navigation ───────── */
  const nav = document.getElementById('ll-nav');
  const onNav = () => nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onNav, { passive: true });
  onNav();
  document.querySelector(`.hours li[data-day="${new Date().getDay()}"]`)?.classList.add('is-today');

  updateWait(); initLooks(); initBooking();
  setInterval(updateWait, 60_000);
</script>

