---
/**
 * Layout des sites vitrines de démonstration.
 * Volontairement indépendant de BaseLayout : chaque démo a sa propre charte
 * (polices, couleurs, navigation) et ne charge ni la navbar, ni l'OS d'Okamilink.
 */
import '@fontsource-variable/hanken-grotesk';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import DemoBadge from '../components/vitrines/DemoBadge.astro';

interface Props {
  title: string;
  description: string;
  slug: 'boulangerie' | 'restaurant' | 'barbier';
  themeColor: string;
  /** Initiales et couleurs du favicon dessiné en SVG */
  favicon: { text: string; bg: string; fg: string };
  image?: ImageMetadata;
}

const { title, description, slug, themeColor, favicon, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : null;
const ogURL = og ? new URL(og.src, Astro.site).href : new URL('/logo.png', Astro.site).href;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="${favicon.bg}"/><text x="32" y="42" font-family="Georgia,serif" font-size="28" font-weight="700" text-anchor="middle" fill="${favicon.fg}">${favicon.text}</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Daniel Cohen — Okamilink" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={faviconHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Okamilink" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <DemoBadge slug={slug} />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; overflow-x: clip; }
  body { min-height: 100vh; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; overflow-x: clip; }
  img, svg, picture { display: block; max-width: 100%; }
  button, input, select, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; }
  a { color: inherit; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>
