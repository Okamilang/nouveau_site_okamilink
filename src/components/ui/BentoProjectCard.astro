---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, description, tags, coverImage, featured, client, date } = project.data;
const href = `/${project.data.category === 'program' ? 'programmes' : 'realisations'}/${project.slug}`;
const num = String(index + 1).padStart(2, '0');
---

<a href={href} class={`bento-card ${featured ? 'featured' : ''}`} style={`--i: ${index}`}>
  <div class="card-inner">
    {coverImage && (
      <div class="image-wrapper">
        <Image
          src={coverImage}
          alt={title}
          width={800}
          height={600}
          class="cover-image"
          transition:name={`cover-${project.slug}`}
        />
        <div class="image-overlay"></div>
        <span class="card-num" aria-hidden="true">{num}</span>
        <span class="card-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13 13 3M6 3h7v7"/></svg>
        </span>
      </div>
    )}

    <div class={`content ${coverImage ? 'has-image' : ''}`}>
      <p class="card-meta">
        {!coverImage && <span class="meta-num">{num}</span>}
        <span>{client}</span>
        <span class="meta-sep">·</span>
        <span>{date.getFullYear()}</span>
      </p>
      <h3 class="title" transition:name={`title-${project.slug}`}>{title}</h3>
      <p class="description">{description}</p>

      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .bento-card {
    display: block;
    text-decoration: none;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--bg-surface) 55%, transparent);
    border: 1px solid var(--line);
    overflow: hidden;
    position: relative;
    isolation: isolate;
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s ease, border-color 0.4s ease;
    opacity: 0;
    transform: translateY(24px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.35s + var(--i, 0) * 0.1s);
  }

  /* Bordure iridescente au survol */
  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: var(--holographic-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 3;
  }

  .bento-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6), 0 0 40px -10px color-mix(in oklch, var(--accent-purple) 25%, transparent);
  }

  .bento-card:hover::before { opacity: 1; }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .featured .image-wrapper {
    aspect-ratio: 16 / 10;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s var(--ease-out-expo), filter 0.6s ease;
    filter: saturate(0.85);
  }

  .bento-card:hover .cover-image {
    transform: scale(1.04);
    filter: saturate(1);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-surface) 0%, color-mix(in oklch, var(--bg-surface) 40%, transparent) 40%, transparent 100%);
  }

  /* Numéro en haut à gauche */
  .card-num {
    position: absolute;
    top: 1rem;
    left: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--text-main);
    padding: 0.35rem 0.6rem;
    background: color-mix(in oklch, var(--bg-color) 65%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  /* Flèche en haut à droite */
  .card-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--text-main);
    background: color-mix(in oklch, var(--bg-color) 65%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-strong);
    transform: translate(6px, -6px);
    opacity: 0;
    transition: transform 0.5s var(--ease-out-expo), opacity 0.4s ease, background 0.3s ease, color 0.3s ease;
  }

  .bento-card:hover .card-arrow {
    transform: translate(0, 0);
    opacity: 1;
  }

  .card-arrow:hover {
    background: var(--text-main);
    color: var(--bg-color);
  }

  .content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-grow: 1;
    position: relative;
    z-index: 2;
  }

  .content.has-image {
    margin-top: -3rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .meta-num { color: var(--accent-pink); }
  .meta-sep { opacity: 0.5; }

  .title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-main);
    letter-spacing: -0.015em;
  }

  .featured .title {
    font-size: clamp(1.5rem, 2vw, 1.9rem);
  }

  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    border: 1px solid var(--line-strong);
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .bento-card:hover .tag {
    border-color: color-mix(in oklch, var(--accent-blue) 40%, transparent);
    color: var(--text-main);
  }
</style>
