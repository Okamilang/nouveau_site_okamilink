---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Approach from '../components/sections/Approach.astro';
import Vitrines from '../components/sections/Vitrines.astro';
import PremiumButton from '../components/common/PremiumButton.astro';
---

<BaseLayout
  title="Création de site web sur-mesure & développeur freelance (95) | Okamilink"
  description="Développeur web freelance dans le Val-d'Oise : sites vitrines, boutiques B2B sur Odoo et applications Android sur-mesure. Un seul interlocuteur, de la maquette à la mise en ligne."
>
  <Hero />
  <FeaturedWork />
  <Vitrines />
  <Approach />

  <section class="cta-section scroll-reveal" aria-labelledby="cta-title">
    <div class="cta-content">
      <div class="cta-orb" aria-hidden="true"></div>
      <p class="section-label">Contact</p>
      <h2 id="cta-title">Un projet en tête&nbsp;? Parlons-en.</h2>
      <p class="cta-text">Idée encore floue ou cahier des charges bouclé&nbsp;: racontez-moi votre projet en quelques lignes. Je vous réponds personnellement, avec une première piste.</p>
      <div class="cta-actions">
        <PremiumButton text="Me contacter" href="/contact" />
        <a href="mailto:contact@okamilink.com" class="cta-mail">contact@okamilink.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-section {
    padding: clamp(6rem, 12vw, 9rem) 2rem 6rem;
    display: flex;
    justify-content: center;
  }

  .cta-content {
    position: relative;
    width: 100%;
    max-width: calc(var(--container-width) - 4rem);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    background: color-mix(in oklch, var(--bg-surface) 55%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  /* Ligne iridescente supérieure */
  .cta-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong), transparent);
  }

  .cta-orb {
    position: absolute;
    width: 700px;
    height: 700px;
    top: -60%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 26%, transparent) 0%, transparent 65%);
    z-index: -1;
    pointer-events: none;
  }

  .cta-content .section-label::before { display: none; }

  .cta-content h2 {
    font-size: var(--step-title);
    max-width: 22ch;
    color: var(--text-main);
  }

  .cta-text {
    color: var(--text-muted);
    font-size: var(--step-body);
    font-weight: 400;
    max-width: 52ch;
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2.5rem;
    margin-top: 0.75rem;
    padding: 20px;
    margin-left: -20px;
    margin-right: -20px;
  }

  .cta-mail {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .cta-mail:hover {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
  }

  @media (max-width: 480px) {
    .cta-section { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
