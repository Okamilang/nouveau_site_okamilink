---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedWork from '../../components/sections/FeaturedWork.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// On ne garde que les programmes pour la page Applications
const programProjects = allProjects.filter(p => p.data.category === 'program');
const sortedProjects = programProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Applications & outils sur-mesure | Okamilink"
  description="Découvrez les applications et outils développés par Okamilink : Keskiécool, Swipe&Clean et le Lockpick Solver pour Gothic 1 Remake. Des logiciels conçus pour des besoins précis."
>
  <div class="page-container">
    <header class="page-header">
      <div class="header-main">
        <p class="section-label reveal-up" style="--i: 0">Applications & outils</p>
        <h1 class="title">
          <span class="reveal-text"><span class="delay-1">Mes</span></span>
          <span class="reveal-text"><span class="delay-2">programmes.</span></span>
        </h1>
        <p class="subtitle reveal-up" style="--i: 3">Des applications et des outils que j'ai conçus pour résoudre un problème précis, du tri de photos au crochetage de serrures.</p>
      </div>
    </header>

    <FeaturedWork mode="programs" />
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 3rem 2rem 8rem;
  }

  @media (max-width: 480px) {
    .page-container { padding-left: 1.25rem; padding-right: 1.25rem; }
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 820px;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.05s + var(--i, 0) * 0.12s);
  }

  .title {
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25em;
  }

  .title .reveal-text { padding: 0.08em 0.05em; margin: -0.08em -0.05em; }

  .subtitle {
    font-size: var(--step-body);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 58ch;
    line-height: 1.7;
  }




  @media (max-width: 720px) {
    .page-header { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  }

</style>
