---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import BrowserWindow from '../../components/mockups/BrowserWindow.astro';
import ScrollingMockup from '../../components/mockups/ScrollingMockup.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const websiteProjects = projects.filter(p => p.data.category === 'website');
  return websiteProjects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const outcome = project.data.outcome;
const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const coverSrc = project.data.coverImage?.src;

// Données structurées : étude de cas / réalisation
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": project.data.title,
  "headline": project.data.title,
  "description": project.data.description,
  "url": pageURL,
  "keywords": project.data.tags.join(", "),
  "datePublished": project.data.date.toISOString(),
  "author": { "@type": "Organization", "name": "Okamilink" },
  "creator": { "@type": "Person", "name": "Daniel Cohen" }
};
---

<BaseLayout
  title={`${project.data.title} — Étude de cas web | Okamilink`}
  description={project.data.description}
  image={coverSrc}
  ogType="article"
  jsonLd={projectSchema}
>
  <article class="project-article">
    <header class="project-header">
      <div class="header-content">
        <a href="/realisations" class="back-link reveal-up" style="--i: 0">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>
          Toutes les réalisations
        </a>
        <p class="section-label reveal-up" style="--i: 1">Étude de cas · {project.data.date.getFullYear()}</p>
        <h1 class="title reveal-up" style="--i: 2" transition:name={`title-${project.slug}`}>{project.data.title}</h1>
        <p class="lede reveal-up" style="--i: 3">{project.data.description}</p>

        <dl class="meta reveal-up" style="--i: 4">
          <div class="meta-item">
            <dt>Client</dt>
            <dd>{project.data.client}</dd>
          </div>
          <div class="meta-item">
            <dt>Année</dt>
            <dd>{project.data.date.getFullYear()}</dd>
          </div>
          <div class="meta-item meta-tags">
            <dt>Stack</dt>
            <dd>
              {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </dd>
          </div>
          {project.data.url && (
            <div class="meta-item">
              <dt>En ligne</dt>
              <dd>
                <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="site-link">
                  {project.data.url.replace(/^https?:\/\/(www\.)?/, '')}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7"/></svg>
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>

      {project.data.fullpage ? (
        <div class="cover-wrapper cover-live reveal-up" style="--i: 5">
          <BrowserWindow title={project.data.url ? project.data.url.replace(/^https?:\/\/(www\.)?/, '') : project.data.title}>
            <ScrollingMockup height="min(620px, 70vh)">
              <Image
                src={project.data.fullpage}
                alt={`Page d'accueil complète du site ${project.data.title}`}
                width={1100}
                class="fullpage-img"
                decoding="async"
              />
            </ScrollingMockup>
          </BrowserWindow>
          <p class="cover-hint">Faites défiler la fenêtre pour parcourir la page d'accueil.</p>
        </div>
      ) : project.data.coverImage && (
        <div class="cover-wrapper reveal-up" style="--i: 5">
          <Image
            src={project.data.coverImage}
            alt={project.data.title}
            width={1600}
            height={900}
            class="cover-image"
            transition:name={`cover-${project.slug}`}
          />
        </div>
      )}
    </header>


    <div class="project-content">
      <Content />
    </div>

    {outcome && (
      <figure class="outcome">
        <blockquote>{outcome.text}</blockquote>
        {outcome.source && <figcaption>{outcome.source}</figcaption>}
      </figure>
    )}
    {project.data.highlights && (
      <section class="project-facts" aria-labelledby="result-title">
        <h2 class="facts-title" id="result-title">En bref</h2>
        <dl>
          {project.data.highlights.map((h) => (
            <div class="pfact">
              <dt>{h.value}</dt>
              <dd>{h.label}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <footer class="project-footer">
      <a href="/contact" class="next-cta">
        <span class="next-label">Un projet similaire ?</span>
        <span class="next-title">Me contacter
          <svg width="28" height="28" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-article {
    padding-bottom: 6rem;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.05s + var(--i, 0) * 0.1s);
  }

  .project-header {
    padding-top: 2.5rem;
  }

  .header-content {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.3s ease;
    margin-bottom: 0.75rem;
  }

  .back-link svg { transition: transform 0.4s var(--ease-out-expo); }
  .back-link:hover { color: var(--text-main); }
  .back-link:hover svg { transform: translateX(-3px); }

  .title {
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text-main);
    max-width: 16ch;
  }

  .lede {
    font-size: var(--step-body);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 56ch;
    line-height: 1.6;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, auto));
    gap: 1.5rem 3rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .meta-tags { grid-column: span 2; }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .meta-item dd {
    font-size: var(--step-body);
    color: var(--text-main);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    border: 1px solid var(--line-strong);
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step-body);
    color: var(--accent-blue);
    transition: color 0.3s ease;
  }

  .site-link svg { transition: transform 0.4s var(--ease-out-expo); }
  .site-link:hover { color: var(--accent-pink); }
  .site-link:hover svg { transform: translate(2px, -2px); }

  .cover-wrapper {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    display: block;
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 60px -20px color-mix(in oklch, var(--accent-purple) 25%, transparent);
  }

  /* ───── Contenu rédactionnel ───── */
  .project-content {
    max-width: 900px;
    margin: 5rem auto 0;
    padding: 0 2rem;
    font-size: var(--step-body);
    font-weight: 400;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .project-content :global(h2) {
    color: var(--text-main);
    font-size: var(--step-title);
    margin: 4rem 0 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .project-content :global(h3) {
    color: var(--text-main);
    font-size: var(--step-body);
    margin: 2.5rem 0 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-content :global(strong) {
    color: var(--text-main);
    font-weight: 500;
  }

  .project-content :global(a:not([class])) {
    color: var(--accent-blue);
    border-bottom: 1px solid color-mix(in oklch, var(--accent-blue) 40%, transparent);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .project-content :global(a:not([class]):hover) {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
  }

  .project-content :global(ul), .project-content :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    list-style: disc;
  }

  .project-content :global(li) { margin-bottom: 0.5rem; }

  .project-content :global(li::marker) { color: var(--accent-pink); }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: var(--radius-md);
  }

  /* Captures dans les fenêtres défilantes : pas de marge ni d'arrondi */
  .project-content :global(.scroll-content img) { margin: 0; border-radius: 0; cursor: auto !important; }
  .project-content :global(.scroll-content p),
  .project-content :global(.browser-content p) { margin: 0; }
  .project-content :global(.scrolling-mockup) { margin: 0; border: 0; border-radius: 0; }

  .project-content :global(.mockup-hint) {
    margin: 0.9rem 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-dim);
  }

  /* ───── Points clés ───── */
  .project-facts {
    max-width: 900px;
    margin: 4rem auto 0;
    padding: 0 2rem;
  }

  .outcome {
    max-width: 900px;
    margin: 4rem auto 0;
    padding: 0 2rem;
  }
  .outcome blockquote {
    font-family: var(--font-display);
    font-size: var(--step-title);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .outcome figcaption {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-muted);
  }

  .facts-title {
    font-size: var(--step-title);
    color: var(--text-main);
    margin-bottom: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  /* En-tête : fenêtre de navigateur défilante (la vraie page, pas une vignette) */
  .cover-live :global(.scrolling-mockup) { margin: 0; border: 0; border-radius: 0; }
  .cover-live :global(.fullpage-img) { width: 100%; height: auto; display: block; }
  .cover-hint {
    margin-top: 0.9rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-dim);
  }

  .project-facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .pfact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
  }

  .pfact + .pfact { padding-left: 1.5rem; border-left: 1px solid var(--line); }

  .pfact dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-title);
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .pfact dd { color: var(--text-muted); line-height: 1.5; max-width: 30ch; }

  @media (max-width: 700px) {
    .pfact + .pfact { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  }

  /* ───── Pied d'article ───── */
  .project-footer {
    max-width: 900px;
    margin: 5rem auto 0;
    padding: 0 2rem;
  }

  .next-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: border-color 0.4s ease;
  }

  .next-cta:hover { border-color: var(--line-strong); }

  .next-label {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .next-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-title);
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .next-title svg {
    color: var(--accent-pink);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .next-cta:hover .next-title svg { transform: translateX(8px); }

  /* Gouttière mobile commune à tout le site */
  @media (max-width: 480px) {
    .header-content, .project-content, .project-facts, .outcome, .project-footer, .cover-wrapper { padding-left: 1.25rem; padding-right: 1.25rem; }
  }

  /* Longueur de ligne lisible (≈ 68 caractères), le conteneur garde l'alignement */
  .project-content :global(p),
  .project-content :global(li) { max-width: 68ch; }
</style>
