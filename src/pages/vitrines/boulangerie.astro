    <footer class="foot">
      <span class="logo-text">Mie <em>&amp;</em> Lumière</span>
      <p>Boulangerie-pâtisserie artisanale · 8, place du Marché, Val-des-Blés</p>
      <p class="foot-small">Entreprise fictive. Site de démonstration conçu et développé par <a href="/">Okamilink</a>.</p>
    </footer>
  </div>
</DemoLayout>

<script>
  import { startParticles } from '../../lib/particles';

  /* ───────── Horaires ───────── */
  // minutes depuis minuit : [ouverture, fermeture] ; null = fermé
  const HOURS: Record<number, [number, number] | null> = {
    0: [420, 780], 1: null, 2: [390, 1170], 3: [390, 1170], 4: [390, 1170], 5: [390, 1170], 6: [390, 1170],
  };
  const DAYS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
  const fmt = (m: number) => { const h = Math.floor(m / 60), mi = m % 60; return mi ? `${h} h ${String(mi).padStart(2, '0')}` : `${h} h`; };
  const nowMin = () => { const d = new Date(); return d.getHours() * 60 + d.getMinutes(); };

  function nextOpening(from = new Date()): { date: Date; open: number; offset: number } {
    for (let i = 0; i < 8; i++) {
      const d = new Date(from); d.setDate(d.getDate() + i);
      const h = HOURS[d.getDay()];
      if (!h) continue;
      if (i === 0 && from.getHours() * 60 + from.getMinutes() >= h[0]) continue;
      return { date: d, open: h[0], offset: i };
    }
    return { date: from, open: 390, offset: 1 };
  }
  const dayWord = (offset: number, d: Date) => offset === 0 ? 'aujourd’hui' : offset === 1 ? 'demain' : DAYS[d.getDay()];

  function updateStatus() {
    const el = document.querySelector<HTMLElement>('[data-status]');
    const text = document.querySelector<HTMLElement>('[data-status-text]');
    if (!el || !text) return;
    const d = new Date(), h = HOURS[d.getDay()], m = nowMin();
    const isOpen = !!h && m >= h[0] && m < h[1];
    el.classList.toggle('is-open', isOpen);
    if (isOpen && h) text.textContent = `Ouvert · ferme à ${fmt(h[1])}`;
    else {
      const n = nextOpening(d);
      text.textContent = n.offset === 0 ? `Fermé · ouvre à ${fmt(n.open)}` : `Fermé · ouvre ${dayWord(n.offset, n.date)} à ${fmt(n.open)}`;
    }
    document.querySelector(`.hours tr[data-day="${d.getDay()}"]`)?.classList.add('is-today');
  }

  /* ───────── Prochaine fournée ───────── */
  const BATCHES = ['Baguette tradition', 'Croissants', 'Pain au levain', 'Baguette tradition', 'Pains au chocolat', 'Baguette tradition', 'Brioche feuilletée', 'Baguette tradition', 'Pain de seigle'];
  const INTERVAL = 45;

  function updateBatch() {
    const name = document.querySelector<HTMLElement>('[data-batch-name]');
    const eta = document.querySelector<HTMLElement>('[data-batch-eta]');
    const label = document.querySelector<HTMLElement>('[data-batch-label]');
    const ring = document.querySelector<SVGCircleElement>('[data-ring]');
    if (!name || !eta || !label || !ring) return;
    const C = 2 * Math.PI * 24;
    ring.style.strokeDasharray = `${C}`;
    const d = new Date(), h = HOURS[d.getDay()], m = nowMin();
    if (h && m >= h[0] - INTERVAL && m < h[1] - 60) {
      const k = Math.max(0, Math.floor((m - h[0]) / INTERVAL) + 1);
      const at = h[0] + k * INTERVAL;
      const left = Math.max(1, at - m);
      label.textContent = 'Prochaine fournée';
      name.textContent = BATCHES[k % BATCHES.length];
      eta.textContent = `Sortie du four dans ${left} min · ${fmt(at)}`;
      ring.style.strokeDashoffset = `${C * (left / INTERVAL)}`;
    } else {
      const n = nextOpening(d);
      label.textContent = 'Première fournée';
      name.textContent = 'Baguette tradition';
      eta.textContent = `${dayWord(n.offset, n.date).replace(/^./, (c) => c.toUpperCase())} à ${fmt(n.open)}`;
      ring.style.strokeDashoffset = `${C * 0.75}`;
    }
  }

  /* ───────── Saison ───────── */
  function updateSeason() {
    const d = new Date(), mo = d.getMonth();
    const christmas = mo === 10 || (mo === 11 && d.getDate() <= 24);
    document.querySelector<HTMLElement>('[data-season="noel"]')!.hidden = !christmas;
    document.querySelector<HTMLElement>('[data-season="flan"]')!.hidden = christmas;
    const flavors = ['vanille et fève tonka.', 'chocolat noir.', 'citron de Menton.', 'pistache de Sicile.', 'fleur d’oranger.', 'fraise et vanille.', 'abricot rôti.', 'pêche de vigne.', 'figue et miel.', 'caramel au beurre salé.', 'marron glacé.', 'vanille Bourbon.'];
    const f = document.querySelector('[data-flan-flavor]');
    if (f) f.textContent = flavors[mo];
    if (!christmas) document.querySelector<HTMLElement>('[data-product="buche"]')?.setAttribute('hidden', '');
  }

  /* ───────── Du pâton au four ───────── */
  function initBake() {
    const track = document.querySelector<HTMLElement>('[data-bake]');
    if (!track) return;
    const section = track.closest<HTMLElement>('.bake')!;
    const steps = [...track.querySelectorAll<HTMLElement>('[data-step]')];
    const timeEl = track.querySelector<HTMLElement>('[data-hud-time]')!;
    const tempEl = track.querySelector<HTMLElement>('[data-hud-temp]')!;
    const bar = track.querySelector<HTMLElement>('[data-hud-bar]')!;
    const clock = [[16, 0], [4, 30], [5, 0], [5, 45], [6, 30]];
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (a: number, b: number, v: number) => { const t = clamp((v - a) / (b - a)); return t * t * (3 - 2 * t); };
    let ticking = false;

    const render = () => {
      ticking = false;
      const r = track.getBoundingClientRect();
      const pr = clamp(-r.top / (r.height - window.innerHeight));
      const idx = Math.min(4, Math.floor(pr * 5));
      const local = pr * 5 - idx;
      steps.forEach((s, i) => s.classList.toggle('is-active', i === idx));
      const cuit = smooth(0.62, 0.78, pr);
      const heat = smooth(0.55, 0.7, pr) * (1 - smooth(0.82, 0.95, pr));
      const dawn = smooth(0.86, 0.95, pr);
      section.style.setProperty('--cuit', cuit.toFixed(3));
      section.style.setProperty('--heat', heat.toFixed(3));
      section.style.setProperty('--dawn', dawn.toFixed(3));
      section.classList.toggle('is-dawn', dawn > 0.45);
      // horloge simulée
      const [h0, m0] = clock[idx], [h1, m1] = clock[Math.min(4, idx + 1)];
      let mins = idx < 4 ? lerp(h0 * 60 + m0, (idx === 0 ? 28 * 60 + 30 : h1 * 60 + m1), local) : h0 * 60 + m0;
      mins = Math.round(mins) % (24 * 60);
      timeEl.textContent = `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
      tempEl.textContent = idx < 3 ? (idx === 2 ? 'préchauffe' : 'éteint') : idx === 3 ? `${Math.round(lerp(120, 180, Math.min(1, local * 2)))} °C` : '180 °C';
      bar.style.transform = `scaleX(${pr.toFixed(3)})`;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(render); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    render();
  }

  /* ───────── Click & collect ───────── */
  const euro = (n: number) => `${n.toFixed(2).replace('.', ',')} €`;
  const cart = new Map<string, number>();
  let pickDay = 0;
  let pickSlot = '';

  function pickupDays(): { label: string; date: Date; h: [number, number]; today: boolean }[] {
    const out: { label: string; date: Date; h: [number, number]; today: boolean }[] = [];
    const d0 = new Date();
    for (let i = 0; i < 8 && out.length < 3; i++) {
      const d = new Date(d0); d.setDate(d.getDate() + i);
      const h = HOURS[d.getDay()];
      if (!h) continue;
      if (i === 0 && nowMin() > h[1] - 90) continue;
      const label = i === 0 ? 'Aujourd’hui' : i === 1 ? 'Demain' : DAYS[d.getDay()].replace(/^./, (c) => c.toUpperCase()) + ' ' + d.getDate();
      out.push({ label, date: d, h, today: i === 0 });
    }
    return out;
  }

  function renderPickup() {
    const daysEl = document.querySelector<HTMLElement>('[data-days]');
    const slotsEl = document.querySelector<HTMLElement>('[data-slots]');
    if (!daysEl || !slotsEl) return;
    const days = pickupDays();
    if (pickDay >= days.length) pickDay = 0;
    daysEl.innerHTML = '';
    days.forEach((day, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.textContent = day.label;
      b.setAttribute('aria-pressed', String(i === pickDay));
      b.addEventListener('click', () => { pickDay = i; pickSlot = ''; renderPickup(); refresh(); });
      daysEl.append(b);
    });
    const day = days[pickDay];
    slotsEl.innerHTML = '';
    if (!day) return;
    const start = day.today ? Math.ceil((nowMin() + 60) / 30) * 30 : day.h[0] + 30;
    for (let m = Math.max(start, day.h[0] + 30); m <= day.h[1] - 30; m += 30) {
      const label = fmt(m);
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip chip-slot'; b.textContent = label;
      b.setAttribute('aria-pressed', String(label === pickSlot));
      b.addEventListener('click', () => { pickSlot = label; renderPickup(); refresh(); });
      slotsEl.append(b);
    }
  }

  function refresh() {
    let total = 0, count = 0;
    const lines = document.querySelector<HTMLElement>('[data-lines]')!;
    lines.innerHTML = '';
    document.querySelectorAll<HTMLElement>('[data-product]').forEach((el) => {
      const id = el.dataset.product!, n = cart.get(id) ?? 0;
      el.classList.toggle('in-cart', n > 0);
      el.querySelector('[data-n]')!.textContent = String(n);
      if (n > 0) {
        const price = Number(el.dataset.price);
        total += price * n; count += n;
        const li = document.createElement('li');
        li.innerHTML = `<span>${n} × ${el.dataset.name}</span><span>${euro(price * n)}</span>`;
        lines.append(li);
      }
    });
    if (!count) lines.innerHTML = '<li class="basket-empty">Votre panier est vide. Ajoutez un pain, on s’occupe du reste.</li>';
    document.querySelector('[data-total]')!.textContent = euro(total);
    (document.querySelector('[data-submit]') as HTMLButtonElement).disabled = !count || !pickSlot;
  }

  function initOrder() {
    document.querySelectorAll<HTMLElement>('[data-product]').forEach((el) => {
      const id = el.dataset.product!;
      const change = (delta: number) => { cart.set(id, Math.max(0, Math.min(30, (cart.get(id) ?? 0) + delta))); refresh(); };
      el.querySelector('[data-add]')?.addEventListener('click', () => { change(1); el.querySelector<HTMLButtonElement>('[data-plus]')?.focus(); });
      el.querySelector('[data-plus]')?.addEventListener('click', () => change(1));
      el.querySelector('[data-minus]')?.addEventListener('click', () => change(-1));
    });
    document.querySelectorAll<HTMLElement>('[data-preselect]').forEach((a) => a.addEventListener('click', () => {
      const id = a.dataset.preselect!;
      if (!cart.get(id)) { cart.set(id, 1); refresh(); }
    }));

    const form = document.querySelector<HTMLElement>('[data-basket]')!;
    const ticket = document.querySelector<HTMLElement>('[data-ticket]')!;
    document.querySelector('[data-submit]')?.addEventListener('click', () => {
      const days = pickupDays(), day = days[pickDay];
      const name = (document.querySelector('[data-firstname]') as HTMLInputElement).value.trim();
      ticket.querySelector('[data-ticket-num]')!.textContent = `ML-${Math.floor(1000 + Math.random() * 9000)}`;
      ticket.querySelector('[data-ticket-when]')!.textContent = `${name ? name + ', votre' : 'Votre'} commande sera prête ${day.label.toLowerCase()} à ${pickSlot}.`;
      const tl = ticket.querySelector<HTMLElement>('[data-ticket-lines]')!;
      tl.innerHTML = document.querySelector<HTMLElement>('[data-lines]')!.innerHTML;
      ticket.querySelector('[data-ticket-total]')!.textContent = `Total ${document.querySelector('[data-total]')!.textContent} · à régler au comptoir`;
      form.hidden = true; ticket.hidden = false; ticket.focus();
    });
    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      cart.clear(); pickSlot = ''; ticket.hidden = true; form.hidden = false; renderPickup(); refresh();
    });
    renderPickup(); refresh();
  }

  /* ───────── Navigation ───────── */
  const nav = document.getElementById('ml-nav');
  const onNav = () => nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onNav, { passive: true });
  onNav();

  updateStatus(); updateBatch(); updateSeason(); initBake(); initOrder();
  setInterval(() => { updateStatus(); updateBatch(); }, 30_000);

  const dust = document.querySelector<HTMLCanvasElement>('.hero-dust');
  if (dust) startParticles(dust, { color: [255, 244, 222], density: 70, size: [0.6, 2.2], vy: [-6, 4], vx: [4, 14], spawn: [0, 0.65], flicker: 0.5 });
</script>

