          </div>

          <div class="bake-visual">
            <div class="bake-frame">
              <Image src={p('croissant-cru')} alt="Croissants crus sur une plaque, avant la cuisson" widths={[640, 1024, 1536]} sizes="(max-width: 900px) 92vw, 50vw" class="bake-img" />
