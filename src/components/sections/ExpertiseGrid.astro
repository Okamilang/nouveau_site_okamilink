---
const expertises = [
  {
    title: "Ingénierie Front-End",
    description: "Développement de plateformes ultra-performantes et interactives, exploitant les derniers standards HTML5/CSS pour une fluidité absolue.",
    icon: "⚡",
    rawData: "{ \"module\": \"FE_Core\", \"perf_score\": 99, \"threads\": 8, \"status\": \"OPTIMIZED\" }"
  },
  {
    title: "Écosystèmes Modernes",
    description: "Conception d'architectures robustes et évolutives, pensées pour des cas d'usage complexes sans jamais sacrifier la vitesse de chargement.",
    icon: "🏗️",
    rawData: "{ \"arch\": \"Microservices\", \"scale\": \"Auto\", \"latency\": \"<15ms\", \"uptime\": \"99.99%\" }"
  },
  {
    title: "Design Interactif & UI",
    description: "Intégration de micro-animations, de transitions natives et de designs adaptatifs (CSS Subgrid, Container Queries) pour une interface vivante.",
    icon: "✨",
    rawData: "{ \"engine\": \"WebGL/CSS3\", \"fps\": 60, \"motion\": \"Fluid\", \"glassmorphism\": true }"
  },
  {
    title: "Optimisation & Accessibilité",
    description: "Un code sémantique irréprochable, pensé pour le SEO technique et garanti 100% accessible.",
    icon: "👁️",
    rawData: "{ \"a11y_score\": 100, \"seo\": \"Technical\", \"semantic\": \"HTML5_Strict\", \"contrast\": \"AAA\" }"
  }
];
---

<section class="expertise scroll-reveal">
  <div class="section-visual" aria-hidden="true">
    <div class="glow-orb" style="width: 500px; height: 500px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-pink) 60%, transparent) 0%, transparent 70%); top: -20%; right: -10%;"></div>
    <div class="glow-orb" style="width: 700px; height: 700px; background: radial-gradient(circle, color-mix(in oklch, var(--accent-purple) 50%, transparent) 0%, transparent 70%); bottom: -20%; left: -20%; animation-delay: -3s;"></div>
  </div>

  <div class="expertise-header">
    <h2>Nos Domaines d'<span class="text-gradient">Expertise</span></h2>
    <p>Une maîtrise technique totale pour des résultats exceptionnels.</p>
  </div>

  <div class="expertise-grid">
    {expertises.map((item) => (
      <article class="expertise-card tilt-card magnetic">
        <div class="glare"></div>
        <div class="card-icon">{item.icon}</div>
        <h3 class="card-title">{item.title}</h3>
        <p class="card-desc">{item.description}</p>
        <div class="card-raw-data only-console">
          <pre><code>{item.rawData}</code></pre>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.tilt-card');
    
    // Désactiver sur mobile car les events touch sont différents et la 3D moins performante
    if (window.matchMedia('(pointer: coarse)').matches) return;

    cards.forEach(card => {
      const htmlCard = card as HTMLElement;
      
      htmlCard.addEventListener('mousemove', (e) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Position du Spotlight
        htmlCard.style.setProperty('--x', `${x}px`);
        htmlCard.style.setProperty('--y', `${y}px`);
        
        // Calcul du Tilt 3D
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -10; // Max 10 degrés
        const rotateY = ((x - centerX) / centerX) * 10;
        
        htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });
      
      htmlCard.addEventListener('mouseleave', () => {
        htmlCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    });
  });
</script>

<style>
  .expertise {
    position: relative;
    padding: 8rem 2rem;
    max-width: var(--container-width);
    margin: 0 auto;
    /* overflow: hidden a été retiré pour permettre au halo de déborder naturellement */
  }

  .section-visual {
    position: absolute;
    inset: -50%; /* Permet aux orbes de déborder très loin sans être coupées */
    pointer-events: none;
    z-index: 0;
  }

  .expertise-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }

  .expertise-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .expertise-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* Bento Grid Layout */
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .expertise-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(280px, auto);
    }
    
    /* Asymmetric Bento Grid Items */
    .expertise-card:nth-child(1) {
      grid-column: span 2;
    }
    
    .expertise-card:nth-child(4) {
      grid-column: span 2;
    }
  }

  /* Retrait des anciennes @container queries qui causaient le retour à la ligne forcé */

  .expertise-card {
    background: var(--bg-surface);
    border: 1px solid color-mix(in oklch, var(--text-main) 5%, transparent);
    border-radius: 1.5rem;
    padding: 2rem;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 1rem;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Hover glow effect via border-image / pseudo element */
  .expertise-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    padding: 1px;
    background: var(--holographic-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 10;
    pointer-events: none;
  }

  .glare {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    pointer-events: none;
    background: radial-gradient(circle 300px at var(--x, 50%) var(--y, 50%), color-mix(in oklch, var(--accent-purple) 15%, transparent) 0%, transparent 80%);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 5;
  }

  .expertise-card:hover {
    box-shadow: 0 30px 60px rgba(0,0,0,0.4), var(--glow-shadow);
    /* Transform géré par le JS en mode desktop */
  }

  .expertise-card:hover::before, .expertise-card:hover .glare {
    opacity: 1;
  }

  .card-icon {
    font-size: 2.5rem;
    background: color-mix(in oklch, var(--bg-color) 80%, transparent);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklch, var(--accent-blue) 30%, transparent);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .card-raw-data {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--data-tech);
    background: color-mix(in oklch, var(--bg-color) 80%, transparent);
    padding: 0;
    border-radius: 0.5rem;
    border-left: 2px solid var(--data-action);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease, padding 0.3s ease, margin-top 0.3s ease;
    margin-top: 0;
  }

  .card-raw-data pre {
    margin: 0;
    white-space: pre-wrap;
  }

  :global(html[data-experience="console"]) .expertise-card:hover .card-raw-data {
    max-height: 150px;
    opacity: 1;
    padding: 1rem;
    margin-top: 0.5rem;
  }
</style>
