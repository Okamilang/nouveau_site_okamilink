---
---

<div class="taskbar">
  <button id="start-button" class="start-button">
    <span class="start-icon">🐺</span>
    OKAMILINK
  </button>
  
  <div class="taskbar-windows" id="taskbar-windows">
    <!-- Les fenêtres ouvertes apparaîtront ici -->
  </div>
  
  <div class="taskbar-system">
    <div id="os-clock" class="os-clock">00:00</div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const clock = document.getElementById('os-clock');
    if (!clock) return;

    const updateClock = () => {
      const now = new Date();
      clock.textContent = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    };

    updateClock();
    setInterval(updateClock, 1000);
  });
</script>

<style>
  .taskbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 38px;
    background: rgba(5, 8, 12, 0.95);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--cyber-cyan);
    box-shadow: 0 2px 15px rgba(0, 243, 255, 0.2);
    display: flex;
    align-items: center;
    padding: 0 10px;
    z-index: 9000;
    user-select: none;
  }

  .start-button {
    height: 100%;
    padding: 0 20px;
    background: transparent;
    border: none;
    border-right: 1px solid rgba(0, 243, 255, 0.3);
    color: var(--cyber-cyan);
    font-family: var(--font-mono);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .start-button:hover {
    background: rgba(0, 243, 255, 0.15);
    color: white;
    text-shadow: 0 0 8px var(--cyber-cyan);
  }

  .taskbar-windows {
    flex-grow: 1;
    display: flex;
    gap: 8px;
    margin-left: 15px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .taskbar-windows::-webkit-scrollbar {
    display: none;
  }

  /* Styles pour les items injectés en JS */
  :global(.taskbar-item) {
    height: 28px;
    padding: 0 15px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(0, 243, 255, 0.2);
    border-radius: 4px;
    color: white;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: all 0.2s;
  }

  :global(.taskbar-item:hover) {
    background: rgba(0, 243, 255, 0.15);
    border-color: var(--cyber-cyan);
  }

  :global(.taskbar-item.active) {
    background: rgba(0, 243, 255, 0.2);
    border-color: var(--cyber-cyan);
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
  }

  .taskbar-system {
    display: flex;
    align-items: center;
    padding-left: 15px;
    border-left: 1px solid rgba(0, 243, 255, 0.3);
    height: 60%;
  }

  .os-clock {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--cyber-cyan);
    text-shadow: 0 0 8px var(--cyber-cyan);
    font-weight: bold;
  }
</style>
