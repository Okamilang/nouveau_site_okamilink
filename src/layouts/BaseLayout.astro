---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import ConstructionGatekeeper from '../components/common/ConstructionGatekeeper.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Okamilink - Agence de développement web premium." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- View Transitions API support in Astro -->
    <ViewTransitions />
  </head>
  <body>
    <ConstructionGatekeeper />
    <NoiseOverlay />
    <CustomCursor />
    <Navbar />
    <main style="padding-top: 100px;">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-top: 80px; /* Compense la navbar fixe */
    min-height: calc(100vh - 80px);
  }
</style>
