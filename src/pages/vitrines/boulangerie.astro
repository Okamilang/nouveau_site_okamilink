          <rect width="600" height="440" fill="#efe4d2"/>
          <path d="M-20 360 C 120 300, 200 420, 330 350 S 520 260, 640 300" fill="none" stroke="#c9d3cf" stroke-width="38" stroke-linecap="round"/>
          <ellipse cx="470" cy="120" rx="90" ry="60" fill="#dfe3c8"/>
          <g fill="none" stroke="#fbf7f0" stroke-linecap="round">
            <path d="M0 210 H600" stroke-width="22"/>
            <path d="M250 0 V440" stroke-width="22"/>
            <path d="M80 0 L 190 440" stroke-width="12"/>
