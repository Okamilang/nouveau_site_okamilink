---
interface Props {
  height?: string;
}
const { height = "600px" } = Astro.props;
---

<div class="scrolling-mockup" style={`height: ${height};`}>
  <div class="scroll-content">
    <slot />
  </div>
</div>

<style>
  .scrolling-mockup {
    width: 100%;
    border-radius: 8px;
    background: var(--bg-surface);
    border: 1px solid color-mix(in oklch, var(--text-main) 10%, transparent);
    overflow: hidden;
    position: relative;
    margin: 2rem 0;
  }

  .scroll-content {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    
    /* Custom ultra-thin scrollbar */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--text-main) 30%, transparent) transparent;
  }

  .scroll-content::-webkit-scrollbar {
    width: 4px;
  }

  .scroll-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .scroll-content::-webkit-scrollbar-thumb {
    background-color: color-mix(in oklch, var(--text-main) 30%, transparent);
    border-radius: 4px;
  }

  .scroll-content :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
