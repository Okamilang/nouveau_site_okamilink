---
// TerminalToast.astro
---

<div id="terminal-toast-container" class="toast-container only-console" aria-live="polite"></div>

<script>
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('terminal-toast-container');

    (window as any).pushToast = (message: string, status: 'ok' | 'error' | 'neutral' = 'neutral') => {
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `terminal-toast toast-${status}`;

      const safeMessage = message.replace(/</g, "&lt;").replace(/>/g, "&gt;");
      const time = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

      let statusBrackets = '';
      if (status === 'ok') statusBrackets = '<span class="status-ok">[OK]</span>';
      else if (status === 'error') statusBrackets = '<span class="status-error">[ERR]</span>';
      else statusBrackets = '<span class="status-neutral">[...]</span>';

      toast.innerHTML = `<span class="toast-time">${time}</span><span class="toast-msg">${safeMessage}</span>${statusBrackets}`;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.add('show');
      });

      setTimeout(() => {
        toast.classList.remove('show');
        toast.addEventListener('transitionend', () => {
          toast.remove();
        });
      }, 5000);
    };

    if (document.documentElement.getAttribute('data-experience') === 'console') {
      const welcome = () => (window as any).pushToast('[SYS]: System initialized. Awaiting commands...', 'ok');
      const boot = document.getElementById('os-boot-sequence');
      const booting = boot && boot.style.display !== 'none' && sessionStorage.getItem('okamilink_os_booted') !== 'true';

      if (booting) {
        // On attend la fin de la séquence de boot avant d'afficher le message
        const watcher = setInterval(() => {
          if (!boot || boot.style.display === 'none') {
            clearInterval(watcher);
            setTimeout(welcome, 600);
          }
        }, 300);
      } else {
        setTimeout(welcome, 1000);
      }
    }
  });
</script>

<style>
  .toast-container {
    position: fixed;
    top: 3.25rem;
    right: 1rem;
    z-index: 9500;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    pointer-events: none;
    max-width: 420px;
    width: 100%;
  }

  :global(.terminal-toast) {
    background: rgba(4, 7, 11, 0.92);
    border: 1px solid rgba(0, 243, 255, 0.25);
    border-left: 2px solid var(--data-tech);
    padding: 0.6rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 16px rgba(0, 243, 255, 0.08);
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  :global(.terminal-toast.show) {
    opacity: 1;
    transform: translateX(0);
  }

  :global(.toast-ok) { border-left-color: var(--data-action); }
  :global(.toast-error) { border-left-color: oklch(0.65 0.22 25); }

  :global(.toast-time) {
    flex-shrink: 0;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.35);
  }

  :global(.toast-msg) {
    flex-grow: 1;
    word-break: break-word;
  }

  :global(.status-ok) {
    color: var(--data-action);
    font-weight: 700;
    flex-shrink: 0;
    text-shadow: 0 0 6px rgba(0, 255, 102, 0.5);
  }

  :global(.status-error) {
    color: oklch(0.7 0.22 25);
    font-weight: 700;
    flex-shrink: 0;
  }

  :global(.status-neutral) {
    color: var(--data-tech);
    flex-shrink: 0;
  }
</style>
