            <circle r="5" fill="#fbf7f0"/>
          </g>
          <g transform="translate(274 178)">
            <rect x="0" y="-22" width="136" height="32" rx="16" fill="#2b1d13"/>
            <text x="68" y="-1" text-anchor="middle" font-family="Fraunces Variable, serif" font-size="15" fill="#fbf7f0">Mie &amp; Lumière</text>
