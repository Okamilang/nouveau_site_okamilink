---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const programProjects = projects.filter(p => p.data.category === 'program');
  return programProjects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={`${project.data.title} - Okamilink`}>
  <article class="project-article">
    <header class="project-header">
      <div class="header-content">
        <h1 class="title" transition:name={`title-${project.slug}`}>{project.data.title}</h1>
        <div class="meta">
          <span class="client">Client: {project.data.client}</span>
          <span class="separator">•</span>
          <span class="date">{project.data.date.getFullYear()}</span>
        </div>
        <div class="tags">
          {project.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        
        {project.data.url && (
          <div class="action-buttons">
            <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="primary-btn access-btn">
              <span class="btn-text">Accéder au programme</span>
              <div class="btn-glow"></div>
            </a>
          </div>
        )}
      </div>
      
      {project.data.coverImage && (
        <div class="cover-wrapper">
          <Image 
            src={project.data.coverImage} 
            alt={project.data.title}
            width={1600}
            height={900}
            class="cover-image"
            transition:name={`cover-${project.slug}`}
          />
        </div>
      )}
    </header>

    <div class="project-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-article {
    padding-bottom: 8rem;
  }

  .project-header {
    padding-top: 4rem;
  }

  .header-content {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem 4rem;
    text-align: center;
  }

  .title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .meta {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    align-items: center;
  }

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .access-btn {
    padding: 1rem 2rem;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .tag {
    font-size: 0.85rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--text-main) 10%, transparent);
    color: var(--text-main);
  }

  .cover-wrapper {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    border-radius: 24px;
    overflow: hidden;
    padding: 0 1rem;
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
  }

  .project-content {
    max-width: 900px;
    margin: 4rem auto 0;
    padding: 0 2rem;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .project-content :global(h2) {
    color: var(--text-main);
    font-size: 2rem;
    margin: 3rem 0 1.5rem;
  }

  .project-content :global(h3) {
    color: var(--text-main);
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: 12px;
  }
</style>
