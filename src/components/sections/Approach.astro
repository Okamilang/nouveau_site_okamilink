---
/**
 * Approche — ce que je fais, et comment.
 * Pièce calme après la galerie : du texte, des filets, aucun effet au survol
 * (rien ici n'est cliquable, donc rien ne doit le laisser croire).
 */
const services = [
  { title: 'Sites & e-commerce sur-mesure', text: 'Vitrines, boutiques B2B et B2C, de la maquette à la mise en ligne.' },
  { title: 'Odoo & outils métier', text: 'Boutique, devis, factures et stock reliés au même ERP, avec une interface à votre image.' },
  { title: 'Applications & outils', text: 'Applications Android et outils web quand un site ne suffit pas.' },
  { title: 'Performance, SEO & accessibilité', text: 'Pages légères, structure lisible par Google et par les lecteurs d’écran.' },
];

const method = [
  { title: 'Un seul interlocuteur', text: 'Vous parlez directement à la personne qui écrit le code. Pas d’intermédiaire, des allers-retours rapides.' },
  { title: 'Du code, pas un thème', text: 'Chaque projet est écrit pour vous, documenté, et vous en restez propriétaire.' },
  { title: 'Mesuré avant la mise en ligne', text: 'Vitesse et accessibilité contrôlées avec Lighthouse et les critères WCAG avant chaque livraison.' },
];
---

<section class="approach" id="approche" aria-labelledby="approach-title">
  <div class="wrap">
    <header class="approach-header">
      <p class="section-label">Approche</p>
      <h2 class="section-title" id="approach-title">Ce que je fais, et comment.</h2>
    </header>

    <h3 class="sub">Services</h3>
    <ul class="services">
      {services.map((s) => (
        <li class="service">
          <span class="item-title">{s.title}</span>
          <span class="item-text">{s.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Changement de pièce : une bande plus sombre, pleine largeur -->
  <div class="method-band">
    <div class="wrap">
      <h3 class="sub">Méthode</h3>
      <ol class="method">
        {method.map((m) => (
          <li class="step">
            <span class="step-title">{m.title}</span>
            <span class="item-text">{m.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .approach { padding-top: clamp(6rem, 12vw, 9rem); }

  .wrap {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .approach-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sub {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--line-strong);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .item-title,
  .step-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
    letter-spacing: -0.005em;
    color: var(--text-main);
  }

  .item-text {
    color: var(--text-muted);
    font-size: var(--step-body);
    line-height: 1.65;
    max-width: 46ch;
  }

  .method-band {
    margin-top: clamp(5rem, 10vw, 7rem);
    padding: clamp(3.5rem, 7vw, 5rem) 0;
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--line-strong);
  }


  @media (max-width: 860px) {
    .services, .method { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .wrap { padding: 0 1.25rem; }
  }
</style>
