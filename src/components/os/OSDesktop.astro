---
import BootSequence from './BootSequence.astro';
import Taskbar from './Taskbar.astro';
import WindowTemplate from './WindowTemplate.astro';

import Hero from '../sections/Hero.astro';
import ExpertiseGrid from '../sections/ExpertiseGrid.astro';
import Philosophy from '../sections/Philosophy.astro';
import ContactTerminal from '../common/ContactTerminal.astro';

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const renderedProjects = await Promise.all(projects.map(async (p, i) => {
  const { Content } = await p.render();
  return { p, Content, i };
}));
---

<div id="os-environment" class="os-environment" aria-hidden="true">
  <BootSequence />
  
  <div class="desktop-area" id="desktop-area">
    <!-- Dock (Bottom) -->
    <div class="os-dock">
      <div class="desktop-icon dock-item" data-target="win-about">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="icon-label">A_Propos</span>
      </div>
      <div class="desktop-icon dock-item" data-target="win-skills">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
        <span class="icon-label">Competences</span>
      </div>
      <div class="desktop-icon dock-item" data-target="win-philo">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>
        <span class="icon-label">Philosophie</span>
      </div>
      <div class="desktop-icon dock-item" data-target="win-projects">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
        <span class="icon-label">Projets</span>
      </div>
      <div class="desktop-icon dock-item" data-target="win-terminal">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
        <span class="icon-label">Terminal</span>
      </div>
      <div class="desktop-icon dock-item" data-target="win-wallpaper">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
        <span class="icon-label">Affichage</span>
      </div>
      <div class="desktop-icon dock-item" id="btn-exit-os">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud" style="color: var(--cyber-magenta);"><path d="M12 2v10"/><path d="M18.4 6.6a9 9 0 1 1-12.77.04"/></svg>
        <span class="icon-label">Quitter</span>
      </div>
    </div>

    <!-- Windows Container -->
    <div id="windows-container">
      <WindowTemplate id="win-projects" title="Projets/" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'/></svg>" x="10%" y="20%" width="600px" height="400px">
        <div class="folder-content" style="position: relative; width: 100%; height: 100%;">
          <div class="desktop-icon" data-target="win-projects-websites" style="position: absolute; left: 20px; top: 20px; pointer-events: auto;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
            <span class="icon-label">Sites_Web/</span>
          </div>
          <div class="desktop-icon" data-target="win-projects-programs" style="position: absolute; left: 160px; top: 20px; pointer-events: auto;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <span class="icon-label">Programmes/</span>
          </div>
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-projects-websites" title="Sites_Web/" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'/></svg>" x="15%" y="25%" width="600px" height="400px">
        <div class="folder-content" style="position: relative; width: 100%; height: 100%;">
          {projects.filter(p => p.data.category === 'website').map((p, index) => {
            const col = index % 5;
            const row = Math.floor(index / 5);
            const left = 20 + col * 140;
            const top = 20 + row * 120;
            
            return (
              <div class="desktop-icon" data-target={`win-proj-${p.slug}`} style={`position: absolute; left: ${left}px; top: ${top}px; pointer-events: auto;`}>
                {p.data.osIcon ? (
                  <img src={p.data.osIcon} alt="" draggable="false" style="width: 2.5rem; height: 2.5rem; object-fit: contain; user-drag: none; -webkit-user-drag: none;" />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                )}
                <span class="icon-label">{p.data.title}.exe</span>
              </div>
            );
          })}
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-projects-programs" title="Programmes/" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z'/><path d='M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z'/></svg>" x="20%" y="30%" width="600px" height="400px">
        <div class="folder-content" style="position: relative; width: 100%; height: 100%;">
          {projects.filter(p => p.data.category === 'program').length === 0 ? (
            <div style="position: absolute; top: 20px; left: 20px; color: var(--cyber-cyan); font-family: var(--font-mono);">
              > Aucun programme trouvé dans ce répertoire.
            </div>
          ) : (
            projects.filter(p => p.data.category === 'program').map((p, index) => {
              const col = index % 5;
              const row = Math.floor(index / 5);
              const left = 20 + col * 140;
              const top = 20 + row * 120;
              
              return (
                <div class="desktop-icon" data-target={`win-proj-${p.slug}`} style={`position: absolute; left: ${left}px; top: ${top}px; pointer-events: auto;`}>
                  {p.data.osIcon ? (
                    <img src={p.data.osIcon} alt="" draggable="false" style="width: 2.5rem; height: 2.5rem; object-fit: contain; user-drag: none; -webkit-user-drag: none;" />
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon-hud"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  )}
                  <span class="icon-label">{p.data.title}.exe</span>
                </div>
              );
            })
          )}
        </div>
      </WindowTemplate>

      {renderedProjects.map(({ p, Content, i }) => (
        <>
          <WindowTemplate id={`win-proj-${p.slug}`} title={`${p.data.title}.exe`} icon={p.data.osIcon ? `<img src="${p.data.osIcon}" style="width:1.2em; height:1.2em; vertical-align:middle; object-fit:contain;"/>` : "<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z'/><polyline points='14 2 14 8 20 8'/></svg>"} x={`${15 + i*5}%`} y={`${25 + i*5}%`} width="800px" height="600px">
            <div class="os-content-wrapper" style="padding: 30px;">
              <h1 style="margin-bottom: 1rem; color: var(--text-main); font-size: 2rem;">{p.data.title}</h1>
              <p style="color: var(--text-muted); margin-bottom: 2rem;">{p.data.description}</p>
              <div class="project-markdown">
                <Content />
              </div>
            </div>
          </WindowTemplate>

          {p.data.url && p.data.category === 'website' && (
            <WindowTemplate 
              id={`win-mobile-${p.slug}`} 
              title={`Mobile - ${p.data.title}`} 
              icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect width='14' height='20' x='5' y='2' rx='2' ry='2'/><path d='M12 18h.01'/></svg>" 
              x={`${40 + i*5}%`} 
              y={`${10 + i*5}%`} 
              width="395px" 
              height="800px"
            >
              <div style="width: calc(100% + 40px); height: calc(100% + 40px); margin: -20px; background: black; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 120px; height: 25px; background: black; border-bottom-left-radius: 15px; border-bottom-right-radius: 15px; z-index: 10;"></div>
                <iframe src={p.data.url} title={`Mobile ${p.data.title}`} style="width: 100%; height: 100%; border: none;"></iframe>
              </div>
            </WindowTemplate>
          )}
        </>
      ))}

      <WindowTemplate id="win-about" title="A_Propos.exe" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>" x="5%" y="5%" width="800px" height="500px">
        <div class="os-content-wrapper">
          <Hero />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-skills" title="Competences.exe" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect width='16' height='16' x='4' y='4' rx='2'/><rect width='6' height='6' x='9' y='9' rx='1'/><path d='M15 2v2'/><path d='M15 20v2'/><path d='M2 15h2'/><path d='M2 9h2'/><path d='M20 15h2'/><path d='M20 9h2'/><path d='M9 2v2'/><path d='M9 20v2'/></svg>" x="15%" y="15%" width="900px" height="600px">
        <div class="os-content-wrapper">
          <ExpertiseGrid />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-philo" title="Philosophie.txt" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z'/><path d='M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z'/></svg>" x="25%" y="10%" width="700px" height="600px">
        <div class="os-content-wrapper" style="padding: 20px;">
          <Philosophy />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-terminal" title="Contact.sh" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='4 17 10 11 4 5'/><line x1='12' x2='20' y1='19' y2='19'/></svg>" x="30%" y="30%" width="650px" height="450px">
        <div class="terminal-content">
          <ContactTerminal />
        </div>
      </WindowTemplate>

      <WindowTemplate id="win-wallpaper" title="Affichage.exe" icon="<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='14' x='2' y='3' rx='2'/><line x1='8' x2='16' y1='21' y2='21'/><line x1='12' x2='12' y1='17' y2='21'/></svg>" x="20%" y="20%" width="650px" height="450px">
        <div class="os-content-wrapper" style="padding: 25px;">
          <h2 style="color: var(--text-main); font-family: var(--font-mono); margin-bottom: 20px; font-size: 1.2rem;">> Choisir_Fond_Ecran.sh</h2>
          <div class="wallpaper-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
            {[
              { id: 'wp1', name: 'Fond 1', url: '/os-backgrounds/fond1.png' },
              { id: 'wp2', name: 'Fond 2', url: '/os-backgrounds/fond2.png' },
              { id: 'wp3', name: 'Fond 3', url: '/os-backgrounds/fond3.png' },
              { id: 'wp4', name: 'Fond 4', url: '/os-backgrounds/fond4.png' },
              { id: 'wp5', name: 'Fond 5', url: '/os-backgrounds/fond5.png' }
            ].map(wp => (
              <div 
                class="wallpaper-btn" 
                data-bg={wp.url}
                style="cursor: pointer; border-radius: 8px; overflow: hidden; border: 2px solid transparent; transition: all 0.2s; aspect-ratio: 16/9; position: relative;"
                onmouseover="this.style.borderColor='var(--data-action)'; this.style.transform='scale(1.05)';"
                onmouseout="this.style.borderColor='transparent'; this.style.transform='scale(1)';"
              >
                <img src={wp.url} alt={wp.name} style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" />
                <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.7); color: white; padding: 4px; font-size: 0.75rem; text-align: center; font-family: var(--font-mono);">
                  {wp.name}
                </div>
              </div>
            ))}
          </div>
        </div>
      </WindowTemplate>
    </div>
  </div>

  <Taskbar />

  <!-- Context Menu -->
  <div id="os-context-menu" class="context-menu" style="display: none;">
    <ul id="context-menu-list"></ul>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    if (document.documentElement.getAttribute('data-experience') !== 'console') return;

    const desktopArea = document.getElementById('desktop-area');
    const taskbarWindows = document.getElementById('taskbar-windows');
    let highestZIndex = 100;

    // Window Management Logic
    const windows = document.querySelectorAll('.os-window') as NodeListOf<HTMLElement>;
    const icons = document.querySelectorAll('.desktop-icon') as NodeListOf<HTMLElement>;
    const taskbarItems = new Map<string, HTMLElement>();

    const bringToFront = (win: HTMLElement) => {
      highestZIndex++;
      win.style.zIndex = highestZIndex.toString();
      
      // Update taskbar active state
      document.querySelectorAll('.taskbar-item').forEach(item => item.classList.remove('active'));
      const tbItem = taskbarItems.get(win.id);
      if (tbItem) tbItem.classList.add('active');
    };

    const toggleWindow = (winId: string) => {
      const win = document.getElementById(winId);
      if (!win) return;

      if (!win.classList.contains('open')) {
        // Open it
        win.classList.add('open');
        win.style.display = 'flex';
        bringToFront(win);
        
        // Add to taskbar if not exists
        if (!taskbarItems.has(winId)) {
          const tbItem = document.createElement('div');
          tbItem.className = 'taskbar-item active';
          const title = win.querySelector('.window-title')?.textContent || 'Window';
          tbItem.textContent = title;
          tbItem.onclick = () => {
            if (win.style.display === 'none') {
              win.style.display = 'flex';
              bringToFront(win);
            } else if (win.style.zIndex === highestZIndex.toString()) {
              win.style.display = 'none';
              tbItem.classList.remove('active');
            } else {
              bringToFront(win);
            }
          };
          taskbarWindows?.appendChild(tbItem);
          taskbarItems.set(winId, tbItem);
        }
      } else if (win.style.display === 'none') {
        // Restore from minimized
        win.style.display = 'flex';
        bringToFront(win);
      } else {
        // Already open and visible, just focus
        bringToFront(win);
      }
    };

    (window as any).openOSWindow = toggleWindow;

    // Desktop & Folder icons drag & double-click logic
    icons.forEach(icon => {
      let isDraggingIcon = false;
      let hasMoved = false;
      let startX = 0, startY = 0;
      let currentX = 0, currentY = 0;
      let initialX = 0, initialY = 0;

      // Make sure the icon has a relative positioning context if it isn't absolute
      if (window.getComputedStyle(icon).position === 'static') {
        icon.style.position = 'relative';
      }

      const onMouseMove = (e: MouseEvent) => {
        if (!isDraggingIcon) return;
        e.preventDefault();
        
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
          hasMoved = true;
        }

        currentX = initialX + dx;
        currentY = initialY + dy;
        icon.style.transform = `translate(${currentX}px, ${currentY}px)`;
      };

      const onMouseUp = () => {
        if (isDraggingIcon) {
          isDraggingIcon = false;
          icon.style.zIndex = '';
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }
      };

      icon.addEventListener('mousedown', (e: MouseEvent) => {
        // Ne pas drag si l'icône est dans le dock (on vérifie s'il a la classe dock-item)
        if (icon.classList.contains('dock-item')) return;

        isDraggingIcon = true;
        hasMoved = false;
        startX = e.clientX;
        startY = e.clientY;
        initialX = currentX;
        initialY = currentY;
        icon.style.zIndex = '50';
        
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });

      icon.addEventListener('click', (e) => {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
        } else if (icon.classList.contains('dock-item')) {
          // Les éléments du dock s'ouvrent en un seul clic
          const target = icon.getAttribute('data-target');
          if (target) toggleWindow(target);
        }
      });

      icon.addEventListener('dblclick', (e) => {
        if (hasMoved) return;
        // Le double clic reste pour les éventuelles icônes de bureau, mais le dock l'ignore
        if (!icon.classList.contains('dock-item')) {
          const target = icon.getAttribute('data-target');
          if (target) toggleWindow(target);
        }
      });
      
      // Fallback for touch devices
      icon.addEventListener('touchstart', (e: TouchEvent) => {
        if (hasMoved) return;
        const target = icon.getAttribute('data-target');
        if (target) toggleWindow(target);
      });
    });

    // Exit OS Logic
    const exitBtn = document.getElementById('btn-exit-os');
    if (exitBtn) {
      const exitOS = (e: Event) => {
        e.preventDefault();
        document.documentElement.setAttribute('data-experience', 'vitrine');
        localStorage.setItem('okamilink_experience', 'vitrine');
      };
      
      // Le bouton quitter s'active au clic simple dans le dock
      exitBtn.addEventListener('click', exitOS);
      
      // Use touchstart with a small delay logic to simulate double tap, or just keep touchstart for mobile simplicity.
      // But to be consistent, we'll listen for a double-tap pattern.
      let lastTap = 0;
      exitBtn.addEventListener('touchstart', (e: TouchEvent) => {
        const currentTime = new Date().getTime();
        const tapLength = currentTime - lastTap;
        if (tapLength < 500 && tapLength > 0) {
          exitOS(e);
        }
        lastTap = currentTime;
      });
    }

    // Mobile launchers from within projects
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const launcher = target.closest('.os-mobile-launcher');
      if (launcher) {
        const winId = launcher.getAttribute('data-target');
        if (winId) toggleWindow(winId);
      }
    });

    // Wallpaper Logic
    const osEnv = document.getElementById('os-environment');
    if (osEnv) {
      const savedWallpaper = localStorage.getItem('os-wallpaper');
      if (savedWallpaper) {
        osEnv.style.backgroundImage = `linear-gradient(rgba(5, 5, 10, 0.2), rgba(5, 5, 10, 0.4)), url('${savedWallpaper}')`;
      } else {
        osEnv.style.backgroundImage = `linear-gradient(rgba(5, 5, 10, 0.2), rgba(5, 5, 10, 0.4)), url('/os-backgrounds/fond1.png')`;
      }
    }

    const wallpaperBtns = document.querySelectorAll('.wallpaper-btn');
    wallpaperBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const bgUrl = btn.getAttribute('data-bg');
        if (bgUrl && osEnv) {
          osEnv.style.backgroundImage = `linear-gradient(rgba(5, 5, 10, 0.2), rgba(5, 5, 10, 0.4)), url('${bgUrl}')`;
          localStorage.setItem('os-wallpaper', bgUrl);
        }
      });
    });

    // Window Controls
    windows.forEach(win => {
      win.addEventListener('mousedown', () => bringToFront(win));

      const minimizeBtn = win.querySelector('.win-btn.minimize') as HTMLElement | null;
      const maximizeBtn = win.querySelector('.win-btn.maximize') as HTMLElement | null;
      const closeBtn = win.querySelector('.win-btn.close') as HTMLElement | null;

      minimizeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.style.display = 'none';
        const tbItem = taskbarItems.get(win.id);
        if (tbItem) tbItem.classList.remove('active');
      });

      maximizeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.classList.toggle('maximized');
        bringToFront(win);
      });

      closeBtn?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        win.classList.remove('open');
        win.style.display = 'none';
        win.classList.remove('maximized');
        const tbItem = taskbarItems.get(win.id);
        if (tbItem) {
          tbItem.remove();
          taskbarItems.delete(win.id);
        }
      });

      // Draggable logic
      const header = win.querySelector('.window-header') as HTMLElement | null;
      let isDragging = false;
      let startX = 0, startY = 0, initialX = 0, initialY = 0;

      const onWinMouseMove = (e: MouseEvent) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        win.style.left = `${initialX + dx}px`;
        win.style.top = `${initialY + dy}px`;
      };

      const onWinMouseUp = () => {
        if (isDragging) {
          isDragging = false;
          document.body.classList.remove('window-is-dragging');
          window.removeEventListener('mousemove', onWinMouseMove);
          window.removeEventListener('mouseup', onWinMouseUp);
        }
      };

      header?.addEventListener('mousedown', (e: MouseEvent) => {
        if (win.classList.contains('maximized')) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialX = win.offsetLeft;
        initialY = win.offsetTop;
        bringToFront(win);
        document.body.classList.add('window-is-dragging');
        
        window.addEventListener('mousemove', onWinMouseMove);
        window.addEventListener('mouseup', onWinMouseUp);
      });
    });

    // Context Menu Logic
    const contextMenu = document.getElementById('os-context-menu');
    const contextMenuList = document.getElementById('context-menu-list');

    const hideContextMenu = () => {
      if (contextMenu) contextMenu.style.display = 'none';
    };

    document.addEventListener('click', hideContextMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideContextMenu();
    });

    desktopArea?.addEventListener('contextmenu', (e: MouseEvent) => {
      e.preventDefault();
      if (!contextMenu || !contextMenuList) return;

      const target = e.target as HTMLElement;
      const icon = target.closest('.desktop-icon');
      const windowHeader = target.closest('.window-header');
      
      contextMenuList.innerHTML = '';

      if (icon) {
        const title = icon.querySelector('.icon-label')?.textContent || 'App';
        contextMenuList.innerHTML = `
          <li id="cm-open">Ouvrir</li>
          <div class="separator"></div>
          <li style="opacity: 0.5; cursor: default;">Propriétés de ${title}</li>
        `;
        document.getElementById('cm-open')?.addEventListener('click', () => {
          const targetId = icon.getAttribute('data-target');
          if (targetId) {
            toggleWindow(targetId);
          } else if (icon.id === 'btn-exit-os') {
            const exitBtn = document.getElementById('btn-exit-os');
            if (exitBtn) exitBtn.dispatchEvent(new MouseEvent('dblclick'));
          }
        });
      } else if (windowHeader) {
        const win = windowHeader.closest('.os-window') as HTMLElement;
        contextMenuList.innerHTML = `
          <li id="cm-close">Fermer la fenêtre</li>
          <li id="cm-minimize">Réduire</li>
        `;
        document.getElementById('cm-close')?.addEventListener('click', () => {
          win.querySelector('.win-btn.close')?.dispatchEvent(new MouseEvent('click'));
        });
        document.getElementById('cm-minimize')?.addEventListener('click', () => {
          win.querySelector('.win-btn.minimize')?.dispatchEvent(new MouseEvent('click'));
        });
      } else {
        // Empty desktop
        contextMenuList.innerHTML = `
          <li id="cm-refresh">Actualiser</li>
          <div class="separator"></div>
          <li id="cm-wallpaper">Fonds d'écran</li>
          <div class="separator"></div>
          <li id="cm-quit">Quitter OS</li>
        `;
        document.getElementById('cm-refresh')?.addEventListener('click', () => {
          desktopArea.style.opacity = '0';
          setTimeout(() => { desktopArea.style.opacity = '1'; }, 200);
        });
        document.getElementById('cm-wallpaper')?.addEventListener('click', () => {
          toggleWindow('win-wallpaper');
        });
        document.getElementById('cm-quit')?.addEventListener('click', () => {
          const exitBtn = document.getElementById('btn-exit-os');
          if (exitBtn) exitBtn.dispatchEvent(new MouseEvent('dblclick'));
        });
      }

      contextMenu.style.display = 'block';
      
      // Position calculation to prevent overflow
      let x = e.clientX;
      let y = e.clientY;
      const menuWidth = contextMenu.offsetWidth || 180;
      const menuHeight = contextMenu.offsetHeight || 150;

      if (x + menuWidth > window.innerWidth) x = window.innerWidth - menuWidth;
      if (y + menuHeight > window.innerHeight) y = window.innerHeight - menuHeight;

      contextMenu.style.left = `${x}px`;
      contextMenu.style.top = `${y}px`;
    });
  });
</script>

