      <canvas class="hero-dust" aria-hidden="true"></canvas>
      <div class="hero-veil" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="eyebrow">Boulangerie · Pâtisserie · Val-des-Blés</p>
