  .days :global(.day:disabled) { opacity: 0.3; cursor: not-allowed; }
  .times { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 0.5rem; }
  .times :global(.time) { padding: 0.75rem 0; background: var(--black); border: 1.5px solid var(--graphite); font-weight: 700; font-variant-numeric: tabular-nums; transition: all 0.2s; }
  .times :global(.time:hover:not(:disabled)) { border-color: var(--brass); color: var(--brass); }
