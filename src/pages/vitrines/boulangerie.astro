            <tr data-day="4"><th scope="row">Jeudi</th><td>6 h 30 – 19 h 30</td></tr>
            <tr data-day="5"><th scope="row">Vendredi</th><td>6 h 30 – 19 h 30</td></tr>
            <tr data-day="6"><th scope="row">Samedi</th><td>6 h 30 – 19 h 30</td></tr>
