          <circle cx="28" cy="28" r="24" class="ring-fg" data-ring/>
        </svg>
        <div class="batch-body">
          <p class="batch-label" data-batch-label>Prochaine fournée</p>
          <p class="batch-name" data-batch-name>Baguette tradition</p>
          <p class="batch-eta" data-batch-eta>&nbsp;</p>
        </div>
        <span class="demo-note">Démo · calculé selon l’heure</span>
      </aside>
    </section>

    <!-- ───────── Bandeau ───────── -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <span>Tradition <i>·</i> Levain naturel <i>·</i> Croissant pur beurre <i>·</i> Flan vanille <i>·</i> Brioche feuilletée <i>·</i> Seigle du Vexin <i>·</i>&nbsp;</span>
        ))}
      </div>
    </div>

    <!-- ───────── Du pâton au four (défilement) ───────── -->
    <section class="bake" id="fournee" aria-labelledby="bake-title">
      <div class="bake-track" data-bake>
        <div class="bake-sticky">
          <div class="bake-text">
            <p class="eyebrow eyebrow-light">La fournée</p>
            <h2 id="bake-title" class="bake-title">Du pâton <em>au four</em></h2>
            <ol class="steps">
              {steps.map((s, i) => (
