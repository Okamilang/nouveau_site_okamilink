---
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-glow"></div>
</div>

<script>
  // Script exécuté uniquement côté client
  document.addEventListener('astro:page-load', () => {
    const cursor = document.getElementById('custom-cursor');
    const dot = cursor?.querySelector('.cursor-dot');
    const glow = cursor?.querySelector('.cursor-glow');
    
    // Si l'utilisateur n'a pas de souris (ex: mobile pur), on ignore
    const hasMouse = window.matchMedia('(pointer: fine)').matches;
    
    if (!cursor || !dot || !glow || !hasMouse) {
      if (cursor) cursor.style.display = 'none';
      return;
    }

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let dotX = mouseX;
    let dotY = mouseY;
    let glowX = mouseX;
    let glowY = mouseY;

    // Mise à jour de la position cible au mouvement
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      // Activer le curseur lors du premier mouvement
      if (cursor.style.opacity !== '1') {
        cursor.style.opacity = '1';
      }

      // Suivi instantané sans latence
      dot.setAttribute('style', `transform: translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`);
      glow.setAttribute('style', `transform: translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`);
    });
  });
</script>

<style>
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 10000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    background-color: var(--accent-pink);
    border-radius: 50%;
    transform-origin: center;
    transition: transform 0.2s ease, width 0.2s ease, height 0.2s ease;
    box-shadow: 0 0 10px var(--accent-pink);
  }

  .cursor-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 50px;
    height: 50px;
    border: 1px solid color-mix(in oklch, var(--accent-purple) 50%, transparent);
    background-color: color-mix(in oklch, var(--accent-purple) 10%, transparent);
    border-radius: 50%;
    transform-origin: center;
  }
</style>
