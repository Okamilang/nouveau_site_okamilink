---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import ExperienceSelector from '../components/common/ExperienceSelector.astro';
import OSDesktop from '../components/os/OSDesktop.astro';
import TerminalToast from '../components/common/TerminalToast.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;          // Image de partage (Open Graph), chemin absolu ou relatif
  ogType?: string;         // "website" | "article" ...
  noindex?: boolean;       // Empêcher l'indexation d'une page si besoin
  jsonLd?: object | object[]; // Données structurées supplémentaires (par page)
}

const {
  title,
  description = "Okamilink — Création de sites web sur-mesure et développement d'applications par Daniel Cohen, développeur web freelance en Val-d'Oise (95).",
  image = "/logo.png",
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

// URL canonique de la page courante (basée sur `site` dans astro.config.mjs)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site).href;

// Données structurées globales : Organisation + Entreprise locale
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
  "name": "Okamilink",
  "alternateName": "Okamilink - Daniel Cohen",
  "url": "https://okamilink.com",
  "logo": "https://okamilink.com/logo.png",
  "image": "https://okamilink.com/logo.png",
  "description": "Création de sites web sur-mesure, développement d'applications et d'outils par Daniel Cohen, développeur web freelance en Val-d'Oise.",
  "founder": {
    "@type": "Person",
    "name": "Daniel Cohen"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "14 rue des Pinsons",
    "addressLocality": "Éragny",
    "postalCode": "95610",
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Val-d'Oise" },
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ],
  "knowsAbout": [
    "Développement web",
    "Création de site internet sur-mesure",
    "Développement d'applications",
    "Astro",
    "WordPress",
    "Odoo e-commerce"
  ],
  "vatID": "FR72879152924",
  "email": "contact@okamilink.com"
};

// Concatène le schema global + les schemas éventuels de la page
const schemas = [organizationSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primaire -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="author" content="Daniel Cohen — Okamilink" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp…) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Okamilink" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Données structurées JSON-LD -->
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!-- View Transitions API support in Astro -->
    <ViewTransitions />

    <!-- Script Anti-FOUC pour le Dual-Mode -->
    <script is:inline>
      (function() {
        try {
          const experience = localStorage.getItem('okamilink_experience');
          if (experience === 'console') {
            document.documentElement.setAttribute('data-experience', 'console');
          } else {
            document.documentElement.setAttribute('data-experience', 'vitrine');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ExperienceSelector />
    <NoiseOverlay />
    <div class="only-vitrine">
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    
    <TerminalToast />
    <OSDesktop />
    <CustomCursor />

    <!-- Lightbox Globale -->
    <div id="global-lightbox" class="lightbox-overlay" aria-hidden="true">
      <img id="global-lightbox-img" src="" alt="Zoomed view" />
      <button id="global-lightbox-close" class="lightbox-close" aria-label="Fermer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    
    <!-- Scripts Globaux -->
    <script>
      document.addEventListener('astro:page-load', () => {
        // Contact Links Interceptor
        const contactLinks = document.querySelectorAll('a[href="/contact"]');
        contactLinks.forEach(link => {
          link.addEventListener('click', (e) => {
            const currentExp = document.documentElement.getAttribute('data-experience');
            if (currentExp === 'console') {
              e.preventDefault();
              if ((window as any).openOSWindow) {
                (window as any).openOSWindow('win-terminal');
              }
            }
          });
        });

        // Lightbox Logic
        const images = document.querySelectorAll('.project-markdown img, .project-content img');
        const lightbox = document.getElementById('global-lightbox');
        const lightboxImg = document.getElementById('global-lightbox-img') as HTMLImageElement;
        const lightboxClose = document.getElementById('global-lightbox-close');

        if (lightbox && lightboxImg) {
          images.forEach(img => {
            (img as HTMLElement).style.cursor = 'zoom-in';
            img.addEventListener('click', (e) => {
              lightboxImg.src = (e.target as HTMLImageElement).src;
              lightbox.classList.add('active');
            });
          });

          const closeLightbox = () => {
            lightbox.classList.remove('active');
            setTimeout(() => {
              lightboxImg.src = '';
            }, 300);
          };

          lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox || e.target === lightboxClose || (e.target as HTMLElement).closest('.lightbox-close')) {
              closeLightbox();
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && lightbox.classList.contains('active')) {
              closeLightbox();
            }
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  main {
    padding-top: 104px; /* Compense la navbar fixe */
    min-height: calc(100vh - 104px);
  }

  /* Global Lightbox Styles */
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .lightbox-overlay.active img {
    transform: scale(1);
  }
  .lightbox-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }
</style>
