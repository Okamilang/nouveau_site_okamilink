---
interface Props {
  id: string;
  title: string;
  icon?: string;
  width?: string;
  height?: string;
  x?: string;
  y?: string;
  isOpen?: boolean;
}

const { 
  id, 
  title, 
  icon = "📄", 
  width = "600px", 
  height = "400px",
  x = "10%",
  y = "10%",
  isOpen = false
} = Astro.props;
---

<div 
  id={id} 
  class={`os-window ${isOpen ? 'open' : ''}`} 
  style={`width: ${width}; height: ${height}; top: ${y}; left: ${x};`}
  data-window-id={id}
>
  <div class="window-header">
    <div class="window-title">
      <span class="window-icon" set:html={icon}></span>
      {title}
    </div>
    <div class="window-controls">
      <button class="win-btn minimize" aria-label="Minimize" data-action="minimize">_</button>
      <button class="win-btn maximize" aria-label="Maximize" data-action="maximize">□</button>
      <button class="win-btn close" aria-label="Close" data-action="close">×</button>
    </div>
  </div>
  <div class="window-content">
    <slot />
  </div>
</div>

<style>
  .os-window {
    position: absolute;
    background: rgba(5, 8, 12, 0.95);
    border: 1px solid var(--cyber-cyan);
    border-radius: 0;
    display: none;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.15), inset 0 0 20px rgba(0, 243, 255, 0.05);
    resize: both; /* Permet le redimensionnement manuel natif */
    min-width: 300px;
    min-height: 200px;
    
    /* Optimisations matérielles cruciales pour le lag des fenêtres multiples */
    will-change: transform, top, left;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .os-window.open {
    display: flex;
  }

  .os-window.maximized {
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0;
  }

  .window-header {
    height: 35px;
    background: repeating-linear-gradient(45deg, rgba(0,243,255,0.05) 0px, rgba(0,243,255,0.05) 2px, transparent 2px, transparent 6px), rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 15px;
    border-bottom: 1px solid var(--cyber-cyan);
    user-select: none;
    cursor: grab;
  }

  .window-header:active {
    cursor: grabbing;
  }

  .window-title {
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--cyber-cyan);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .window-title::before {
    content: '>_';
    opacity: 0.7;
    color: var(--cyber-magenta);
  }

  .window-icon {
    display: inline-flex;
    align-items: center;
    filter: drop-shadow(0 0 3px rgba(0, 243, 255, 0.6));
  }

  .window-controls {
    display: flex;
    gap: 5px;
  }

  .win-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--cyber-cyan);
    width: 28px;
    height: 28px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    font-size: 1rem;
    font-family: var(--font-mono);
    transition: all 0.2s;
  }

  .win-btn:hover {
    background: rgba(0, 243, 255, 0.15);
    border: 1px solid var(--cyber-cyan);
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.4);
  }

  .win-btn.close:hover {
    background: rgba(255, 0, 234, 0.15);
    border: 1px solid var(--cyber-magenta);
    box-shadow: 0 0 10px rgba(255, 0, 234, 0.4);
    color: var(--cyber-magenta);
  }

  .window-content {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
    position: relative;
    scrollbar-width: thin;
    scrollbar-color: var(--data-action) transparent;
  }
</style>
