---
interface Props {
  target?: string;
  url?: string;
}
const { target, url } = Astro.props;
---

<div class="only-vitrine">
  <div class="mobile-mockup-wrapper">
    <div class="mobile-mockup">
      <div class="notch"></div>
      <div class="mobile-content">
        {url ? (
          <iframe src={url} title="Mobile Preview" loading="lazy"></iframe>
        ) : (
          <slot />
        )}
      </div>
    </div>
  </div>
</div>

<div class="only-console" style="display: flex; justify-content: center; margin: 2rem 0;">
  {target && (
    <button 
      class="win-btn os-mobile-launcher" 
      data-target={target} 
      style="padding: 15px 30px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; color: white; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.2s; font-family: var(--font-sans);"
      onmouseover="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='translateY(-2px)';"
      onmouseout="this.style.background='rgba(255,255,255,0.05)'; this.style.transform='translateY(0)';"
    >
      <span style="font-size: 1.5rem;">📱</span>
      <span>Simuler sur Smartphone Virtuel</span>
    </button>
  )}
</div>

<style>
  .mobile-mockup-wrapper {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .mobile-mockup {
    width: 430px;
    max-width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 40px;
    background: var(--bg-surface);
    border: 12px solid color-mix(in oklch, var(--text-main) 10%, transparent);
    box-shadow: 
      0 30px 60px -12px color-mix(in oklch, var(--accent-blue) 15%, transparent),
      inset 0 0 0 2px color-mix(in oklch, var(--bg-color) 40%, transparent);
    position: relative;
    overflow: hidden;
  }

  .notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 150px;
    height: 30px;
    background: color-mix(in oklch, var(--text-main) 10%, transparent);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    z-index: 10;
  }

  .mobile-content {
    width: 100%;
    height: 100%;
    background: var(--bg-color);
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }
  
  .mobile-content::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  .mobile-content :global(img),
  .mobile-content :global(iframe) {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }
</style>
