---
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-ring">
    <span class="ring-tick tick-t"></span>
    <span class="ring-tick tick-r"></span>
    <span class="ring-tick tick-b"></span>
    <span class="ring-tick tick-l"></span>
  </div>
  <div class="cursor-caret"></div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const cursor = document.getElementById('custom-cursor');
    const dot = cursor?.querySelector('.cursor-dot') as HTMLElement;
    const ring = cursor?.querySelector('.cursor-ring') as HTMLElement;
    const caret = cursor?.querySelector('.cursor-caret') as HTMLElement;

    const hasMouse = window.matchMedia('(pointer: fine)').matches;

    if (!cursor || !dot || !ring || !caret || !hasMouse) {
      if (cursor) cursor.style.display = 'none';
      return;
    }

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ringX = mouseX;
    let ringY = mouseY;

    let isHovering = false;
    let magneticTarget: HTMLElement | null = null;
    let targetRect: DOMRect | null = null;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (cursor.style.opacity !== '1') cursor.style.opacity = '1';

      if (isHovering && magneticTarget && targetRect) {
        const centerX = targetRect.left + targetRect.width / 2;
        const centerY = targetRect.top + targetRect.height / 2;
        magneticTarget.style.transform = `translate(${(mouseX - centerX) * 0.2}px, ${(mouseY - centerY) * 0.2}px)`;
      }
    }, { passive: true });

    // Le curseur disparaît quand la souris quitte la fenêtre
    document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; });
    document.addEventListener('mouseenter', () => { cursor.style.opacity = '1'; });

    // État "pressé"
    window.addEventListener('mousedown', () => cursor.classList.add('pressed'));
    window.addEventListener('mouseup', () => cursor.classList.remove('pressed'));

    const lerp = (start: number, end: number, factor: number) => start + (end - start) * factor;

    const animate = () => {
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
      caret.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;

      ringX = lerp(ringX, mouseX, 0.22);
      ringY = lerp(ringY, mouseY, 0.22);
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(animate);
    };

    animate();

    // Survol des éléments cliquables (magnétisme) et des champs texte (caret)
    const clickableSelector = 'a, button, .magnetic, [role="button"], .desktop-icon, .wallpaper-btn, .win-btn, .taskbar-item, label';
    const textSelector = 'input:not([type="submit"]):not([type="button"]), textarea, select, [contenteditable="true"]';

    document.addEventListener('mouseover', (e) => {
      const el = e.target as HTMLElement;

      const textEl = el.closest(textSelector);
      cursor.classList.toggle('text', !!textEl);
      if (textEl) return;

      const clickable = el.closest(clickableSelector) as HTMLElement | null;
      if (clickable && clickable !== magneticTarget) {
        isHovering = true;
        magneticTarget = clickable;
        targetRect = clickable.getBoundingClientRect();
        cursor.classList.add('hovering');
        // Le magnétisme n'est appliqué qu'aux petits éléments (boutons, liens) pour ne pas déplacer les blocs
        const canMagnet = clickable.classList.contains('magnetic') || (targetRect.width < 320 && targetRect.height < 120);
        if (canMagnet) clickable.style.transition = 'transform 0.1s linear';
        else { magneticTarget = null; targetRect = null; }
      }
    });

    document.addEventListener('mouseout', (e) => {
      const el = e.target as HTMLElement;
      const related = e.relatedTarget as HTMLElement | null;
      const clickable = el.closest(clickableSelector) as HTMLElement | null;
      if (clickable && (!related || !clickable.contains(related))) {
        isHovering = false;
        cursor.classList.remove('hovering');
        if (magneticTarget) {
          magneticTarget.style.transition = 'transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)';
          magneticTarget.style.transform = 'translate(0px, 0px)';
        }
        magneticTarget = null;
        targetRect = null;
      }
    });
  });
</script>

<style>
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999999;
    opacity: 0;
    transition: opacity 0.3s ease;
    --cursor-main: var(--text-main);
    --cursor-accent: var(--accent-pink);
    --cursor-outline: var(--bg-color);
  }

  /* Point central : clair, cerclé de sombre pour rester visible sur tout fond */
  .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    background: var(--cursor-main);
    border-radius: 50%;
    box-shadow:
      0 0 0 1.5px var(--cursor-outline),
      0 0 10px color-mix(in oklch, var(--cursor-accent) 70%, transparent);
    transition: width 0.25s ease, height 0.25s ease, background 0.25s ease, opacity 0.2s ease;
    will-change: transform;
  }

  /* Anneau : contour double (clair + ombre) pour la lisibilité */
  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    border: 1.5px solid color-mix(in oklch, var(--cursor-main) 70%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--cursor-outline) 60%, transparent), inset 0 0 0 1px color-mix(in oklch, var(--cursor-outline) 40%, transparent);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), height 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background-color 0.3s ease, border-radius 0.3s ease, opacity 0.2s ease;
    will-change: transform;
  }

  /* Graduations (visibles seulement en mode console) */
  .ring-tick {
    position: absolute;
    background: var(--cursor-accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tick-t, .tick-b { width: 1px; height: 6px; left: 50%; transform: translateX(-50%); }
  .tick-l, .tick-r { height: 1px; width: 6px; top: 50%; transform: translateY(-50%); }
  .tick-t { top: -9px; }
  .tick-b { bottom: -9px; }
  .tick-l { left: -9px; }
  .tick-r { right: -9px; }

  /* Caret pour les champs texte */
  .cursor-caret {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 20px;
    background: var(--cursor-main);
    box-shadow: 0 0 0 1px var(--cursor-outline), 0 0 8px color-mix(in oklch, var(--cursor-accent) 60%, transparent);
    border-radius: 1px;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform;
  }

  /* ───── Survol d'un élément cliquable ───── */
  .custom-cursor.hovering .cursor-dot {
    width: 5px;
    height: 5px;
    background: var(--cursor-accent);
  }

  .custom-cursor.hovering .cursor-ring {
    width: 52px;
    height: 52px;
    border-color: var(--cursor-accent);
    background-color: color-mix(in oklch, var(--cursor-accent) 14%, transparent);
  }

  /* ───── Clic ───── */
  .custom-cursor.pressed .cursor-ring {
    width: 26px;
    height: 26px;
    border-color: var(--cursor-main);
  }

  .custom-cursor.hovering.pressed .cursor-ring {
    width: 42px;
    height: 42px;
  }

  /* ───── Champ texte ───── */
  .custom-cursor.text .cursor-dot,
  .custom-cursor.text .cursor-ring { opacity: 0; }
  .custom-cursor.text .cursor-caret { opacity: 1; }

  /* ───── Mode console : réticule ───── */
  :global(html[data-experience="console"]) .custom-cursor {
    --cursor-main: #ffffff;
    --cursor-accent: var(--cyber-cyan);
    --cursor-outline: #000000;
  }

  :global(html[data-experience="console"]) .cursor-dot {
    width: 6px;
    height: 6px;
    border-radius: 0;
    transform-origin: center;
    background: var(--cyber-cyan);
    box-shadow: 0 0 0 1px #000, 0 0 8px var(--cyber-cyan);
  }

  :global(html[data-experience="console"]) .cursor-ring {
    width: 28px;
    height: 28px;
    border-radius: 0;
    border-color: color-mix(in oklch, var(--cyber-cyan) 75%, transparent);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.7), 0 0 10px rgba(0, 243, 255, 0.25);
  }

  :global(html[data-experience="console"]) .ring-tick { opacity: 1; }

  :global(html[data-experience="console"]) .custom-cursor.hovering .cursor-ring {
    width: 40px;
    height: 40px;
    border-color: var(--cyber-magenta);
    background-color: rgba(255, 0, 234, 0.08);
  }

  :global(html[data-experience="console"]) .custom-cursor.hovering .ring-tick { background: var(--cyber-magenta); }

  :global(html[data-experience="console"]) .custom-cursor.hovering .cursor-dot {
    background: var(--cyber-magenta);
    box-shadow: 0 0 0 1px #000, 0 0 8px var(--cyber-magenta);
  }

  :global(html[data-experience="console"]) .cursor-caret {
    background: var(--cyber-cyan);
    box-shadow: 0 0 0 1px #000, 0 0 8px var(--cyber-cyan);
  }
</style>
