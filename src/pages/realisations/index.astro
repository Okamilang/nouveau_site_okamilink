---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedWork from '../../components/sections/FeaturedWork.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// On ne garde que les sites web pour le portfolio vitrine (les programmes restent exclusifs à l'OS)
const websiteProjects = allProjects.filter(p => p.data.category === 'website');
const sortedProjects = websiteProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Réalisations & études de cas web | Okamilink"
  description="Études de cas de sites web sur-mesure réalisés par Okamilink : e-commerce B2B sur Odoo (Boni Diffusion), expérience WordPress immersive (Mysteria Ingenium) et plus."
>
  <div class="page-container">
    <header class="page-header">
      <div class="header-main">
        <p class="section-label reveal-up" style="--i: 0">Portfolio</p>
        <h1 class="title">
          <span class="reveal-text"><span class="delay-1">Mes</span></span>
          <span class="reveal-text"><span class="delay-2">réalisations.</span></span>
        </h1>
        <p class="subtitle reveal-up" style="--i: 3">Pour chaque projet : le besoin du client, les choix faits, et le site à parcourir comme si vous y étiez.</p>
      </div>
    </header>

    <FeaturedWork mode="cases" />
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 3rem 2rem 8rem;
  }

  @media (max-width: 480px) {
    .page-container { padding-left: 1.25rem; padding-right: 1.25rem; }
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 820px;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.9s var(--ease-out-expo) forwards;
    animation-delay: calc(0.05s + var(--i, 0) * 0.12s);
  }

  .title {
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25em;
  }

  .title .reveal-text { padding: 0.08em 0.05em; margin: -0.08em -0.05em; }

  .subtitle {
    font-size: var(--step-body);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 58ch;
    line-height: 1.7;
  }




  @media (max-width: 720px) {
    .page-header { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  }

</style>
