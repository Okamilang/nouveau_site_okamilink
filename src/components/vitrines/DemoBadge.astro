---
/**
 * Bandeau flottant commun aux sites démo : rappelle que l'entreprise est fictive
 * et transforme le « j'aimerais le même » en prise de contact.
 */
import { getVitrine } from '../../lib/vitrines';

interface Props {
  slug: 'boulangerie' | 'restaurant' | 'barbier';
}
const { slug } = Astro.props;
const v = getVitrine(slug);
---

<aside class="okb" id="okb" aria-label="À propos de cette démo">
  <div class="okb-panel">
    <a href="/vitrines" class="okb-back" aria-label="Retour aux vitrines Okamilink">
      <img src="/logo-mark.webp" alt="" width="40" height="22" />
      <span class="okb-text">
        <strong>Site démo</strong>
        <span>{v?.trade} fictive · conçue par Okamilink</span>
      </span>
    </a>
    <a href={`/contact?vitrine=${slug}`} class="okb-cta">
      Je veux le même
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    <button type="button" class="okb-close" id="okb-close" aria-label="Réduire le bandeau de démo" aria-expanded="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
    </button>
  </div>
  <button type="button" class="okb-mini" id="okb-open" aria-label="Afficher le bandeau de démo Okamilink">
    <img src="/logo-mark.webp" alt="" width="34" height="19" />
  </button>
</aside>

<script>
  const root = document.getElementById('okb');
  const close = document.getElementById('okb-close');
  const open = document.getElementById('okb-open');
  const set = (collapsed: boolean) => {
    root?.classList.toggle('is-collapsed', collapsed);
    close?.setAttribute('aria-expanded', String(!collapsed));
    try { sessionStorage.setItem('okb-collapsed', collapsed ? '1' : '0'); } catch {}
  };
  try { if (sessionStorage.getItem('okb-collapsed') === '1') set(true); } catch {}
  close?.addEventListener('click', () => { set(true); open?.focus(); });
  open?.addEventListener('click', () => { set(false); close?.focus(); });
</script>

<style>
  .okb {
    --okb-bg: oklch(0.16 0.022 262 / 0.86);
    position: fixed;
    left: 50%;
    bottom: max(14px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 9000;
    font-family: 'Hanken Grotesk Variable', 'Segoe UI', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    color: oklch(0.96 0.008 260);
    animation: okb-in 0.8s 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes okb-in {
    from { opacity: 0; transform: translate(-50%, 24px); }
  }

  .okb-panel {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: var(--okb-bg);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid oklch(1 0 0 / 0.14);
    box-shadow: 0 18px 50px -12px oklch(0 0 0 / 0.55);
  }

  .okb-back {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px 4px 8px;
    color: inherit;
    text-decoration: none;
    border-radius: 999px;
    transition: background 0.25s ease;
  }
  .okb-back:hover { background: oklch(1 0 0 / 0.07); }
  .okb-back img { width: 34px; height: auto; }

  .okb-text { display: flex; flex-direction: column; }
  .okb-text strong { font-weight: 650; letter-spacing: 0.01em; }
  .okb-text span { font-size: 12px; color: oklch(0.78 0.02 260); white-space: nowrap; }

  .okb-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: oklch(0.96 0.008 260);
    color: oklch(0.16 0.022 262);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .okb-cta:hover { transform: translateY(-1px); background: oklch(0.87 0.11 340); }
  .okb-cta svg { transition: transform 0.3s ease; }
  .okb-cta:hover svg { transform: translateX(3px); }

  .okb-close, .okb-mini {
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .okb-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    color: oklch(0.78 0.02 260);
  }
  .okb-close:hover { background: oklch(1 0 0 / 0.08); color: #fff; }

  .okb-mini {
    display: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--okb-bg);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid oklch(1 0 0 / 0.14);
    box-shadow: 0 12px 30px -10px oklch(0 0 0 / 0.6);
  }

  .okb.is-collapsed { left: 16px; transform: none; animation: none; }
  .okb.is-collapsed .okb-panel { display: none; }
  .okb.is-collapsed .okb-mini { display: grid; }

  .okb :focus-visible { outline: 2px solid oklch(0.87 0.11 340); outline-offset: 2px; }

  @media (max-width: 560px) {
    .okb { left: 12px; right: 12px; transform: none; animation-name: okb-in-m; }
    @keyframes okb-in-m { from { opacity: 0; transform: translateY(24px); } }
    .okb-panel { justify-content: space-between; }
    .okb-text span { display: none; }
    .okb-cta { padding: 10px 14px; }
    .okb.is-collapsed { right: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .okb { animation: none; }
  }
</style>
