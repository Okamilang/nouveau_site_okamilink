---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import ExperienceSelector from '../components/common/ExperienceSelector.astro';
import OSDesktop from '../components/os/OSDesktop.astro';
import TerminalToast from '../components/common/TerminalToast.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Okamilink - Agence de développement web premium." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- View Transitions API support in Astro -->
    <ViewTransitions />

    <!-- Script Anti-FOUC pour le Dual-Mode -->
    <script is:inline>
      (function() {
        try {
          const experience = localStorage.getItem('okamilink_experience');
          if (experience === 'console') {
            document.documentElement.setAttribute('data-experience', 'console');
          } else {
            document.documentElement.setAttribute('data-experience', 'vitrine');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ExperienceSelector />
    <NoiseOverlay />
    <div class="only-vitrine">
      <Navbar />
      <main style="padding-top: 100px;">
        <slot />
      </main>
      <Footer />
    </div>
    
    <TerminalToast />
    <OSDesktop />
    <CustomCursor />
    
    <!-- Contact Links Interceptor -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const contactLinks = document.querySelectorAll('a[href="/contact"]');
        contactLinks.forEach(link => {
          link.addEventListener('click', (e) => {
            const currentExp = document.documentElement.getAttribute('data-experience');
            if (currentExp === 'console') {
              e.preventDefault();
              // Ouvre la fenêtre de contact (Contact.sh) dans l'OS
              if ((window as any).openOSWindow) {
                (window as any).openOSWindow('win-terminal');
              }
            }
            // Si on est en vitrine, on ne fait pas de e.preventDefault(),
            // le navigateur ira naturellement vers la page /contact
          });
        });
      });
    </script>
  </body>
</html>

<style>
  main {
    padding-top: 80px; /* Compense la navbar fixe */
    min-height: calc(100vh - 80px);
  }
</style>
