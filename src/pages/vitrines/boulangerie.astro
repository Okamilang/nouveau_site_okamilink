---
/**
 * Démo « Mie & Lumière » — boulangerie-pâtisserie fictive.
 * Identité : lumière du matin, crème, farine, croûte caramélisée.
 * Spécificités : ouvert/fermé en direct, prochaine fournée, récit « du pâton au four »
 * au défilement, carte de saison automatique, click & collect.
 */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/dm-sans';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import { photo } from '../../lib/vitrines';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import displayItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';

const p = (n: string) => photo('boulangerie', n);

const products = [
  { id: 'tradition', name: 'Baguette tradition', detail: 'Levain naturel, farine T65 du Vexin', price: 1.3, img: p('produit-tradition') },
  { id: 'croissant', name: 'Croissant pur beurre', detail: 'Beurre AOP, tourage à la main', price: 1.4, img: p('croissant-cuit') },
  { id: 'levain', name: 'Pain au levain · 500 g', detail: '18 heures de pousse lente', price: 4.8, img: p('produit-levain') },
  { id: 'flan', name: 'Flan pâtissier · la part', detail: 'Vanille Bourbon, pâte brisée maison', price: 3.9, img: p('produit-flan') },
  { id: 'buche', name: 'Bûche de Noël · 6 parts', detail: 'Chocolat noir 70 %, précommande', price: 32, img: p('produit-buche'), seasonal: true },
];

const steps = [
  { time: 'La veille · 16 h', title: 'Le tourage', text: 'Le beurre est enfermé dans la pâte, puis plié trois fois au rouleau. Vingt-sept couches, sans machine.' },
  { time: '4 h 30', title: 'Le façonnage', text: 'Chaque croissant est roulé à la main. Aucun n’est tout à fait pareil : c’est comme ça qu’on les reconnaît.' },
  { time: '5 h 00', title: 'La pousse', text: 'Une heure au chaud. La pâte gonfle doucement et les couches commencent à se dessiner.' },
  { time: '5 h 45', title: 'Le four', text: 'Dix-sept minutes à 180 °C. Le beurre chante, le feuilletage se soulève et se dore.' },
  { time: '6 h 30', title: 'En vitrine', text: 'Encore tièdes quand on lève le rideau. Les premiers partent avant sept heures.' },
];
---

<DemoLayout
  title="Mie & Lumière — démo de site vitrine pour boulangerie | Okamilink"
  description="Démo d'un site vitrine de boulangerie-pâtisserie réalisé par Okamilink : horaires en direct, prochaine fournée, carte de saison et click & collect. Entreprise fictive."
  slug="boulangerie"
  themeColor="#f4ecdf"
  favicon={{ text: 'M', bg: '#b5523a', fg: '#fbf7f0' }}
  image={p('hero')}
>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
  <link slot="head" rel="preload" as="font" type="font/woff2" href={displayItalic} crossorigin />
  <div class="ml">
    <!-- ───────── Navigation ───────── -->
    <header class="nav" id="ml-nav">
      <a href="#top" class="logo" aria-label="Mie & Lumière — accueil">
        <span class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="34" height="34"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 25c3-9 15-9 18 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M15 19l1.5 3M20 17v3.5M25 19l-1.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <span class="logo-text">Mie <em>&amp;</em> Lumière</span>
      </a>
      <nav class="nav-links" aria-label="Navigation">
        <a href="#fournee">La fournée</a>
        <a href="#maison">La maison</a>
        <a href="#commander">Commander</a>
        <a href="#infos">Nous trouver</a>
      </nav>
      <div class="nav-right">
        <span class="status" data-status><span class="status-dot"></span><span data-status-text>Horaires</span></span>
        <a href="#commander" class="btn btn-ink btn-sm">Commander</a>
      </div>
    </header>

    <!-- ───────── Hero ───────── -->
    <section class="hero" id="top">
