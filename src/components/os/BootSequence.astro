---
// BootSequence.astro — séquence de démarrage façon BIOS
const year = new Date().getFullYear();
---

<div id="os-boot-sequence" class="boot-overlay" aria-hidden="true">
  <div class="boot-grid" aria-hidden="true"></div>
  <div class="boot-content">
    <header class="bios-info">
      <div class="bios-left">
        <span class="bios-mark">◈</span>
        <div>
          <p class="bios-title">OKAMILINK OS <span>BIOS v4.2.1</span></p>
          <p class="bios-sub">Copyright (C) {year}, Okamilink Corp. · Tous systèmes nominaux</p>
        </div>
      </div>
      <div class="bios-right">
        <span>MEM 65536K OK</span>
        <span>KERNEL 5.1-okami</span>
      </div>
    </header>

    <div id="boot-logs" class="boot-logs"></div>

    <footer class="boot-footer">
      <div class="boot-progress">
        <div id="boot-progress-bar" class="boot-progress-bar"></div>
      </div>
      <div class="boot-meta">
        <span id="boot-percent" class="boot-percent">000%</span>
        <span class="boot-hint">Appuyez sur aucune touche. Le système démarre.</span>
      </div>
    </footer>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const bootSequence = document.getElementById('os-boot-sequence');
    const bootLogs = document.getElementById('boot-logs');
    const progressBar = document.getElementById('boot-progress-bar');
    const percent = document.getElementById('boot-percent');

    if (document.documentElement.getAttribute('data-experience') !== 'console') {
      if (bootSequence) bootSequence.style.display = 'none';
      return;
    }

    if (sessionStorage.getItem('okamilink_os_booted') === 'true') {
      if (bootSequence) bootSequence.style.display = 'none';
      return;
    }

    const logs: Array<[string, 'ok' | 'info' | 'warn']> = [
      ["Initializing hardware...", 'info'],
      ["Loading Okamilink kernel modules", 'ok'],
      ["Mounting virtual file systems", 'ok'],
      ["Starting network interfaces", 'ok'],
      ["Establishing secure connection to creative neural net", 'ok'],
      ["Decrypting portfolio archives", 'ok'],
      ["Calibrating CRT shader (scanlines: on)", 'warn'],
      ["Loading graphical user interface", 'ok'],
      ["Welcome to Okamilink OS.", 'info'],
    ];

    let logIndex = 0;
    const total = logs.length;

    const setProgress = (ratio: number) => {
      const p = Math.round(ratio * 100);
      if (progressBar) progressBar.style.width = `${p}%`;
      if (percent) percent.textContent = `${String(p).padStart(3, '0')}%`;
    };

    const playBoot = () => {
      if (logIndex < total) {
        const [text, status] = logs[logIndex];
        const line = document.createElement('p');
        line.className = `boot-line boot-${status}`;
        const tag = status === 'ok' ? '[ OK ]' : status === 'warn' ? '[WARN]' : '[ .. ]';
        line.innerHTML = `<span class="boot-tag">${tag}</span><span class="boot-text">${text}</span>`;
        bootLogs?.appendChild(line);
        if (bootLogs) bootLogs.scrollTop = bootLogs.scrollHeight;

        logIndex++;
        setProgress(logIndex / total * 0.9);
        setTimeout(playBoot, Math.random() * 260 + 90);
      } else {
        setTimeout(() => {
          setProgress(1);
          setTimeout(() => {
            if (bootSequence) {
              bootSequence.style.opacity = '0';
              setTimeout(() => {
                bootSequence.style.display = 'none';
                sessionStorage.setItem('okamilink_os_booted', 'true');
              }, 500);
            }
          }, 600);
        }, 400);
      }
    };

    setTimeout(playBoot, 500);
  });
</script>

<style>
  .boot-overlay {
    position: fixed;
    inset: 0;
    background-color: #030405;
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--data-action);
    font-family: var(--font-mono);
    transition: opacity 0.5s ease;
    overflow: hidden;
  }

  .boot-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 243, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 243, 255, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
    pointer-events: none;
  }

  .boot-content {
    position: relative;
    width: 84%;
    max-width: 840px;
    height: 62vh;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bios-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0, 243, 255, 0.25);
  }

  .bios-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bios-mark {
    font-size: 1.8rem;
    color: var(--cyber-cyan);
    text-shadow: 0 0 12px var(--cyber-cyan);
    animation: bios-pulse 1.6s ease-in-out infinite;
  }

  @keyframes bios-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .bios-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--cyber-cyan);
    text-shadow: 0 0 10px rgba(0, 243, 255, 0.5);
  }

  .bios-title span {
    color: rgba(0, 243, 255, 0.55);
    font-weight: 400;
    letter-spacing: 0.08em;
    margin-left: 0.5rem;
  }

  .bios-sub {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.04em;
    margin-top: 0.2rem;
  }

  .bios-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(0, 243, 255, 0.55);
    white-space: nowrap;
  }

  .boot-logs {
    flex-grow: 1;
    overflow: hidden;
    font-size: 0.85rem;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .boot-logs :global(.boot-line) {
    display: flex;
    gap: 1rem;
    margin: 0;
    animation: boot-line-in 0.25s ease-out;
  }

  @keyframes boot-line-in {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: none; }
  }

  .boot-logs :global(.boot-tag) {
    flex-shrink: 0;
    width: 4.5rem;
    color: var(--data-action);
    text-shadow: 0 0 6px rgba(0, 255, 102, 0.5);
  }

  .boot-logs :global(.boot-warn .boot-tag) { color: oklch(0.85 0.18 85); text-shadow: 0 0 6px oklch(0.85 0.18 85 / 0.5); }
  .boot-logs :global(.boot-info .boot-tag) { color: rgba(0, 243, 255, 0.6); text-shadow: none; }

  .boot-logs :global(.boot-text) { color: rgba(255, 255, 255, 0.78); }
  .boot-logs :global(.boot-info .boot-text) { color: var(--cyber-cyan); }

  .boot-footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .boot-progress {
    width: 100%;
    height: 6px;
    background:
      repeating-linear-gradient(90deg, transparent 0 10px, rgba(3, 4, 5, 1) 10px 12px),
      rgba(255, 255, 255, 0.08);
    overflow: hidden;
    position: relative;
  }

  .boot-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--data-action), var(--cyber-cyan));
    box-shadow: 0 0 12px rgba(0, 255, 102, 0.6);
    transition: width 0.35s ease-out;
    mask-image: repeating-linear-gradient(90deg, black 0 10px, transparent 10px 12px);
    -webkit-mask-image: repeating-linear-gradient(90deg, black 0 10px, transparent 10px 12px);
  }

  .boot-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .boot-percent {
    color: var(--data-action);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .boot-hint {
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
  }
</style>
