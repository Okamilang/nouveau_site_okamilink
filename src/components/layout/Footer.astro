---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a href="/" class="brand-link">
        <img src="/logo-mark.webp" alt="" class="footer-logo" width="128" height="72" loading="lazy" />
        <span class="footer-name">Okamilink</span>
      </a>
      <p class="brand-desc">Sites, boutiques et applications sur-mesure pour les entreprises qui veulent sortir du lot.</p>
      <p class="brand-meta">Éragny · Val-d'Oise (95) · France</p>
    </div>

    <nav class="footer-links" aria-label="Navigation secondaire">
      <div class="link-group">
        <h2>Pages</h2>
        <a href="/realisations">Réalisations</a>
        <a href="/programmes">Programmes</a>
        <a href="/vitrines">Vitrines</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="link-group">
        <h2>Légal</h2>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Politique de confidentialité</a>
      </div>
      <div class="link-group">
        <h2>Écrire</h2>
        <a href="mailto:contact@okamilink.com" class="mono-link">contact@okamilink.com</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Okamilink · Tous droits réservés.</p>
    <p class="footer-sig">Accueil de ce site sur Lighthouse (mobile, nov. 2026) : performance 95 · accessibilité 100 · bonnes pratiques 100 · SEO 100.</p>
    <button type="button" class="footer-egg only-vitrine" data-open-console title="Ouvrir le mode console" aria-label="Ouvrir le mode console">&gt;_</button>
    <button id="footer-shell-btn" class="shell-btn only-console" onclick="document.documentElement.classList.add('shell-mode-active'); window.pushToast && window.pushToast('[SYS]: Entering full shell mode...', 'ok');">[ SWITCH_TO_SHELL_MODE ]</button>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    padding-top: 5rem;
    margin-top: 4rem;
    overflow: hidden;
  }

  /* Halo discret en haut à gauche */
  .footer::before {
    content: '';
    position: absolute;
    top: -300px;
    left: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, color-mix(in oklch, var(--accent-blue) 12%, transparent) 0%, transparent 65%);
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem 4rem;
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 4rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
    letter-spacing: 0.04em;
    color: var(--text-main);
  }

  .footer-logo {
    width: auto;
    height: 34px;
    object-fit: contain;
    filter: drop-shadow(0 0 8px color-mix(in oklch, var(--accent-purple) 30%, transparent));
  }

  .brand-desc {
    color: var(--text-muted);
    font-size: var(--step-body);
    font-weight: 300;
    line-height: 1.7;
    max-width: 34ch;
  }

  .brand-meta {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 3rem;
    justify-content: end;
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-group h2 {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .link-group a {
    color: var(--text-muted);
    font-size: var(--step-body);
    width: fit-content;
    position: relative;
    transition: color 0.25s ease;
  }

  .link-group a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .link-group a:hover { color: var(--text-main); }
  .link-group a:hover::after { transform: scaleX(1); transform-origin: left; }

  .mono-link {
    font-family: var(--font-mono);
    font-size: var(--step-label) !important;
    letter-spacing: 0.02em;
  }

  /* Wordmark géant en contour */


  .footer:hover .footer-wordmark span {
    -webkit-text-stroke-color: color-mix(in oklch, var(--accent-purple) 30%, transparent);
  }

  .footer-bottom {
    position: relative;
    border-top: 1px solid var(--line);
    padding: 1.75rem 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--text-dim);
    font-size: var(--step-label);
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .footer-sig {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: 0.06em;
  }

  .shell-btn {
    background: transparent;
    border: 1px solid var(--data-action);
    color: var(--data-action);
    font-family: var(--font-mono);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: var(--step-label);
    transition: all 0.3s;
  }

  .shell-btn:hover {
    background: color-mix(in oklch, var(--data-action) 15%, transparent);
    box-shadow: 0 0 10px color-mix(in oklch, var(--data-action) 50%, transparent);
  }

  @media (max-width: 860px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .footer-links {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      justify-content: start;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Clin d'œil : la porte de l'OS, aussi au pied du site */
  .footer-egg {
    background: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.3s ease, border-color 0.3s ease, text-shadow 0.3s ease;
  }
  .footer-egg:hover,
  .footer-egg:focus-visible {
    color: oklch(0.86 0.2 150);
    border-color: currentColor;
    text-shadow: 0 0 10px oklch(0.86 0.2 150 / 0.6);
  }

  @media (max-width: 480px) {
    .footer-container { padding-left: 1.25rem; padding-right: 1.25rem; }
    .footer-bottom { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
